# AITopIndex Backend Configuration
NODE_ENV=production
PORT=4390
AITOPINDEX_DB_PATH=./backend/db/aitopindex.sqlite

# Admin Authentication (REQUIRED in production)
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=replace_with_strong_password
SESSION_SECRET=replace_with_64_char_random_hex_secret

# Domain & CORS
ALLOWED_ORIGIN=https://www.aitopindex.com
ADMIN_PANEL_URL=https://www.aitopindex.com/admin

# Email Notifications (Resend API)
RESEND_API_KEY=
EMAIL_FROM=noreply@aitopindex.com
ADMIN_ALERT_EMAIL=

# Hermes Agent Integration (Contabo local CLI — recommended, zero open ports)
HERMES_CLI_PYTHON=/root/.hermes/hermes-agent/venv/bin/python
HERMES_CLI_SCRIPT=/root/.hermes/hermes-agent/hermes_cli/main.py
HERMES_CLI_TARGET=telegram:Исмаил

# Optional: Hermes Local HTTP Webhook (fallback if CLI is not used)
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
