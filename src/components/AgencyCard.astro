---
import { agencyPath, type Agency, type Lang } from '../lib/data';

interface Props {
  agency: Agency;
  lang: Lang;
}

const { agency, lang } = Astro.props;
const profileHref = agencyPath(lang, agency.id);

// Monogram letter & soft modern gradient
const initial = agency.name.charAt(0).toUpperCase();
const brandmarkStyles = [
  'bg-gradient-to-br from-[#66b8fb]/15 to-[#6336ed]/20 text-[#4f35e3] border-[#d8d5fb]',
  'bg-gradient-to-br from-[#8d67ff]/15 to-[#293280]/20 text-[#6336ed] border-[#e2ddfc]',
  'bg-gradient-to-br from-[#2dd4bf]/20 to-[#6366f1]/20 text-[#2563eb] border-[#cce5ff]',
  'bg-gradient-to-br from-[#f59e0b]/15 to-[#d97706]/20 text-[#b45309] border-[#fed7aa]',
  'bg-gradient-to-br from-[#10b981]/15 to-[#059669]/20 text-[#047857] border-[#a7f3d0]',
];
const gradIdx = agency.name.charCodeAt(0) % brandmarkStyles.length;
const selectedGrad = brandmarkStyles[gradIdx];

// Tags
const tags = agency.techStack.slice(0, 5);

// Clean website link
const cleanUrl = agency.website.startsWith('http') ? agency.website : `https://${agency.website}`;

const entityLabel = agency.entityType === 'platform'
  ? (lang === 'ru' ? 'Платформа' : 'AI Platform')
  : (lang === 'ru' ? 'Интегратор' : 'Integrator');
---

<article
  class="bg-white border border-[#e9ebf4] hover:border-[#8d67ff] rounded-2xl p-4 transition-all duration-200 shadow-[var(--shadow)] hover:shadow-md flex flex-col justify-between"
  data-agency-card
  data-id={agency.id}
  data-name={agency.name.toLowerCase()}
  data-categories={agency.categories.join(' ')}
  data-tags={agency.techStack.map((t) => t.toLowerCase().replace(/\s+/g, '')).join(' ')}
  data-verified={agency.status === 'verified' ? 'true' : 'false'}
>
  <div>
    <div class="flex items-start gap-3">
      <!-- Монограмма -->
      <div class={`w-12 h-12 rounded-xl ${selectedGrad} border flex items-center justify-center shrink-0 select-none font-bold text-lg`}>
        {initial}
      </div>

      <!-- Основной контент карточки -->
      <div class="flex-1 min-w-0">
        <!-- Название и тип -->
        <div class="flex items-center justify-between gap-1.5">
          <div class="flex items-center gap-1.5 min-w-0">
            <h2 class="text-[15px] font-bold text-[#17172c] tracking-tight truncate hover:text-[#6336ed] transition-colors">
              <a href={profileHref}>{agency.name}</a>
            </h2>
            {agency.status === 'verified' && (
              <span
                class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#e8f2ff] text-[#147dff] shrink-0"
                title={lang === 'ru' ? 'Домен подтверждён' : 'Verified domain'}
                role="img"
                aria-label={lang === 'ru' ? 'Домен подтверждён' : 'Verified domain'}
              >
                <svg class="w-2.5 h-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.77a1 1 0 1 1 1.42-1.41l3.04 3.06 6.54-6.59a1 1 0 0 1 1.414-.004Z" clip-rule="evenodd" />
                </svg>
              </span>
            )}
          </div>

          <span class="shrink-0 text-[10.5px] font-semibold px-2 py-0.5 rounded-full bg-[#f5f6fa] border border-[#e5e7f3] text-[#49506c]">
            {entityLabel}
          </span>
        </div>

        <!-- Локация и бюджет -->
        <div class="flex items-center gap-2 text-[12px] text-[#59617e] mt-1">
          <span class="truncate">{agency.hq[lang]}</span>
          <span>•</span>
          <span class="font-semibold text-[#17172c] shrink-0">{agency.minProjectBudget[lang]}</span>
        </div>

        <!-- Описание внедрения -->
        <p class="text-[14px] sm:text-[12.5px] text-[#59617e] leading-[1.45] mt-1.5 line-clamp-2">
          {agency.description[lang]}
        </p>

        <!-- Теги стека технологий -->
        <div class="flex flex-wrap items-center gap-1.5 mt-2.5">
          {tags.map((tag) => (
            <span class="tag">
              #{tag.replace(/\s+/g, '')}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Три кнопки действий (Contact | Profile | Site) -->
  <div class="grid grid-cols-3 gap-1.5 mt-3 pt-2.5 border-t border-[#f0f2fa]">
    <button
      type="button"
      onclick={`openContactModal('${agency.id}')`}
      class="h-[32px] rounded-lg bg-[#f8f9fe] hover:bg-[#f0edff] border border-[#e2e7f3] hover:border-[#ded6ff] flex items-center justify-center gap-1 text-[11px] font-semibold text-[#17172c] hover:text-[#6336ed] transition-colors cursor-pointer"
    >
      <svg class="w-3 h-3 text-[#59617e] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span>{lang === 'ru' ? 'Контакт' : 'Contact'}</span>
    </button>

    <a
      href={profileHref}
      class="h-[32px] rounded-lg bg-[#f8f9fe] hover:bg-[#f0edff] border border-[#e2e7f3] hover:border-[#ded6ff] flex items-center justify-center gap-1 text-[11px] font-semibold text-[#17172c] hover:text-[#6336ed] transition-colors"
    >
      <svg class="w-3 h-3 text-[#59617e] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="7" width="18" height="13" rx="2"></rect>
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      </svg>
      <span>{lang === 'ru' ? 'Профиль' : 'Profile'}</span>
    </a>

    <a
      href={cleanUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="h-[32px] rounded-lg bg-[#f0edff] hover:bg-[#6336ed] border border-[#ded6ff] flex items-center justify-center gap-1 text-[11px] font-bold text-[#6336ed] hover:text-white transition-colors"
    >
      <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <path d="M12 3a14.5 14.5 0 0 1 0 18 14.5 14.5 0 0 1 0-18z"></path>
      </svg>
      <span>{lang === 'ru' ? 'Сайт ↗' : 'Site ↗'}</span>
    </a>
  </div>
</article>
