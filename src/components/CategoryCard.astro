---
import type { Category, Lang } from '../lib/data';
import { agenciesFor, plural } from '../lib/data';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  category: Category;
  lang: Lang;
}

const { category, lang } = Astro.props;
const count = agenciesFor(category.id).length;
const href = `/${lang}/${category.slug[lang]}/`;

const agencyCountLabel = plural(
  lang,
  count,
  ['Agency', 'Agencies'],
  ['компания', 'компании', 'компаний']
);
---

<div class="tilt-wrap h-full">
  <a
    href={href}
    class="tilt glow-border glass group flex h-full flex-col justify-between p-6 sm:p-7 transition-all duration-300"
    data-tilt
  >
    <!-- Top Row: Icon + Verified Count -->
    <div class="flex items-start justify-between gap-4">
      <div class="z-pop rounded-xl border border-white/10 bg-white/[0.04] p-3 shadow-inner group-hover:border-cyan-glow/40 transition">
        <CategoryIcon category={category.id} class="h-8 w-8 transition-transform group-hover:scale-110" />
      </div>
      <div class="z-pop-sm flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 font-mono text-xs text-slate-300">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-glow animate-pulse"></span>
        <span class="font-semibold text-white">{count}</span>
        <span>{agencyCountLabel}</span>
      </div>
    </div>

    <!-- Category Title (never truncated with ..., clean wrapping) -->
    <div class="my-5 flex-1">
      <h3 class="z-pop text-lg font-bold tracking-tight text-white group-hover:text-cyan-glow transition sm:text-xl break-words">
        {category.title[lang]}
      </h3>
      <p class="z-pop-sm mt-2.5 text-xs sm:text-sm leading-relaxed text-slate-300">
        {category.short[lang]}
      </p>
    </div>

    <!-- Bottom Row: Focus highlights & Explore Link -->
    <div class="z-pop-sm pt-4 border-t border-white/5 flex items-center justify-between text-xs">
      <span class="font-mono text-slate-400 group-hover:text-slate-200 transition">
        {lang === 'ru' ? 'Рейтинг и фильтры' : 'Ranking & Stack'}
      </span>
      <span class="font-mono font-semibold text-cyan-glow flex items-center gap-1 group-hover:translate-x-1 transition-transform">
        <span>{lang === 'ru' ? 'Смотреть' : 'Explore'}</span>
        <span>&rarr;</span>
      </span>
    </div>
  </a>
</div>
