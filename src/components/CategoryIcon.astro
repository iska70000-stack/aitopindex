---
import type { CategoryId } from '../lib/data';

interface Props {
  category: CategoryId;
  class?: string;
}

const { category, class: className = 'w-8 h-8' } = Astro.props;
---

{category === 'sales' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="sales-grad-1" x1="6" y1="6" x2="42" y2="42" gradientUnits="userSpaceOnUse">
        <stop stop-color="#00F0FF" />
        <stop offset="1" stop-color="#7000FF" />
      </linearGradient>
      <filter id="sales-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <rect x="6" y="8" width="36" height="32" rx="8" stroke="url(#sales-grad-1)" stroke-width="2.5" fill="rgba(0, 240, 255, 0.05)" filter="url(#sales-glow)" />
    <path d="M14 28L22 20L28 26L36 16" stroke="#00F0FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="36" cy="16" r="3" fill="#10B981" />
    <circle cx="14" cy="28" r="2.5" fill="#00F0FF" />
    <circle cx="22" cy="20" r="2.5" fill="#00F0FF" />
    <circle cx="28" cy="26" r="2.5" fill="#00F0FF" />
    <path d="M30 16H36V22" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{category === 'video' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="video-grad-1" x1="4" y1="8" x2="44" y2="40" gradientUnits="userSpaceOnUse">
        <stop stop-color="#7000FF" />
        <stop offset="1" stop-color="#00F0FF" />
      </linearGradient>
      <filter id="video-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <rect x="6" y="10" width="36" height="28" rx="8" stroke="url(#video-grad-1)" stroke-width="2.5" fill="rgba(112, 0, 255, 0.08)" filter="url(#video-glow)" />
    <path d="M20 18L32 24L20 30V18Z" fill="#00F0FF" />
    <circle cx="11" cy="15" r="1.5" fill="#A78BFA" />
    <circle cx="16" cy="15" r="1.5" fill="#A78BFA" />
    <circle cx="11" cy="33" r="1.5" fill="#A78BFA" />
    <circle cx="16" cy="33" r="1.5" fill="#A78BFA" />
    <path d="M34 6L38 10M14 6L10 10" stroke="#7000FF" stroke-width="2" stroke-linecap="round" />
  </svg>
)}

{category === 'voice' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="voice-grad-1" x1="12" y1="6" x2="36" y2="42" gradientUnits="userSpaceOnUse">
        <stop stop-color="#10B981" />
        <stop offset="1" stop-color="#00F0FF" />
      </linearGradient>
      <filter id="voice-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <rect x="18" y="8" width="12" height="20" rx="6" stroke="url(#voice-grad-1)" stroke-width="2.5" fill="rgba(16, 185, 129, 0.1)" filter="url(#voice-glow)" />
    <path d="M12 22C12 28.6274 17.3726 34 24 34C30.6274 34 36 28.6274 36 22" stroke="#00F0FF" stroke-width="2.5" stroke-linecap="round" />
    <line x1="24" y1="34" x2="24" y2="42" stroke="#10B981" stroke-width="3" stroke-linecap="round" />
    <line x1="16" y1="42" x2="32" y2="42" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" />
    <path d="M6 22C6 16 8 12 10 10M42 22C42 16 40 12 38 10" stroke="rgba(0, 240, 255, 0.4)" stroke-width="2" stroke-linecap="round" />
  </svg>
)}

{category === 'realestate' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="re-grad" x1="6" y1="8" x2="42" y2="44" gradientUnits="userSpaceOnUse">
        <stop stop-color="#00F0FF" />
        <stop offset="1" stop-color="#10B981" />
      </linearGradient>
      <filter id="re-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <path d="M8 22L24 8L40 22V40C40 41.1046 39.1046 42 38 42H10C8.89543 42 8 41.1046 8 40V22Z" stroke="url(#re-grad)" stroke-width="2.5" fill="rgba(0, 240, 255, 0.06)" filter="url(#re-glow)" />
    <rect x="20" y="28" width="8" height="14" rx="2" stroke="#00F0FF" stroke-width="2" />
    <circle cx="24" cy="18" r="4" fill="#10B981" />
  </svg>
)}

{category === 'healthcare' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="med-grad" x1="8" y1="8" x2="40" y2="40" gradientUnits="userSpaceOnUse">
        <stop stop-color="#10B981" />
        <stop offset="1" stop-color="#7000FF" />
      </linearGradient>
      <filter id="med-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <circle cx="24" cy="24" r="18" stroke="url(#med-grad)" stroke-width="2.5" fill="rgba(16, 185, 129, 0.06)" filter="url(#med-glow)" />
    <path d="M24 14V34M14 24H34" stroke="#10B981" stroke-width="4" stroke-linecap="round" />
    <circle cx="24" cy="24" r="2.5" fill="#00F0FF" />
  </svg>
)}

{category === 'workflow' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="flow-grad" x1="6" y1="6" x2="42" y2="42" gradientUnits="userSpaceOnUse">
        <stop stop-color="#7000FF" />
        <stop offset="1" stop-color="#00F0FF" />
      </linearGradient>
      <filter id="flow-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <circle cx="12" cy="14" r="5" stroke="url(#flow-grad)" stroke-width="2.5" fill="rgba(112, 0, 255, 0.2)" filter="url(#flow-glow)" />
    <circle cx="36" cy="14" r="5" stroke="url(#flow-grad)" stroke-width="2.5" fill="rgba(0, 240, 255, 0.2)" />
    <circle cx="24" cy="34" r="6" stroke="#00F0FF" stroke-width="2.5" fill="rgba(16, 185, 129, 0.2)" />
    <path d="M16 17L21 29M32 17L27 29M17 14H31" stroke="rgba(255, 255, 255, 0.6)" stroke-width="2" stroke-dasharray="3 3" />
    <circle cx="24" cy="34" r="2" fill="#00F0FF" />
  </svg>
)}

{category === 'ecommerce' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="ecom-grad" x1="8" y1="10" x2="40" y2="42" gradientUnits="userSpaceOnUse">
        <stop stop-color="#00F0FF" />
        <stop offset="1" stop-color="#A78BFA" />
      </linearGradient>
      <filter id="ecom-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <path d="M10 12H14L18 32H38L42 16H15" stroke="url(#ecom-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#ecom-glow)" />
    <circle cx="20" cy="38" r="3" fill="#00F0FF" />
    <circle cx="36" cy="38" r="3" fill="#10B981" />
    <path d="M26 20L28 24L34 21" stroke="#00F0FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{category === 'enterprise' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="ent-grad" x1="8" y1="8" x2="40" y2="40" gradientUnits="userSpaceOnUse">
        <stop stop-color="#7000FF" />
        <stop offset="1" stop-color="#10B981" />
      </linearGradient>
      <filter id="ent-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <rect x="8" y="10" width="32" height="28" rx="4" stroke="url(#ent-grad)" stroke-width="2.5" fill="rgba(112, 0, 255, 0.08)" filter="url(#ent-glow)" />
    <path d="M16 18H32M16 24H28M16 30H24" stroke="#00F0FF" stroke-width="2" stroke-linecap="round" />
    <circle cx="34" cy="28" r="4" stroke="#10B981" stroke-width="2" fill="#05070B" />
    <path d="M33 28L34 29L36 27" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{category === 'geo' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="geo-grad" x1="6" y1="6" x2="42" y2="42" gradientUnits="userSpaceOnUse">
        <stop stop-color="#00F0FF" />
        <stop offset="0.5" stop-color="#7000FF" />
        <stop offset="1" stop-color="#10B981" />
      </linearGradient>
      <filter id="geo-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>
    <circle cx="24" cy="24" r="17" stroke="url(#geo-grad)" stroke-width="2.5" fill="rgba(0, 240, 255, 0.04)" filter="url(#geo-glow)" />
    <ellipse cx="24" cy="24" rx="8" ry="17" stroke="rgba(0, 240, 255, 0.6)" stroke-width="1.8" />
    <line x1="7" y1="24" x2="41" y2="24" stroke="rgba(16, 185, 129, 0.6)" stroke-width="1.8" />
    <circle cx="24" cy="24" r="3.5" fill="#00F0FF" />
    <path d="M32 14L37 9M37 9H33M37 9V13" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
