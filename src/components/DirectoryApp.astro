<!-- ============================================================ -->
<!-- CLIENT INTERACTIVITY SCRIPT                                  -->
<!-- ============================================================ -->
<script is:inline define:vars={{ agenciesClientData, lang }}>
  window.__APP_AGENCIES = agenciesClientData;
  window.__APP_LANG = lang;
  window.__SHOW_ALL = false;
  window.__REGION_TAB = 'all';

  const escapeHTML = (str) =>
    String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  window.showAllAgencies = function() {
    window.__SHOW_ALL = true;
    window.applyAppFilters();
  };

  window.filterByRegionTab = function(regionKey, btn) {
    window.__REGION_TAB = regionKey;
    document.querySelectorAll('.tabs button').forEach((b) => b.classList.toggle('active', b === btn));
    const map = document.getElementById('world-map');
    if (map) {
      map.style.filter = regionKey === 'all' ? 'none'
        : regionKey === 'usa-eu' ? 'hue-rotate(15deg)'
        : regionKey === 'cis-mena' ? 'hue-rotate(60deg)'
        : 'hue-rotate(-30deg)';
    }
    window.applyAppFilters();
  };

  window.filterByCountry = function(countryCode) {
    const sel = document.getElementById('region-filter');
    if (sel) {
      sel.value = countryCode;
      window.applyAppFilters();
      document.getElementById('rankings')?.scrollIntoView({ behavior: 'smooth' });
    }
  };

  window.applyAppFilters = function() {
    const q = (document.getElementById('search')?.value || '').trim().toLowerCase();
    const countryCode = document.getElementById('region-filter')?.value || '';
    const category = document.getElementById('category-filter')?.value || '';
    const industry = document.getElementById('industry-filter')?.value || '';
    const expertise = document.getElementById('expertise-filter')?.value || '';
    const sortMode = document.getElementById('sort-filter')?.value || 'alpha';

    const listContainer = document.getElementById('company-list');
    const emptyState = document.getElementById('emptyState');
    const countEl = document.getElementById('filtered-count');
    const showAllWrap = document.getElementById('show-all-wrap');
    if (!listContainer) return;

    let filtered = window.__APP_AGENCIES.filter((c) => {
      if (window.__REGION_TAB !== 'all' && c.region !== window.__REGION_TAB) return false;
      if (q) {
        const matchName = c.name.toLowerCase().includes(q);
        const matchDesc = c.description.toLowerCase().includes(q);
        const matchCountry = c.country.toLowerCase().includes(q) || c.countryEn.toLowerCase().includes(q);
        const matchTags = c.techStack.some((t) => t.toLowerCase().includes(q));
        const matchCats = c.categories.some((cat) => cat.toLowerCase().includes(q));
        if (!matchName && !matchDesc && !matchCountry && !matchTags && !matchCats) return false;
      }
      if (countryCode && c.countryCode !== countryCode) return false;
      if (category && !c.categories.includes(category)) return false;
      if (industry && c.entityType !== industry) return false;
      if (expertise) {
        const expLower = expertise.toLowerCase();
        const hasTech = c.techStack.some((t) => t.toLowerCase().includes(expLower));
        const hasCat = c.categories.some((cat) => cat.toLowerCase().includes(expLower));
        if (!hasTech && !hasCat) return false;
      }
      return true;
    });

    if (sortMode === 'recent') {
      filtered = [...filtered].sort((a, b) => (b.verifiedDate || '').localeCompare(a.verifiedDate || ''));
    } else {
      filtered = [...filtered].sort((a, b) => a.name.localeCompare(b.name));
    }

    if (countEl) countEl.textContent = String(filtered.length);

    if (filtered.length === 0) {
      listContainer.innerHTML = '';
      if (emptyState) emptyState.classList.remove('hidden');
      if (emptyState) emptyState.style.display = 'block';
      if (showAllWrap) showAllWrap.style.display = 'none';
      return;
    }

    if (emptyState) {
      emptyState.classList.add('hidden');
      emptyState.style.display = 'none';
    }

    const limit = window.__SHOW_ALL || q || countryCode || category || industry || expertise ? filtered.length : 30;
    const toRender = filtered.slice(0, limit);

    if (showAllWrap) {
      showAllWrap.style.display = filtered.length > limit ? 'block' : 'none';
    }

    const brandmarkGradients = [
      'bg-gradient-to-br from-[#66b8fb]/15 to-[#6336ed]/20 text-[#4f35e3] border-[#d8d5fb]',
      'bg-gradient-to-br from-[#8d67ff]/15 to-[#293280]/20 text-[#6336ed] border-[#e2ddfc]',
      'bg-gradient-to-br from-[#2dd4bf]/20 to-[#6366f1]/20 text-[#2563eb] border-[#cce5ff]',
      'bg-gradient-to-br from-[#f59e0b]/15 to-[#d97706]/20 text-[#b45309] border-[#fed7aa]',
      'bg-gradient-to-br from-[#10b981]/15 to-[#059669]/20 text-[#047857] border-[#a7f3d0]',
    ];

    listContainer.innerHTML = toRender.map((c, idx) => {
      const rowNum = idx + 1;
      const grad = brandmarkGradients[idx % brandmarkGradients.length];
      const tagsHtml = c.categoryNames.slice(0, 2).map((t) => `<span class="tag max-w-[140px] truncate">${escapeHTML(t)}</span>`).join('');
      const mobileLabel = c.entityType === 'platform' ? (lang === 'ru' ? 'Платформа' : 'Platform') : (lang === 'ru' ? 'Интегратор' : 'Integrator');

      return `
        <div
          class="grid grid-cols-[28px_1fr_auto] md:grid-cols-[36px_minmax(180px,1.5fr)_minmax(150px,1.1fr)_minmax(100px,0.7fr)_minmax(105px,0.8fr)_24px] items-center gap-3 py-3 px-2 hover:bg-[#fafbfe] transition-colors cursor-pointer"
          onclick="window.location.href='${c.profileUrl}'"
          data-agency-row="${c.id}"
        >
          <span class="w-6 h-6 rounded-full bg-[#eef0f8] text-[#17172c] font-bold text-[10px] grid place-items-center shrink-0">
            ${rowNum}
          </span>
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-lg ${grad} border flex items-center justify-center shrink-0 font-bold text-xs">
              ${escapeHTML(c.name.charAt(0).toUpperCase())}
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-1.5">
                <a href="${c.profileUrl}" class="font-bold text-[13px] text-[#17172c] hover:text-[#6336ed] truncate">
                  ${escapeHTML(c.name)}
                </a>
                <span class="text-[#147dff] text-[10px] shrink-0" title="Verified domain">●</span>
              </div>
              <p class="text-[11px] text-[#59617e] truncate mt-0.5">
                ${escapeHTML(c.description)}
              </p>
              <div class="flex flex-wrap items-center gap-1.5 mt-1.5 md:hidden">
                <span class="text-[9.5px] font-semibold px-1.5 py-0.5 rounded bg-[#f5f6fa] border border-[#e5e7f3] text-[#49506c]">
                  ${escapeHTML(mobileLabel)}
                </span>
                <span class="text-[10px] text-[#59617e]">${c.flag} ${escapeHTML(c.country)}</span>
                <span class="text-[10px] font-semibold text-[#17172c]">${escapeHTML(c.budget)}</span>
              </div>
            </div>
          </div>
          <div class="hidden md:flex flex-wrap items-center gap-1 min-w-0">
            <span class="inline-block px-1.5 py-0.5 rounded bg-[#f5f6fa] border border-[#dfe1ee] text-[#49506c] text-[9.5px] font-bold">
              ${escapeHTML(mobileLabel)}
            </span>
            ${tagsHtml}
          </div>
          <div class="hidden md:block text-[11px] font-semibold text-[#17172c] truncate">
            ${escapeHTML(c.budget)}
          </div>
          <div class="hidden md:block text-[11px] text-[#4b5570] truncate">
            ${c.flag} ${escapeHTML(c.country)}
          </div>
          <div class="text-[#6f7692] text-sm font-bold text-right">›</div>
        </div>
      `;
    }).join('');
  };

  window.resetAllFilters = function() {
    ['search', 'region-filter', 'category-filter', 'industry-filter', 'expertise-filter'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    const sEl = document.getElementById('sort-filter');
    if (sEl) sEl.value = 'alpha';
    window.__REGION_TAB = 'all';
    document.querySelectorAll('.tabs button').forEach((b) => b.classList.toggle('active', b.getAttribute('data-tab') === 'all'));
    window.applyAppFilters();
  };
</script>
