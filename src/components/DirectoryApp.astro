                    <CategoryIcon category={c.id} class="w-5 h-5" />
                  </span>
                  <span class="text-[11px] font-semibold text-[#6336ed] bg-[#f0edff] px-2 py-0.5 rounded-full">
                    {catAgenciesCount} {lang === 'ru' ? 'организаций' : 'listed'}
