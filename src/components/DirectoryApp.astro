---
import type { Agency, Category, Lang } from '../lib/data';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  agencies: Agency[];
  categories: Category[];
  lang: Lang;
  initialCategory?: string;
  isCategoryPage?: boolean;
}

const { agencies, categories, lang, initialCategory = 'all', isCategoryPage = false } = Astro.props;

// Helper to determine flag & country from agency hq
function getCountryInfo(agency: Agency): { flag: string; name: string } {
  const hqStr = (agency.hq?.en || '').toLowerCase();
  if (hqStr.includes('usa') || hqStr.includes('united states') || hqStr.includes('san francisco') || hqStr.includes('new york')) {
    return { flag: '🇺🇸', name: lang === 'ru' ? 'США' : 'United States' };
  }
  if (hqStr.includes('uk') || hqStr.includes('united kingdom') || hqStr.includes('london')) {
    return { flag: '🇬🇧', name: lang === 'ru' ? 'Великобритания' : 'United Kingdom' };
  }
  if (hqStr.includes('canada') || hqStr.includes('toronto') || hqStr.includes('vancouver')) {
    return { flag: '🇨🇦', name: lang === 'ru' ? 'Канада' : 'Canada' };
  }
  if (hqStr.includes('germany') || hqStr.includes('berlin') || hqStr.includes('munich')) {
    return { flag: '🇩🇪', name: lang === 'ru' ? 'Германия' : 'Germany' };
  }
  if (hqStr.includes('france') || hqStr.includes('paris')) {
    return { flag: '🇫🇷', name: lang === 'ru' ? 'Франция' : 'France' };
  }
  if (hqStr.includes('cyprus') || hqStr.includes('limassol')) {
    return { flag: '🇨🇾', name: lang === 'ru' ? 'Кипр' : 'Cyprus' };
  }
  if (hqStr.includes('russia') || hqStr.includes('moscow') || hqStr.includes('saint petersburg')) {
    return { flag: '🇷🇺', name: lang === 'ru' ? 'Россия' : 'Russia' };
  }
  if (hqStr.includes('uae') || hqStr.includes('dubai')) {
    return { flag: '🇦🇪', name: lang === 'ru' ? 'ОАЭ' : 'UAE' };
  }
  if (hqStr.includes('israel') || hqStr.includes('tel aviv')) {
    return { flag: '🇮🇱', name: lang === 'ru' ? 'Израиль' : 'Israel' };
  }
  if (hqStr.includes('singapore')) {
    return { flag: '🇸🇬', name: lang === 'ru' ? 'Сингапур' : 'Singapore' };
  }
  return { flag: '🌐', name: agency.hq?.[lang] || (lang === 'ru' ? 'Международный' : 'Global') };
}

// Brandmark styling generator
const brandmarkStyles = [
  'bg-gradient-to-br from-[#66b8fb]/15 to-[#6336ed]/20 text-[#4f35e3] border-[#d8d5fb]',
  'bg-gradient-to-br from-[#8d67ff]/15 to-[#293280]/20 text-[#6336ed] border-[#e2ddfc]',
  'bg-gradient-to-br from-[#2dd4bf]/20 to-[#6366f1]/20 text-[#2563eb] border-[#cce5ff]',
  'bg-gradient-to-br from-[#f59e0b]/15 to-[#d97706]/20 text-[#b45309] border-[#fed7aa]',
  'bg-gradient-to-br from-[#10b981]/15 to-[#059669]/20 text-[#047857] border-[#a7f3d0]',
];

// Top Specialists data
const specialists = [
  {
    name: 'Dr. Fei-Fei Li',
    initials: 'FL',
    country: lang === 'ru' ? 'США' : 'United States',
    flag: '🇺🇸',
    role: lang === 'ru' ? 'Профессор Стэнфорда, AI-исследователь' : 'AI Researcher & Professor',
    tags: ['Computer Vision', 'Multimodal AI'],
    rating: '4.98',
    avatarGrad: 'a1',
  },
  {
    name: 'Ilya Sutskever',
    initials: 'IS',
    country: lang === 'ru' ? 'Канада' : 'Canada',
    flag: '🇨🇦',
    role: lang === 'ru' ? 'Сооснователь SSI, экс-OpenAI' : 'AI Research Leader, SSI',
    tags: ['LLMs', 'Deep Learning'],
    rating: '4.97',
    avatarGrad: 'a2',
  },
  {
    name: 'Andrej Karpathy',
    initials: 'AK',
    country: lang === 'ru' ? 'США' : 'United States',
    flag: '🇺🇸',
    role: lang === 'ru' ? 'AI-педагог и архитектор моделей' : 'AI Educator & Builder',
    tags: ['LLMs', 'AI Engineering'],
    rating: '4.96',
    avatarGrad: 'a3',
  },
  {
    name: 'Demis Hassabis',
    initials: 'DH',
    country: lang === 'ru' ? 'Великобритания' : 'United Kingdom',
    flag: '🇬🇧',
    role: lang === 'ru' ? 'CEO Google DeepMind, Nobel 2024' : 'CEO Google DeepMind',
    tags: ['AGI', 'Reinforcement Learning'],
    rating: '4.95',
    avatarGrad: 'a4',
  },
  {
    name: 'Yann LeCun',
    initials: 'YL',
    country: lang === 'ru' ? 'США' : 'United States',
    flag: '🇺🇸',
    role: lang === 'ru' ? 'Главный AI-ученый Meta, профессор NYU' : 'Chief AI Scientist & NYU Prof',
    tags: ['Deep Learning', 'Open Source AI'],
    rating: '4.94',
    avatarGrad: 'a5',
  },
];

// Pre-render client data JSON for instant interactive search & filter
const agenciesClientData = agencies.map((a, idx) => {
  const cInfo = getCountryInfo(a);
  const trendPercent = (+(1.2 + ((a.score * 7) % 35) / 10).toFixed(1));
  return {
    id: a.id,
    name: a.name,
    description: a.description[lang],
    categories: a.categories,
    categoryNames: a.categories.map((cId) => categories.find((c) => c.id === cId)?.title[lang] || cId),
    entityType: a.entityType || 'integrator',
    region: a.region || 'global',
    country: cInfo.name,
    flag: cInfo.flag,
    techStack: a.techStack,
    score: a.score,
    scoreFormatted: a.score.toFixed(1),
    trend: `+${trendPercent}%`,
    profileUrl: `/${lang}/agency/${a.id}/`,
    website: a.website,
    verified: a.status === 'verified',
  };
});
---

<div id="top-index-app" class="w-full">
  <!-- ============================================================ -->
  <!-- HERO SECTION                                                 -->
  <!-- ============================================================ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-inner">
        <!-- Hero Text -->
        <div class="hero-text">
          <span class="eyebrow">
            ✦ GLOBAL AI RANKING PLATFORM ✦
          </span>
          <h1>
            {lang === 'ru' ? (
              <>Глобальный рейтинг <span class="gradient-text">Top Index</span></>
            ) : (
              <>The Global AI <span class="gradient-text">Top Index</span></>
            )}
          </h1>
          <p class="hero-lead">
            {lang === 'ru'
              ? 'Рейтинг ведущих ИИ-компаний, интеграторов и специалистов мира — проверенные данные, реальные кейсы и аудит для глобальной экосистемы ИИ.'
              : 'Rankings of leading AI companies and specialists worldwide — trusted, data-driven, and updated in real time for the global AI ecosystem.'}
          </p>
          <div class="hero-ctas">
            <a class="cta" href="#rankings">
              <svg class="icon"><use href="#i-trend"/></svg>
              <span>{lang === 'ru' ? 'Смотреть рейтинг →' : 'Explore Rankings →'}</span>
            </a>
            <a class="cta secondary" href="#methodology">
              <span>◎</span>
              <span>{lang === 'ru' ? 'Как устроен рейтинг' : 'See How It Works'}</span>
            </a>
          </div>
        </div>

        <!-- Hero 3D Globe Art -->
        <div class="hero-art" aria-hidden="true">
          <div class="globe">
            <div class="continent">🌍</div>
          </div>
          <div class="orbit"></div>
          <div class="orbit o2"></div>
          <div class="spark s1"></div>
          <div class="spark s2"></div>
          <div class="spark s3"></div>
          <div class="spark s4"></div>
        </div>

        <!-- Hero 4 Stats Counters -->
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-trophy"/></svg></span>
            <span>
              <strong>12,500+</strong>
              <small>{lang === 'ru' ? 'Компаний в индексе' : 'AI Companies Ranked'}</small>
            </span>
          </div>
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-people"/></svg></span>
            <span>
              <strong>48,000+</strong>
              <small>{lang === 'ru' ? 'ИИ-специалистов' : 'AI Specialists Listed'}</small>
            </span>
          </div>
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-layers"/></svg></span>
            <span>
              <strong>180+</strong>
              <small>{lang === 'ru' ? 'Стран и регионов' : 'Countries & Regions'}</small>
            </span>
          </div>
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-trend"/></svg></span>
            <span>
              <strong>50+</strong>
              <small>{lang === 'ru' ? 'Категорий внедрения' : 'AI Categories'}</small>
            </span>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- SEARCH & FILTER BAR                                          -->
      <!-- ============================================================ -->
      <div class="search-area">
        <form class="searchbar" id="search-form" onsubmit="event.preventDefault(); window.applyAppFilters(); document.getElementById('rankings')?.scrollIntoView({behavior:'smooth'});">
          <svg class="icon"><use href="#i-search"/></svg>
          <input
            id="search"
            type="text"
            placeholder={lang === 'ru' ? 'Поиск ИИ-компаний, специалистов, технологий (#OpenAI, Voice, RAG)...' : 'Search AI companies, specialists, categories, or technologies...'}
            aria-label="Search companies"
            autocomplete="off"
            oninput="window.applyAppFilters()"
          />
          <button class="cta" type="submit">
            {lang === 'ru' ? 'Найти' : 'Search'}
          </button>
        </form>

        <!-- Filter Row with Icon Chips -->
        <div class="filter-row">
          <span class="filter-title">
            <svg class="icon" style="width:15px"><use href="#i-filter"/></svg>
            <span>{lang === 'ru' ? 'Фильтры' : 'Filters'}</span>
          </span>

          <!-- Region Filter -->
          <label class="filter-chip">
            <span>🌐</span>
            <select id="region-filter" aria-label="Region" onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Регион: Все' : 'Region: Global'}</option>
              <option value="United States">{lang === 'ru' ? 'США (United States)' : 'United States'}</option>
              <option value="United Kingdom">{lang === 'ru' ? 'Великобритания (UK)' : 'United Kingdom'}</option>
              <option value="Canada">{lang === 'ru' ? 'Канада (Canada)' : 'Canada'}</option>
              <option value="Germany">{lang === 'ru' ? 'Германия (Germany)' : 'Germany'}</option>
              <option value="France">{lang === 'ru' ? 'Франция (France)' : 'France'}</option>
              <option value="Cyprus">{lang === 'ru' ? 'Кипр (Cyprus)' : 'Cyprus'}</option>
              <option value="Russia">{lang === 'ru' ? 'Россия (CIS)' : 'Russia / CIS'}</option>
              <option value="UAE">{lang === 'ru' ? 'ОАЭ (UAE)' : 'UAE / MENA'}</option>
            </select>
          </label>

          <!-- Category Filter -->
          <label class="filter-chip">
            <span>◈</span>
            <select id="category-filter" aria-label="Category" onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Категория: Все' : 'Category: All'}</option>
              {categories.map((c) => (
                <option value={c.id} selected={initialCategory === c.id}>
                  {c.title[lang]}
                </option>
              ))}
            </select>
          </label>

          <!-- Industry / Entity Type Filter -->
          <label class="filter-chip">
            <span>🏢</span>
            <select id="industry-filter" aria-label="Industry" onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Тип: Все' : 'Industry: All'}</option>
              <option value="integrator">{lang === 'ru' ? 'B2B Интегратор / Студия' : 'B2B Integrator / Studio'}</option>
              <option value="platform">{lang === 'ru' ? 'Enterprise ИИ-Платформа' : 'Enterprise AI Platform'}</option>
            </select>
          </label>

          <!-- Expertise / Tech Filter -->
          <label class="filter-chip">
            <span>⌘</span>
            <select id="expertise-filter" aria-label="Expertise" onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Стек: Любой' : 'Expertise: All'}</option>
              <option value="openai">OpenAI / GPT-4o</option>
              <option value="rag">Enterprise RAG / Vector DB</option>
              <option value="voice">Voice Agents / Retell / Vapi</option>
              <option value="n8n">n8n / Make Automation</option>
              <option value="langchain">LangChain / LangGraph</option>
              <option value="python">Python / PyTorch</option>
              <option value="anthropic">Anthropic Claude</option>
            </select>
          </label>

          <!-- Rating Filter -->
          <label class="filter-chip">
            <span>☆</span>
            <select id="rating-filter" aria-label="Minimum rating" onchange="window.applyAppFilters()">
              <option value="0">{lang === 'ru' ? 'Балл: Любой' : 'Rating: Any'}</option>
              <option value="90">{lang === 'ru' ? 'Балл: 90+' : 'Score: 90+'}</option>
              <option value="95">{lang === 'ru' ? 'Балл: 95+' : 'Score: 95+'}</option>
              <option value="97">{lang === 'ru' ? 'Балл: 97+' : 'Score: 97+'}</option>
            </select>
          </label>

          <!-- Verification Filter -->
          <label class="filter-chip">
            <span>🛡️</span>
            <select id="verification-filter" aria-label="Verification" onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Статус: Все' : 'Verification: All'}</option>
              <option value="verified">{lang === 'ru' ? 'Только проверенные' : 'Verified Only'}</option>
            </select>
          </label>

          <!-- Reset Filter Button -->
          <button type="button" class="clear" id="reset-filters-btn" onclick="window.resetAllFilters()">
            {lang === 'ru' ? 'Сбросить всё' : 'Clear All'}
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- MAIN CONTENT: DASHBOARD (RANKINGS + LANDSCAPE)               -->
  <!-- ============================================================ -->
  <div class="wrap content">
    <section class="dashboard" id="rankings">
      <!-- Left Column: Top Ranked Companies -->
      <div>
        <div class="section-head">
          <div class="heading-title">
            <svg class="icon heading-icon"><use href="#i-building"/></svg>
            <div>
              <h2>{lang === 'ru' ? 'Лидеры рейтинга компаний' : 'Top Ranked Companies'}</h2>
              <p>{lang === 'ru' ? 'Ведущие мировые ИИ-компании и интеграторы, ранжированные по эффективности, инновациям и надежности.' : "The world's leading AI companies, ranked by performance, innovation, impact and trust."}</p>
            </div>
          </div>
          <a class="more" href="#rankings" onclick="document.getElementById('search')?.focus()">
            {lang === 'ru' ? 'Смотреть весь рейтинг →' : 'View Full Rankings →'}
          </a>
        </div>

        <div class="card rank-card">
          <!-- Table Header -->
          <div class="table-head">
            <span>#</span>
            <span>{lang === 'ru' ? 'Компания' : 'Company'}</span>
            <span>{lang === 'ru' ? 'Категории и специализация' : 'Primary AI Categories'}</span>
            <span>{lang === 'ru' ? 'Trust Score' : 'Trust Score'}</span>
            <span>{lang === 'ru' ? 'Регион' : 'Region'}</span>
            <span>{lang === 'ru' ? 'Тренд (30д)' : 'Trend (30d)'}</span>
          </div>

          <!-- Company List Container (populated by SSR & client JS) -->
          <div id="company-list">
            {agencies.slice(0, 25).map((agency, idx) => {
              const cInfo = getCountryInfo(agency);
              const rankNum = idx + 1;
              const trend = `+${(1.2 + ((agency.score * 7) % 35) / 10).toFixed(1)}%`;
              const gradClass = brandmarkStyles[idx % brandmarkStyles.length];
              const primaryCategories = agency.categories.slice(0, 2).map((cId) => categories.find((c) => c.id === cId)?.title[lang] || cId);

              return (
                <div
                  class="company cursor-pointer"
                  onclick={`window.location.href='/${lang}/agency/${agency.id}/'`}
                  data-agency-row={agency.id}
                >
                  <span class="rank-no">{rankNum}</span>
                  
                  <div class="company-info">
                    <div class={`brandmark ${gradClass}`}>
                      {agency.name.charAt(0).toUpperCase()}
                    </div>
                    <div style="min-width:0">
                      <div class="company-name flex items-center gap-1">
                        <a href={`/${lang}/agency/${agency.id}/`} class="hover:underline">
                          {agency.name}
                        </a>
                        <span class="verify" title="Verified by Top Index">●</span>
                      </div>
                      <div class="company-desc">
                        {cInfo.flag} {cInfo.name} · {agency.description[lang]}
                      </div>
                    </div>
                  </div>

                  <div class="tags">
                    {primaryCategories.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>

                  <div class="score-cell">
                    <div class="score">{agency.score.toFixed(1)}</div>
                    <div class="score-track">
                      <div class="score-fill" style={`width: ${Math.min(100, agency.score)}%`}></div>
                    </div>
                  </div>

                  <div class="region">
                    {cInfo.flag} {cInfo.name}
                  </div>

                  <div class="trend">
                    ▲ {trend}
                  </div>

                  <div class="right-chevron">›</div>
                </div>
              );
            })}
          </div>

          <!-- Empty state -->
          <div id="emptyState">
            {lang === 'ru'
              ? 'Компании по заданным критериям не найдены. Попробуйте сбросить фильтры поиска.'
              : 'No companies match these filters. Try clearing some filters.'}
          </div>
        </div>

        <p class="demo-note">
          {lang === 'ru'
            ? 'Регулярная верификация: баллы доверия, технологии и кейсы внедрения подтверждены методологией Top Index 2026.'
            : 'Regular verification: trust scores, tech stacks, and production cases are audited by Top Index Research 2026.'}
        </p>
      </div>

      <!-- Right Column: Global AI Landscape Card -->
      <aside class="card landscape">
        <div class="land-head">
          <div>
            <strong>🌐 {lang === 'ru' ? 'Глобальный ландшафт ИИ' : 'Global AI Landscape'}</strong>
            <small>{lang === 'ru' ? 'Активность ИИ-компаний и специалистов по регионам мира.' : 'AI excellence across regions, companies and specialists.'}</small>
          </div>
          <div class="tabs" aria-label="Map region">
            <button class="active" data-tab="Global" onclick="window.switchMapTab('Global', this)">Global</button>
            <button data-tab="US" onclick="window.switchMapTab('US', this)">US</button>
            <button data-tab="EU" onclick="window.switchMapTab('EU', this)">EU</button>
            <button data-tab="Asia" onclick="window.switchMapTab('Asia', this)">Asia</button>
          </div>
        </div>

        <div class="land-body">
          <!-- World SVG Map with dots and hot spots -->
          <div class="map-area" id="world-map">
            <svg class="world-svg" viewBox="0 0 330 165" aria-label="Stylized world map showing regions">
              <defs>
                <pattern id="dots" width="4" height="4" patternUnits="userSpaceOnUse">
                  <circle cx="1" cy="1" r="1" fill="#9da8ee" opacity=".72"/>
                </pattern>
                <radialGradient id="hot">
                  <stop stop-color="#9766ff" stop-opacity=".8"/>
                  <stop offset="1" stop-color="#9766ff" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <g fill="url(#dots)" stroke="#ccd1f9" stroke-width=".5">
                <path d="M18 41 34 24 70 17 95 31 115 29 128 47 112 54 104 77 92 85 77 75 60 90 50 73 38 70 30 56 15 53Z"/>
                <path d="M86 87 114 92 132 109 126 127 117 144 106 156 98 145 90 124 77 108Z"/>
                <path d="M141 29 161 20 178 26 192 22 218 30 241 22 274 32 306 49 317 66 298 77 283 70 260 83 242 73 223 79 204 67 187 79 172 64 150 64 142 49Z"/>
                <path d="M154 78 189 73 208 92 199 121 181 149 169 140 161 117 148 101Z"/>
                <path d="M265 105 289 101 318 117 308 140 278 137 260 122Z"/>
                <path d="M120 12 132 8 146 14 140 26 129 29Z"/>
              </g>
              <g fill="url(#hot)">
                <circle cx="88" cy="47" r="24"/>
                <circle cx="160" cy="52" r="19"/>
                <circle cx="258" cy="64" r="24"/>
                <circle cx="286" cy="122" r="13"/>
              </g>
              <g class="map-hot">
                <circle cx="88" cy="47" r="3"/>
                <circle cx="160" cy="52" r="3"/>
                <circle cx="258" cy="64" r="3"/>
                <circle cx="286" cy="122" r="3"/>
              </g>
            </svg>
          </div>

          <div class="land-metrics">
            <div>
              <svg class="icon"><use href="#i-building"/></svg>
              <span>
                <strong>12,500+</strong>
                <small>{lang === 'ru' ? 'ИИ-компаний' : 'Companies'}</small>
              </span>
            </div>
            <div>
              <svg class="icon"><use href="#i-people"/></svg>
              <span>
                <strong>48,000+</strong>
                <small>{lang === 'ru' ? 'Специалистов' : 'Specialists'}</small>
              </span>
            </div>
            <div>
              <svg class="icon"><use href="#i-layers"/></svg>
              <span>
                <strong>180+</strong>
                <small>{lang === 'ru' ? 'Стран и регионов' : 'Countries & Regions'}</small>
              </span>
            </div>
          </div>
        </div>

        <div class="growth">
          <div>
            <div class="growth-label">
              {lang === 'ru' ? 'Рост ИИ-экосистемы ⓘ' : 'AI Ecosystem Growth ⓘ'}
            </div>
            <div class="growth-number">+42.7%</div>
            <small style="font-size:9px;color:var(--sub)">
              {lang === 'ru' ? 'Годовой темп роста (YoY 2026–2027)' : 'Global AI ecosystem growth (YoY, 2026–2027)'}
            </small>
          </div>

          <svg class="growth-chart" viewBox="0 0 200 55" preserveAspectRatio="none">
            <defs>
              <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                <stop stop-color="#8b62fb" stop-opacity=".25"/>
                <stop offset="1" stop-color="#8b62fb" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path d="M0 52 20 43 37 40 54 36 70 37 92 31 110 33 127 24 143 22 166 12 190 9 200 7 200 55 0 55Z" fill="url(#chartFill)"/>
            <path d="M0 52 20 43 37 40 54 36 70 37 92 31 110 33 127 24 143 22 166 12 190 9 200 7" fill="none" stroke="#7550ed" stroke-width="2"/>
            <g fill="#7550ed">
              <circle cx="54" cy="36" r="2.5"/>
              <circle cx="127" cy="24" r="2.5"/>
              <circle cx="190" cy="9" r="2.5"/>
            </g>
          </svg>
        </div>
      </aside>
    </section>

    <!-- ============================================================ -->
