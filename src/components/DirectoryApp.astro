<!-- CLIENT INTERACTIVITY SCRIPT                                  -->
<!-- ============================================================ -->
<script is:inline define:vars={{ agenciesClientData, lang, FLAG_SVGS, PAGE_SIZE }}>
  window.__APP_AGENCIES = agenciesClientData;
  window.__APP_LANG = lang;
  window.__CURRENT_PAGE = 1;
  window.__REGION_TAB = 'all';

  const escapeHTML = (str) =>
    String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const getFlagHtml = (code) => FLAG_SVGS[code] || FLAG_SVGS.GLOBAL;

  const splitBudgetClient = (raw) => {
    const trimmed = String(raw || '').trim();
    const paren = trimmed.match(/^([^(]+?)\s*\(([^)]+)\)$/);
    if (paren) return { main: paren[1].trim(), note: paren[2].trim() };
    const dot = trimmed.match(/^(Enterprise)\s*[·•]\s*(.+)$/i);
    if (dot) return { main: dot[1].trim(), note: dot[2].trim() };
    return { main: trimmed, note: '' };
  };

  window.goToPage = function(page) {
    window.__CURRENT_PAGE = page;
    window.applyAppFilters(true);
    document.getElementById('rankings')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  window.filterByRegionTab = function(regionKey, btn) {
    window.__REGION_TAB = regionKey;
    document.querySelectorAll('.tabs button').forEach((b) => b.classList.toggle('active', b === btn));
    const map = document.getElementById('world-map');
    if (map) {
      map.style.filter = regionKey === 'all' ? 'none'
        : regionKey === 'usa-eu' ? 'hue-rotate(15deg)'
        : regionKey === 'cis-mena' ? 'hue-rotate(60deg)'
        : 'hue-rotate(-30deg)';
    }
    window.applyAppFilters(false);
  };

  window.filterByCountry = function(countryCode) {
    const sel = document.getElementById('region-filter');
    if (sel) {
      sel.value = countryCode;
      window.applyAppFilters(false);
      document.getElementById('rankings')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  window.applyAppFilters = function(keepPage = false) {
    const q = (document.getElementById('search')?.value || '').trim().toLowerCase();
    const countryCode = document.getElementById('region-filter')?.value || '';
    const category = document.getElementById('category-filter')?.value || '';
    const industry = document.getElementById('industry-filter')?.value || '';
    const expertise = document.getElementById('expertise-filter')?.value || '';
    const sortMode = document.getElementById('sort-filter')?.value || 'alpha';

    // Update dynamic vector SVG flag inside Country filter chip
    const flagSlot = document.getElementById('region-filter-flag');
    if (flagSlot) {
      flagSlot.innerHTML = getFlagHtml(countryCode || 'GLOBAL');
    }

    const listContainer = document.getElementById('company-list');
    const emptyState = document.getElementById('emptyState');
    const countEl = document.getElementById('filtered-count');
    const paginationBar = document.getElementById('pagination-bar');
    const paginationSummary = document.getElementById('pagination-summary');
    const paginationControls = document.getElementById('pagination-controls');
    if (!listContainer) return;

    let filtered = window.__APP_AGENCIES.filter((c) => {
      if (window.__REGION_TAB !== 'all' && c.region !== window.__REGION_TAB) return false;
      if (q) {
        const matchName = c.name.toLowerCase().includes(q);
        const matchDesc = c.description.toLowerCase().includes(q);
        const matchCountry = c.country.toLowerCase().includes(q) || c.countryEn.toLowerCase().includes(q);
        const matchTags = c.techStack.some((t) => t.toLowerCase().includes(q));
        const matchCats = c.categories.some((cat) => cat.toLowerCase().includes(q));
        if (!matchName && !matchDesc && !matchCountry && !matchTags && !matchCats) return false;
      }
      if (countryCode && c.countryCode !== countryCode) return false;
      if (category && !c.categories.includes(category)) return false;
      if (industry && c.entityType !== industry) return false;
      if (expertise) {
        const expLower = expertise.toLowerCase();
        const hasTech = c.techStack.some((t) => t.toLowerCase().includes(expLower));
        const hasCat = c.categories.some((cat) => cat.toLowerCase().includes(expLower));
        if (!hasTech && !hasCat) return false;
      }
      return true;
    });

    if (sortMode === 'recent') {
      filtered = [...filtered].sort((a, b) => (b.verifiedDate || '').localeCompare(a.verifiedDate || ''));
    } else {
      filtered = [...filtered].sort((a, b) => a.name.localeCompare(b.name));
    }

    if (countEl) countEl.textContent = String(filtered.length);

    if (filtered.length === 0) {
      listContainer.innerHTML = '';
      if (emptyState) {
        emptyState.classList.remove('hidden');
        emptyState.style.display = 'block';
      }
      if (paginationBar) paginationBar.style.display = 'none';
      return;
    }

    if (emptyState) {
      emptyState.classList.add('hidden');
      emptyState.style.display = 'none';
    }

    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    if (!keepPage) {
      window.__CURRENT_PAGE = 1;
    } else if (window.__CURRENT_PAGE > totalPages) {
      window.__CURRENT_PAGE = totalPages;
    } else if (window.__CURRENT_PAGE < 1) {
      window.__CURRENT_PAGE = 1;
    }

    const page = window.__CURRENT_PAGE;
    const startIdx = (page - 1) * PAGE_SIZE;
    const endIdx = Math.min(startIdx + PAGE_SIZE, filtered.length);
    const toRender = filtered.slice(startIdx, endIdx);

    if (paginationBar) {
      if (totalPages <= 1) {
        paginationBar.style.display = 'none';
      } else {
        paginationBar.style.display = 'flex';
        if (paginationSummary) {
          paginationSummary.textContent = lang === 'ru'
            ? `Показано ${startIdx + 1}–${endIdx} из ${filtered.length}`
            : `Showing ${startIdx + 1}–${endIdx} of ${filtered.length}`;
        }
        if (paginationControls) {
          const prevDisabled = page <= 1;
          const nextDisabled = page >= totalPages;
          let btns = `<button type="button" ${prevDisabled ? 'disabled' : `onclick="window.goToPage(${page - 1})"`} class="px-2.5 py-1.5 rounded-lg border border-[#e5e7f3] text-[11.5px] font-semibold ${prevDisabled ? 'text-[#9aa0b8] cursor-not-allowed' : 'bg-white text-[#394464] hover:border-[#8d67ff] hover:text-[#6336ed] cursor-pointer'}">←</button>`;
          for (let p = 1; p <= totalPages; p++) {
            const active = p === page;
            btns += `<button type="button" onclick="window.goToPage(${p})" class="min-w-[32px] h-[30px] px-2 rounded-lg text-[11.5px] font-bold transition-colors cursor-pointer ${active ? 'page-btn-active bg-[#6336ed] text-white border border-[#6336ed] shadow-sm' : 'bg-white text-[#394464] border border-[#e5e7f3] hover:border-[#8d67ff] hover:text-[#6336ed]'}">${p}</button>`;
          }
          btns += `<button type="button" ${nextDisabled ? 'disabled' : `onclick="window.goToPage(${page + 1})"`} class="px-2.5 py-1.5 rounded-lg border border-[#e5e7f3] text-[11.5px] font-semibold ${nextDisabled ? 'text-[#9aa0b8] cursor-not-allowed' : 'bg-white text-[#394464] hover:border-[#8d67ff] hover:text-[#6336ed] cursor-pointer'}">→</button>`;
          paginationControls.innerHTML = btns;
        }
      }
    }

    const brandmarkGradients = [
      'bg-gradient-to-br from-[#66b8fb]/15 to-[#6336ed]/20 text-[#4f35e3] border-[#d8d5fb]',
      'bg-gradient-to-br from-[#8d67ff]/15 to-[#293280]/20 text-[#6336ed] border-[#e2ddfc]',
      'bg-gradient-to-br from-[#2dd4bf]/20 to-[#6366f1]/20 text-[#2563eb] border-[#cce5ff]',
      'bg-gradient-to-br from-[#f59e0b]/15 to-[#d97706]/20 text-[#b45309] border-[#fed7aa]',
      'bg-gradient-to-br from-[#10b981]/15 to-[#059669]/20 text-[#047857] border-[#a7f3d0]',
    ];

    listContainer.innerHTML = toRender.map((c, idx) => {
      const grad = brandmarkGradients[(startIdx + idx) % brandmarkGradients.length];
      const tagsHtml = c.categoryNames.slice(0, 2).map((t) => `<span class="tag max-w-[140px] truncate">${escapeHTML(t)}</span>`).join('');
      const stackHtml = (c.techStack || []).slice(0, 3).map((tag) => `<span class="text-[10.5px] font-medium px-1.5 py-0.5 rounded bg-[#f4f3ff] text-[#5836c7] border border-[#e6e2ff]">${escapeHTML(tag)}</span>`).join('');
      const mobileLabel = c.entityType === 'platform' ? (lang === 'ru' ? 'Платформа' : 'Platform') : (lang === 'ru' ? 'Интегратор' : 'Integrator');
      const verifiedTitle = lang === 'ru' ? 'Домен подтверждён' : 'Verified domain';
      const budgetParts = splitBudgetClient(c.budget);
      const flagSvg = getFlagHtml(c.countryCode);

      return `
        <div
          class="grid grid-cols-[1fr_auto] md:grid-cols-[minmax(215px,1.6fr)_minmax(150px,1.05fr)_minmax(122px,0.8fr)_minmax(122px,0.85fr)_20px] items-center gap-3 py-3.5 px-2 hover:bg-[#fafbfe] transition-colors cursor-pointer"
          onclick="window.location.href='${c.profileUrl}'"
          data-agency-row="${c.id}"
        >
          <div class="flex items-start gap-3 min-w-0">
            <div class="w-9 h-9 rounded-lg ${grad} border flex items-center justify-center shrink-0 font-bold text-sm mt-0.5">
              ${escapeHTML(c.name.charAt(0).toUpperCase())}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 min-w-0">
                <a href="${c.profileUrl}" class="font-bold text-[15px] md:text-[13.5px] text-[#17172c] hover:text-[#6336ed] truncate">
                  ${escapeHTML(c.name)}
                </a>
                <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#e8f2ff] text-[#147dff] shrink-0" title="${verifiedTitle}" aria-label="${verifiedTitle}">
                  <svg class="w-2.5 h-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.77a1 1 0 1 1 1.42-1.41l3.04 3.06 6.54-6.59a1 1 0 0 1 1.414-.004Z" clip-rule="evenodd" />
                  </svg>
                </span>
              </div>
              <p class="text-[14px] md:text-[12px] leading-[1.42] text-[#59617e] line-clamp-2 mt-1">
                ${escapeHTML(c.description)}
              </p>
              ${stackHtml ? `<div class="flex flex-wrap items-center gap-1 mt-1.5">${stackHtml}</div>` : ''}
              <div class="flex flex-wrap items-center gap-2 mt-2 md:hidden">
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-[#f5f6fa] border border-[#e5e7f3] text-[#49506c]">
                  ${escapeHTML(mobileLabel)}
                </span>
                <span class="inline-flex items-center gap-1.5 text-[11.5px] text-[#59617e]">
                  ${flagSvg}
                  <span>${escapeHTML(c.country)}</span>
                </span>
                <span class="text-[11.5px] font-semibold text-[#17172c]">${escapeHTML(budgetParts.main)}</span>
              </div>
            </div>
          </div>
          <div class="hidden md:flex flex-wrap items-center gap-1 min-w-0">
            <span class="inline-block px-1.5 py-0.5 rounded bg-[#f5f6fa] border border-[#dfe1ee] text-[#49506c] text-[10px] font-bold">
              ${escapeHTML(mobileLabel)}
            </span>
            ${tagsHtml}
          </div>
          <div class="hidden md:flex flex-col leading-snug">
            <span class="text-[12px] font-bold text-[#17172c] whitespace-nowrap">${escapeHTML(budgetParts.main)}</span>
            ${budgetParts.note ? `<span class="text-[10.5px] text-[#6b728e] font-normal mt-0.5 leading-tight">${escapeHTML(budgetParts.note)}</span>` : ''}
          </div>
          <div class="hidden md:flex items-center gap-2 text-[12px] text-[#4b5570] min-w-0">
            ${flagSvg}
            <span class="truncate">${escapeHTML(c.country)}</span>
          </div>
          <div class="text-[#6f7692] text-sm font-bold text-right">›</div>
        </div>
      `;
    }).join('');
  };

  window.resetAllFilters = function() {
    ['search', 'region-filter', 'category-filter', 'industry-filter', 'expertise-filter'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    const sEl = document.getElementById('sort-filter');
    if (sEl) sEl.value = 'alpha';
    window.__REGION_TAB = 'all';
    document.querySelectorAll('.tabs button').forEach((b) => b.classList.toggle('active', b.getAttribute('data-tab') === 'all'));
    window.applyAppFilters(false);
  };
</script>
