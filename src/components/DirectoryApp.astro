  </div>

  <!-- ============================================================ -->
  <!-- PLATFORM RESOURCES & GUIDES BANNER                           -->
  <!-- ============================================================ -->
  <section class="insights" id="insights">
    <div class="wrap insights-grid">
      <div class="insight-intro">
        <h2>{lang === 'ru' ? 'Инструменты и стандарты' : 'Platform Resources'}</h2>
        <p>{lang === 'ru' ? 'Документация по отбору ИИ-подрядчиков, расчёту бюджета внедрения и добавлению вашей компании в каталог.' : 'Documentation for evaluating AI vendors, estimating implementation scope, and joining the index.'}</p>
        <a href={`/${lang}/methodology/`}>{lang === 'ru' ? 'Методология →' : 'Read Methodology →'}</a>
      </div>

      <a href={`/${lang}/methodology/`} class="story hover:shadow-lg transition-shadow">
        <div class="story-art">✦</div>
        <div>
          <span class="category">{lang === 'ru' ? 'Документация' : 'Documentation'}</span>
          <h3>{lang === 'ru' ? 'Как Top Index проверяет домены и разделяет интеграторов и платформы' : 'How Top Index Verifies Domains & Separates Integrators from Platforms'}</h3>
          <small>{lang === 'ru' ? 'Стандарт каталога' : 'Verification Standard'}</small>
