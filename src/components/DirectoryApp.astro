---
import type { Agency, Category, Lang } from '../lib/data';
import AgencyCard from './AgencyCard.astro';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  agencies: Agency[];
  categories: Category[];
  lang: Lang;
  initialCategory?: string;
  isCategoryPage?: boolean;
}

const { agencies, categories, lang, initialCategory = 'all', isCategoryPage = false } = Astro.props;

// Category definitions for top pill row
const pillCategories = [
  { id: 'all', label: lang === 'ru' ? 'Все' : 'All', icon: 'sliders' },
  { id: 'sales', label: lang === 'ru' ? 'ИИ-агенты и CRM' : 'AI Agents', icon: 'bot' },
  { id: 'enterprise', label: lang === 'ru' ? 'LLM и RAG' : 'LLM & RAG', icon: 'brain' },
  { id: 'voice', label: lang === 'ru' ? 'Голосовой ИИ' : 'Voice AI', icon: 'mic' },
  { id: 'workflow', label: lang === 'ru' ? 'n8n и Make' : 'Automation', icon: 'bolt' },
  { id: 'video', label: lang === 'ru' ? 'ИИ-видео' : 'AI Video', icon: 'video' },
  { id: 'realestate', label: lang === 'ru' ? 'Недвижимость' : 'Real Estate', icon: 'building' },
  { id: 'healthcare', label: lang === 'ru' ? 'Медицина' : 'Healthcare', icon: 'heart' },
  { id: 'ecommerce', label: lang === 'ru' ? 'E-Commerce' : 'E-Commerce', icon: 'cart' },
  { id: 'geo', label: lang === 'ru' ? 'GEO в ИИ' : 'GEO Search', icon: 'globe' },
];
---

<div id="directory-app" class="w-full" data-initial-cat={initialCategory}>
  <!-- [SearchCommandBar] Заголовок H1 + Командная строка поиска -->
  <section class="pt-4 pb-3">
    {!isCategoryPage && (
      <h1 class="text-[21px] sm:text-[28px] font-bold leading-[1.22] tracking-[-0.025em] text-[#F3F6FA] text-center mb-3.5">
        {lang === 'ru' ? 'Найдите ИИ-компании и интеграторов' : 'Find AI Companies & Integrators'}
      </h1>
    )}

    <!-- Командная строка с неоново-бирюзовым свечением -->
    <div class="command-glow rounded-xl h-[46px] px-3 flex items-center transition-shadow max-w-2xl mx-auto">
      <span class="w-6 h-6 rounded-md bg-[#171E27] border border-[#1E2631] flex items-center justify-center text-[#8B96A5] mr-2.5 shrink-0">
        <!-- Иконка командной клавиши ⌘ -->
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/>
        </svg>
      </span>

      <input
        type="text"
        id="searchInput"
        oninput="handleSearch(this.value)"
        placeholder={lang === 'ru' ? 'Опишите задачу или стек ИИ (напр. Voice agent, RAG, n8n)...' : 'Describe your task or AI stack (e.g. Voice agent, RAG, n8n)...'}
        class="w-full bg-transparent text-[13px] text-[#F3F6FA] placeholder:text-[#8B96A5]/80 focus:outline-none pr-3"
      />

      <button
        type="button"
        id="clearSearchBtn"
        onclick="clearSearch()"
        class="hidden w-5 h-5 rounded-full bg-[#171E27] hover:bg-[#1E2631] text-[#8B96A5] hover:text-[#F3F6FA] text-[11px] items-center justify-center shrink-0 cursor-pointer"
        aria-label="Clear search"
      >
        ✕
      </button>
    </div>
  </section>

  <!-- [CategoryPills] Горизонтальные капсулы категорий -->
  <section class="flex items-center gap-2 overflow-x-auto no-scrollbar py-2 -mx-4 px-4 sm:mx-0 sm:px-0">
    {pillCategories.map((cat) => {
      const isSelected = initialCategory === cat.id;
      return (
        <button
          type="button"
          data-cat-pill={cat.id}
          onclick={`selectCategory('${cat.id}')`}
          class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[12px] whitespace-nowrap shrink-0 transition-all cursor-pointer ${
            isSelected
              ? 'bg-[#2DD4BF]/15 border border-[#2DD4BF]/80 text-[#2DD4BF] font-semibold shadow-[0_0_14px_rgba(45,212,191,0.25)]'
              : 'bg-[#11161D] border border-[#1E2631] text-[#F3F6FA]/90 hover:border-[#8B96A5]/50 font-medium'
          }`}
        >
          <span>{cat.label}</span>
        </button>
      );
    })}
  </section>

  <!-- [ResultsToolbar] Счётчик найденных компаний и сортировка -->
  <section class="pt-3 pb-2.5 flex items-center justify-between gap-2 border-b border-[#1E2631]/60 mb-4">
    <p id="resultsCounter" class="text-[12px] text-[#8B96A5]">
      <span class="font-bold text-[#F3F6FA]" id="visibleCount">{agencies.length}</span> {lang === 'ru' ? 'проверенных ИИ-агентств и студий' : 'verified AI experts and agencies'}
    </p>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="resetFilterChip"
        onclick="resetDirectory()"
        class="hidden text-[11px] font-medium text-[#2DD4BF] bg-[#2DD4BF]/10 border border-[#2DD4BF]/30 rounded-lg px-2 py-1 hover:bg-[#2DD4BF]/20 transition-colors cursor-pointer"
      >
        {lang === 'ru' ? 'Сбросить' : 'Reset'}
      </button>

      <button
        type="button"
        onclick="cycleSort()"
        class="inline-flex items-center gap-1.5 text-[11.5px] font-medium text-[#F3F6FA] bg-[#11161D] hover:bg-[#171E27] border border-[#1E2631] rounded-lg px-2.5 py-1 transition-colors cursor-pointer"
      >
        <span id="sortLabel">{lang === 'ru' ? 'По рейтингу' : 'Top rated'}</span>
        <svg class="w-3 h-3 text-[#8B96A5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </section>

  <!-- [Categories Tab View] Сетка направлений ИИ (активируется при переходе на вкладку Categories) -->
  <div id="categoriesTabContainer" class="hidden pb-12">
    <div class="bg-[#11161D] border border-[#1E2631] rounded-2xl p-4 sm:p-6 mb-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-2">
        <div>
          <h2 class="text-[16px] sm:text-[18px] font-bold text-[#F3F6FA]">
            {lang === 'ru' ? 'Направления внедрения ИИ' : 'AI Specialization Categories'}
          </h2>
          <p class="text-[12px] text-[#8B96A5]">
            {lang === 'ru' ? 'Выберите сферу для перехода к специализированному рейтингу и кейсам' : 'Select an AI domain to view verified integrators and production benchmarks'}
          </p>
        </div>
        <span class="font-mono text-[11px] text-[#2DD4BF] bg-[#2DD4BF]/10 px-2 py-0.5 rounded border border-[#2DD4BF]/30 self-start sm:self-auto">
          9 {lang === 'ru' ? 'рубрик' : 'verticals'}
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {categories.map((c) => (
          <a
            href={`/${lang}/${c.slug[lang]}/`}
            class="bg-[#090C10] hover:bg-[#171E27] border border-[#1E2631] hover:border-[#2DD4BF]/50 rounded-xl p-3.5 text-left transition-all group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="w-8 h-8 rounded-lg bg-[#11161D] border border-[#1E2631] flex items-center justify-center text-[#2DD4BF] group-hover:scale-105 transition-transform">
                  <CategoryIcon category={c.id} class="w-5 h-5" />
                </span>
                <span class="font-mono text-[11px] text-[#2DD4BF] bg-[#2DD4BF]/10 px-2 py-0.5 rounded-md">
                  {agencies.filter((a) => a.categories.includes(c.id)).length} {lang === 'ru' ? 'команд' : 'agencies'}
                </span>
              </div>
              <div class="text-[14px] font-semibold text-[#F3F6FA] group-hover:text-[#2DD4BF] transition-colors leading-snug">
                {c.title[lang]}
              </div>
              <p class="text-[11.5px] text-[#8B96A5] leading-snug mt-1.5 line-clamp-2">
                {c.short[lang]}
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-[#1E2631]/60 flex items-center justify-between text-[11px] font-mono text-[#8B96A5] group-hover:text-[#2DD4BF]">
              <span>{lang === 'ru' ? 'Открыть рейтинг' : 'Explore vertical'}</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- [Main Directory Grid] Карточки ИИ-компаний -->
  <main id="mainGridContainer" class="pb-16">
    <div id="agenciesList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      {agencies.map((agency, index) => (
        <AgencyCard agency={agency} lang={lang} rank={index + 1} />
      ))}
    </div>

    <!-- Empty State -->
    <div id="emptyResultsState" class="hidden bg-[#11161D] border border-[#1E2631] rounded-2xl p-8 text-center my-6">
      <div class="w-12 h-12 rounded-full bg-[#171E27] border border-[#1E2631] flex items-center justify-center mx-auto mb-3 text-lg">
        🔍
      </div>
      <h3 id="emptyTitle" class="text-[15px] font-bold text-[#F3F6FA] mb-1">
        {lang === 'ru' ? 'Подходящие ИИ-команды не найдены' : 'No matching AI integrators'}
      </h3>
      <p id="emptyDesc" class="text-[12.5px] text-[#8B96A5] max-w-sm mx-auto mb-4">
        {lang === 'ru' ? 'Попробуйте изменить поисковый запрос или сбросить фильтры направлений.' : 'Try searching another technology tag (e.g. #OpenAI, #Python) or reset active filters.'}
      </p>
      <button
        type="button"
        onclick="resetDirectory()"
        class="bg-[#2DD4BF]/15 border border-[#2DD4BF]/40 text-[#2DD4BF] text-[12px] font-semibold px-4 py-2 rounded-xl hover:bg-[#2DD4BF]/25 transition-colors cursor-pointer"
      >
        {lang === 'ru' ? 'Сбросить все фильтры' : 'Reset all filters'}
      </button>
    </div>
  </main>
</div>

<script is:inline>
  let currentCategory = 'all';
  let searchQuery = '';
  let sortIndex = 0; // 0: Top rated, 1: Most reviewed, 2: Verified first
  let currentTab = 'directory'; // 'directory' | 'categories' | 'saved'

  window.__CURRENT_TAB = 'directory';

  const sortOptions = {
    en: ['Top rated', 'Most reviewed', 'Verified first'],
    ru: ['По рейтингу', 'По отзывам', 'Сначала верифицированные'],
  };

  function updatePillStyles() {
    document.querySelectorAll('[data-cat-pill]').forEach((p) => {
      const isSelected = p.getAttribute('data-cat-pill') === currentCategory;
      if (isSelected) {
        p.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[12px] whitespace-nowrap shrink-0 transition-all cursor-pointer bg-[#2DD4BF]/15 border border-[#2DD4BF]/80 text-[#2DD4BF] font-semibold shadow-[0_0_14px_rgba(45,212,191,0.25)]';
      } else {
        p.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[12px] whitespace-nowrap shrink-0 transition-all cursor-pointer bg-[#11161D] border border-[#1E2631] text-[#F3F6FA]/90 hover:border-[#8B96A5]/50 font-medium';
      }
    });
  }

  window.selectCategory = function(catId) {
    if (currentTab !== 'directory') {
      window.switchTab('directory');
    }
    currentCategory = catId;
    updatePillStyles();
    window.applyDirectoryFilters();
  };

  window.handleSearch = function(val) {
    if (currentTab !== 'directory') {
      window.switchTab('directory');
    }
    searchQuery = val.trim().toLowerCase();
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
      clearBtn.classList.toggle('hidden', val.length === 0);
      clearBtn.classList.toggle('flex', val.length > 0);
    }
    window.applyDirectoryFilters();
  };

  window.clearSearch = function() {
    searchQuery = '';
    const input = document.getElementById('searchInput');
    if (input) input.value = '';
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
      clearBtn.classList.add('hidden');
      clearBtn.classList.remove('flex');
    }
    window.applyDirectoryFilters();
  };

  window.filterByTag = function(tag) {
    if (currentTab !== 'directory') {
      window.switchTab('directory');
    }
    const clean = tag.replace(/^#/, '');
    const input = document.getElementById('searchInput');
    if (input) input.value = '#' + clean;
    window.handleSearch(clean);
  };

  window.cycleSort = function() {
    sortIndex = (sortIndex + 1) % 3;
    const lang = window.__LANG || 'en';
    const labelEl = document.getElementById('sortLabel');
    if (labelEl) {
      labelEl.textContent = (sortOptions[lang] || sortOptions.en)[sortIndex];
    }
    window.applyDirectoryFilters();
  };

  window.resetDirectory = function() {
    currentCategory = 'all';
    searchQuery = '';
    sortIndex = 0;
    const input = document.getElementById('searchInput');
    if (input) input.value = '';
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
      clearBtn.classList.add('hidden');
      clearBtn.classList.remove('flex');
    }
    const lang = window.__LANG || 'en';
    const labelEl = document.getElementById('sortLabel');
    if (labelEl) {
      labelEl.textContent = (sortOptions[lang] || sortOptions.en)[0];
    }
    updatePillStyles();
    if (currentTab !== 'directory') {
      window.switchTab('directory');
    } else {
      window.applyDirectoryFilters();
    }
  };

  window.switchTab = function(tab) {
    currentTab = tab;
    window.__CURRENT_TAB = tab;

    // Update bottom nav active state
    ['directory', 'categories', 'saved'].forEach((tName) => {
      const btn = document.getElementById('nav-' + tName);
      if (!btn) return;
      const pillWrap = btn.querySelector('span');
      const svg = btn.querySelector('svg');
      const isAct = tName === tab;
      btn.className = isAct
        ? 'flex flex-col items-center justify-center gap-1 text-[#F3F6FA] font-semibold transition-colors cursor-pointer'
        : 'flex flex-col items-center justify-center gap-1 text-[#8B96A5] hover:text-[#F3F6FA] font-medium transition-colors cursor-pointer';
      if (pillWrap) {
        pillWrap.className = isAct
          ? 'px-3 py-0.5 rounded-lg bg-[#171E27]/90 border border-[#1E2631]/80'
          : 'px-3 py-0.5 rounded-lg';
      }
      if (svg) {
        svg.classList.toggle('text-[#2DD4BF]', isAct);
      }
    });

    const catContainer = document.getElementById('categoriesTabContainer');
    const mainGrid = document.getElementById('mainGridContainer');

    if (tab === 'categories') {
      if (catContainer) catContainer.classList.remove('hidden');
      if (mainGrid) mainGrid.classList.add('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      if (catContainer) catContainer.classList.add('hidden');
      if (mainGrid) mainGrid.classList.remove('hidden');
      window.applyDirectoryFilters();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };

  window.applyDirectoryFilters = function() {
    const cards = Array.from(document.querySelectorAll('[data-agency-card]'));
    const savedIds = (() => {
      try {
        return JSON.parse(localStorage.getItem('aitopindex_saved') || '[]');
      } catch (e) {
        return [];
      }
    })();

    let visibleCount = 0;
    const cleanQ = searchQuery.replace(/^#/, '');

    cards.forEach((card) => {
      const id = card.getAttribute('data-id') || '';
      const name = card.getAttribute('data-name') || '';
      const cats = (card.getAttribute('data-categories') || '').split(' ');
      const tags = (card.getAttribute('data-tags') || '').split(' ');

      // Category check
      const matchCat = currentCategory === 'all' || cats.includes(currentCategory);

      // Search check
      let matchSearch = true;
      if (cleanQ) {
        const textToMatch = (name + ' ' + cats.join(' ') + ' ' + tags.join(' ')).toLowerCase();
        matchSearch = textToMatch.includes(cleanQ);
      }

      // Saved tab check
      let matchSaved = true;
      if (currentTab === 'saved') {
        matchSaved = savedIds.includes(id);
      }

      if (matchCat && matchSearch && matchSaved) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Sort visible cards in DOM
    const container = document.getElementById('agenciesList');
    if (container) {
      cards.sort((a, b) => {
        const scoreA = parseFloat(a.getAttribute('data-score') || '0');
        const scoreB = parseFloat(b.getAttribute('data-score') || '0');
        const revA = parseInt(a.getAttribute('data-reviews') || '0', 10);
        const revB = parseInt(b.getAttribute('data-reviews') || '0', 10);
        const verA = a.getAttribute('data-verified') === 'true' ? 1 : 0;
        const verB = b.getAttribute('data-verified') === 'true' ? 1 : 0;

        if (sortIndex === 1) return revB - revA;
        if (sortIndex === 2) return verB !== verA ? verB - verA : scoreB - scoreA;
        return scoreB - scoreA; // default: top rated
      });
      cards.forEach((c) => container.appendChild(c));
    }

    // Update Counter & Reset button
    const countEl = document.getElementById('visibleCount');
    if (countEl) countEl.textContent = visibleCount;

    const resetChip = document.getElementById('resetFilterChip');
    const isFiltered = currentCategory !== 'all' || cleanQ !== '' || currentTab === 'saved';
    if (resetChip) resetChip.classList.toggle('hidden', !isFiltered);

    // Empty state
    const emptyState = document.getElementById('emptyResultsState');
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
        const titleEl = document.getElementById('emptyTitle');
        const descEl = document.getElementById('emptyDesc');
        const lang = window.__LANG || 'en';
        if (currentTab === 'saved') {
          if (titleEl) titleEl.textContent = lang === 'ru' ? 'В избранном пока пусто' : 'No saved AI companies yet';
          if (descEl) descEl.textContent = lang === 'ru' ? 'Нажмите на сердечко в карточке компании, чтобы сохранить подрядчика.' : 'Tap the heart icon on any company card to bookmark agencies for your project.';
        } else {
          if (titleEl) titleEl.textContent = lang === 'ru' ? 'Подходящие ИИ-команды не найдены' : 'No matching AI integrators';
          if (descEl) descEl.textContent = lang === 'ru' ? 'Попробуйте изменить поисковый запрос или сбросить фильтры направлений.' : 'Try searching another technology tag (e.g. #OpenAI, #Python) or reset active filters.';
        }
      } else {
        emptyState.classList.add('hidden');
      }
    }
  };

  // Init initial category if specified in URL/props
  document.addEventListener('DOMContentLoaded', () => {
    const appEl = document.getElementById('directory-app');
    const initCat = appEl?.getAttribute('data-initial-cat') || 'all';
    if (initCat && initCat !== 'all') {
      currentCategory = initCat;
      updatePillStyles();
      window.applyDirectoryFilters();
    }
  });
</script>
