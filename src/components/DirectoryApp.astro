---
import type { Agency, Category, Lang } from '../lib/data';
import { getPlatformStats, extractCountry } from '../lib/stats';
import { FLAG_SVGS, getFlagSvg, splitBudget } from '../lib/flags';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  agencies: Agency[];
  categories: Category[];
  lang: Lang;
  initialCategory?: string;
  isCategoryPage?: boolean;
}

const { agencies, categories, lang, initialCategory = 'all' } = Astro.props;

const stats = getPlatformStats();
const PAGE_SIZE = 20;

// Brandmark styling generator
const brandmarkStyles = [
  'bg-gradient-to-br from-[#66b8fb]/15 to-[#6336ed]/20 text-[#4f35e3] border-[#d8d5fb]',
  'bg-gradient-to-br from-[#8d67ff]/15 to-[#293280]/20 text-[#6336ed] border-[#e2ddfc]',
  'bg-gradient-to-br from-[#2dd4bf]/20 to-[#6366f1]/20 text-[#2563eb] border-[#cce5ff]',
  'bg-gradient-to-br from-[#f59e0b]/15 to-[#d97706]/20 text-[#b45309] border-[#fed7aa]',
  'bg-gradient-to-br from-[#10b981]/15 to-[#059669]/20 text-[#047857] border-[#a7f3d0]',
];

// Sort alphabetically or by verifiedDate so there is no misleading artificial "score" ranking
const sortedAgencies = [...agencies].sort((a, b) => a.name.localeCompare(b.name));
const totalPages = Math.max(1, Math.ceil(sortedAgencies.length / PAGE_SIZE));

// Pre-render client data JSON for instant interactive search & filter
const agenciesClientData = sortedAgencies.map((a) => {
  const cInfo = extractCountry(a);
  return {
    id: a.id,
    name: a.name,
    description: a.description[lang],
    categories: a.categories,
    categoryNames: a.categories.map((cId) => categories.find((c) => c.id === cId)?.title[lang] || cId),
    entityType: a.entityType || 'integrator',
    entityLabel: a.entityType === 'platform'
      ? (lang === 'ru' ? 'Платформа' : 'AI Platform')
      : (lang === 'ru' ? 'Интегратор' : 'Integrator'),
    region: a.region || 'global',
    countryCode: cInfo.code,
    country: cInfo.name[lang],
    countryEn: cInfo.name.en,
    budget: a.minProjectBudget[lang],
    techStack: a.techStack,
    verifiedDate: a.verifiedDate,
    profileUrl: `/${lang}/agency/${a.id}/`,
    website: a.website,
    verified: a.status === 'verified',
  };
});

const integratorPct = stats.companiesCount > 0
  ? Math.round((stats.integratorsCount / stats.companiesCount) * 100)
  : 50;
const platformPct = 100 - integratorPct;
---

<div id="top-index-app" class="w-full">
  <!-- ============================================================ -->
  <!-- HERO SECTION (100% Real Database Metrics)                    -->
  <!-- ============================================================ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-inner">
        <!-- Hero Text -->
        <div class="hero-text">
          <span class="eyebrow">
            ✦ {lang === 'ru' ? 'НЕЗАВИСИМЫЙ B2B-КАТАЛОГ ИИ' : 'INDEPENDENT B2B AI DIRECTORY'} ✦
          </span>
          <h1>
            {lang === 'ru' ? (
              <>Международный каталог <span class="gradient-text">Top Index</span></>
            ) : (
              <>The Global AI <span class="gradient-text">Top Index</span></>
            )}
          </h1>
          <p class="hero-lead">
            {lang === 'ru'
              ? 'Структурированный реестр ИИ-интеграторов, студий разработки агентов и корпоративных AI-платформ — с проверкой доменов, стека технологий и открытой методологией.'
              : 'A structured directory of AI implementation agencies, agent developers, and enterprise AI platforms — with verified domains, tech stacks, and transparent classification.'}
          </p>
          <div class="hero-ctas flex-wrap">
            <a class="cta" href="#rankings">
              <svg class="icon"><use href="#i-building"/></svg>
              <span>{lang === 'ru' ? 'Найти AI-компании →' : 'Find AI Companies →'}</span>
            </a>
            <button
              type="button"
              class="cta secondary cursor-pointer"
              onclick="if(typeof window.openSubmitAiModal==='function'){window.openSubmitAiModal();}else{window.location.href=`/${lang}/submit/`;}"
            >
              <span>+</span>
              <span>{lang === 'ru' ? 'Добавить компанию' : 'Get Listed'}</span>
            </button>
          </div>
        </div>

        <!-- Hero 3D Globe Art -->
        <div class="hero-art" aria-hidden="true">
          <div class="globe">
            <div class="continent">🌍</div>
          </div>
          <div class="orbit"></div>
          <div class="orbit o2"></div>
          <div class="spark s1"></div>
          <div class="spark s2"></div>
          <div class="spark s3"></div>
          <div class="spark s4"></div>
        </div>

        <!-- Hero 4 Real Stats Counters from DB -->
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-building"/></svg></span>
            <span>
              <strong data-stat="companies">{stats.companiesCount}</strong>
              <small>{lang === 'ru' ? 'Компаний в каталоге' : 'Verified Organizations'}</small>
            </span>
          </div>
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-layers"/></svg></span>
            <span>
              <strong data-stat="integrators">{stats.integratorsCount} / {stats.platformsCount}</strong>
              <small>{lang === 'ru' ? 'Интеграторы / Платформы' : 'Integrators / Platforms'}</small>
            </span>
          </div>
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-globe"/></svg></span>
            <span>
              <strong data-stat="countries">{stats.countriesCount}</strong>
              <small>{lang === 'ru' ? 'Подтверждённых стран' : 'Confirmed Countries'}</small>
            </span>
          </div>
          <div class="hero-stat">
            <span class="stat-icon"><svg class="icon"><use href="#i-spark"/></svg></span>
            <span>
              <strong data-stat="categories">{stats.categoriesCount}</strong>
              <small>{lang === 'ru' ? 'Отраслевых вертикалей' : 'AI Verticals'}</small>
            </span>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- SEARCH & FILTER BAR                                          -->
      <!-- ============================================================ -->
      <div class="search-area">
        <form class="searchbar" id="search-form" onsubmit="event.preventDefault(); window.applyAppFilters(); document.getElementById('rankings')?.scrollIntoView({behavior:'smooth'});">
          <svg class="icon"><use href="#i-search"/></svg>
          <input
            id="search"
            type="text"
            placeholder={lang === 'ru' ? 'Поиск компании, страны или стека' : 'Search company, country or stack'}
            aria-label={lang === 'ru' ? 'Поиск компаний' : 'Search companies'}
            autocomplete="off"
            oninput="window.applyAppFilters()"
          />
          <button class="cta" type="submit">
            {lang === 'ru' ? 'Найти' : 'Search'}
          </button>
        </form>

        <!-- Filter Row with Icon Chips -->
        <div class="filter-row">
          <span class="filter-title">
            <svg class="icon" style="width:15px"><use href="#i-filter"/></svg>
            <span>{lang === 'ru' ? 'Фильтры' : 'Filters'}</span>
          </span>

          <!-- Country Filter (Populated dynamically from real DB) -->
          <label class="filter-chip">
            <span id="region-filter-flag" class="shrink-0 inline-flex items-center" set:html={getFlagSvg('GLOBAL')} />
            <select id="region-filter" aria-label={lang === 'ru' ? 'Страна' : 'Country'} onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Страна: Все' : 'Country: All'}</option>
              {stats.countryBreakdown.map((c) => (
                <option value={c.code}>
                  {c.name[lang]} ({c.count})
                </option>
              ))}
            </select>
          </label>

          <!-- Category Filter -->
          <label class="filter-chip">
            <span class="shrink-0">◈</span>
            <select id="category-filter" aria-label={lang === 'ru' ? 'Категория' : 'Category'} onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Категория: Все' : 'Category: All'}</option>
              {categories.map((c) => (
                <option value={c.id} selected={initialCategory === c.id}>
                  {c.title[lang]}
                </option>
              ))}
            </select>
          </label>

          <!-- Company Type Filter -->
          <label class="filter-chip">
            <span class="shrink-0">🏢</span>
            <select id="industry-filter" aria-label={lang === 'ru' ? 'Тип компании' : 'Company Type'} onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Тип: Все' : 'Type: All'}</option>
              <option value="integrator">{lang === 'ru' ? 'B2B Интегратор / Агентство' : 'B2B Integrator / Agency'}</option>
              <option value="platform">{lang === 'ru' ? 'Enterprise AI-Платформа' : 'Enterprise AI Platform'}</option>
            </select>
          </label>

          <!-- Technology Stack Filter -->
          <label class="filter-chip">
            <span class="shrink-0">⌘</span>
            <select id="expertise-filter" aria-label={lang === 'ru' ? 'Технология' : 'Technology'} onchange="window.applyAppFilters()">
              <option value="">{lang === 'ru' ? 'Стек: Любой' : 'Stack: All'}</option>
              <option value="openai">OpenAI / GPT</option>
              <option value="rag">RAG / Vector DB</option>
              <option value="voice">Voice AI / Vapi / Retell</option>
              <option value="n8n">n8n / Make</option>
              <option value="langchain">LangChain / LangGraph</option>
              <option value="python">Python / PyTorch</option>
              <option value="anthropic">Anthropic Claude</option>
            </select>
          </label>

          <!-- Sort Order (Neutral, no fake scores) -->
          <label class="filter-chip">
            <span class="shrink-0">⇅</span>
            <select id="sort-filter" aria-label={lang === 'ru' ? 'Сортировка' : 'Sort'} onchange="window.applyAppFilters()">
              <option value="alpha">{lang === 'ru' ? 'Сортировка: По алфавиту (A–Z)' : 'Sort: Alphabetical (A–Z)'}</option>
              <option value="recent">{lang === 'ru' ? 'Сортировка: Недавно проверенные' : 'Sort: Recently Audited'}</option>
            </select>
          </label>

          <!-- Reset Filter Button -->
          <button type="button" class="clear" id="reset-filters-btn" onclick="window.resetAllFilters()">
            {lang === 'ru' ? 'Сбросить всё' : 'Clear All'}
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- MAIN CONTENT: DIRECTORY & GLOBAL LANDSCAPE                   -->
  <!-- ============================================================ -->
  <div class="wrap content">
    <section class="dashboard" id="rankings">
      <!-- Left Column: Verified Directory List -->
      <div>
        <div class="section-head">
          <div class="heading-title">
            <svg class="icon heading-icon"><use href="#i-building"/></svg>
            <div>
              <h2>{lang === 'ru' ? 'Каталог проверенных ИИ-организаций' : 'Verified AI Directory'}</h2>
              <p>
                {lang === 'ru'
                  ? `Показано организаций: `
                  : `Showing organizations: `}
                <strong id="filtered-count" class="text-[#17172c]">{sortedAgencies.length}</strong>
                {lang === 'ru' ? ` из ${stats.companiesCount} (сортировка по алфавиту, без накрученных баллов)` : ` of ${stats.companiesCount} (neutral sorting, zero artificial scores)`}
              </p>
            </div>
          </div>
          <a class="more" href={`/${lang}/methodology/`}>
            {lang === 'ru' ? 'О статусах проверки →' : 'About Verification →'}
          </a>
        </div>

        <div class="card rank-card overflow-hidden">
          <!-- Table Header (Clean grid without numbering) -->
          <div class="hidden md:grid grid-cols-[minmax(215px,1.6fr)_minmax(150px,1.05fr)_minmax(122px,0.8fr)_minmax(122px,0.85fr)_20px] items-center gap-3 bg-[#f5f6fa] text-[#49506c] font-extrabold text-[10.5px] uppercase tracking-wider px-4 py-3 -mx-3 border-b border-[#e9eaf3]">
            <span>{lang === 'ru' ? 'Организация и стек' : 'Organization & Stack'}</span>
            <span>{lang === 'ru' ? 'Тип и направления' : 'Type & Categories'}</span>
            <span>{lang === 'ru' ? 'Бюджет от' : 'Min Budget'}</span>
            <span>{lang === 'ru' ? 'Страна' : 'Country'}</span>
            <span></span>
          </div>

          <!-- Company List Container -->
          <div id="company-list" class="divide-y divide-[#eff0f6]">
            {sortedAgencies.slice(0, PAGE_SIZE).map((agency, idx) => {
              const cInfo = extractCountry(agency);
              const budgetParts = splitBudget(agency.minProjectBudget[lang]);
              const gradClass = brandmarkStyles[idx % brandmarkStyles.length];
              const primaryCategories = agency.categories.slice(0, 2).map((cId) => categories.find((c) => c.id === cId)?.title[lang] || cId);
              const stackTags = agency.techStack.slice(0, 3);
              const entityLabel = agency.entityType === 'platform'
                ? (lang === 'ru' ? 'Платформа' : 'Platform')
                : (lang === 'ru' ? 'Интегратор' : 'Integrator');

              return (
                <div
                  class="grid grid-cols-[1fr_auto] md:grid-cols-[minmax(215px,1.6fr)_minmax(150px,1.05fr)_minmax(122px,0.8fr)_minmax(122px,0.85fr)_20px] items-center gap-3 py-3.5 px-2 hover:bg-[#fafbfe] transition-colors cursor-pointer"
                  onclick={`window.location.href='/${lang}/agency/${agency.id}/'`}
                  data-agency-row={agency.id}
                >
                  <div class="flex items-start gap-3 min-w-0">
                    <div class={`w-9 h-9 rounded-lg ${gradClass} border flex items-center justify-center shrink-0 font-bold text-sm mt-0.5`}>
                      {agency.name.charAt(0).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 min-w-0">
                        <a href={`/${lang}/agency/${agency.id}/`} class="font-bold text-[15px] md:text-[13.5px] text-[#17172c] hover:text-[#6336ed] truncate">
                          {agency.name}
                        </a>
                        <span
                          class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#e8f2ff] text-[#147dff] shrink-0"
                          title={lang === 'ru' ? 'Домен подтверждён' : 'Verified domain'}
                          aria-label={lang === 'ru' ? 'Домен подтверждён' : 'Verified domain'}
                        >
                          <svg class="w-2.5 h-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.77a1 1 0 1 1 1.42-1.41l3.04 3.06 6.54-6.59a1 1 0 0 1 1.414-.004Z" clip-rule="evenodd" />
                          </svg>
                        </span>
                      </div>
                      <p class="text-[14px] md:text-[12px] leading-[1.42] text-[#59617e] line-clamp-2 mt-1">
                        {agency.description[lang]}
                      </p>
                      {stackTags.length > 0 && (
                        <div class="flex flex-wrap items-center gap-1 mt-1.5">
                          {stackTags.map((tag) => (
                            <span class="text-[10.5px] font-medium px-1.5 py-0.5 rounded bg-[#f4f3ff] text-[#5836c7] border border-[#e6e2ff]">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                      <!-- Mobile compact metadata -->
                      <div class="flex flex-wrap items-center gap-2 mt-2 md:hidden">
                        <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-[#f5f6fa] border border-[#e5e7f3] text-[#49506c]">
                          {entityLabel}
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[11.5px] text-[#59617e]">
                          <Fragment set:html={getFlagSvg(cInfo.code)} />
                          <span>{cInfo.name[lang]}</span>
                        </span>
                        <span class="text-[11.5px] font-semibold text-[#17172c]">{budgetParts.main}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Desktop Classification & Categories (with strict non-overlapping wrap) -->
                  <div class="hidden md:flex flex-wrap items-center gap-1 min-w-0">
                    <span class="inline-block px-1.5 py-0.5 rounded bg-[#f5f6fa] border border-[#dfe1ee] text-[#49506c] text-[10px] font-bold">
                      {entityLabel}
                    </span>
                    {primaryCategories.map((t) => (
                      <span class="tag max-w-[140px] truncate">{t}</span>
                    ))}
                  </div>

                  <!-- Budget (Two-line format, zero truncation) -->
                  <div class="hidden md:flex flex-col leading-snug">
                    <span class="text-[12px] font-bold text-[#17172c] whitespace-nowrap">{budgetParts.main}</span>
                    {budgetParts.note && (
                      <span class="text-[10.5px] text-[#6b728e] font-normal mt-0.5 leading-tight">{budgetParts.note}</span>
                    )}
                  </div>

                  <!-- Country (Crisp vector SVG flag) -->
                  <div class="hidden md:flex items-center gap-2 text-[12px] text-[#4b5570] min-w-0">
                    <Fragment set:html={getFlagSvg(cInfo.code)} />
                    <span class="truncate">{cInfo.name[lang]}</span>
                  </div>

                  <div class="text-[#6f7692] text-sm font-bold text-right">›</div>
                </div>
              );
            })}
          </div>

          <!-- Pagination Bar (20 per page) -->
          {sortedAgencies.length > PAGE_SIZE && (
            <div id="pagination-bar" class="py-3.5 px-2 border-t border-[#eff0f6] flex flex-wrap items-center justify-between gap-3">
              <span id="pagination-summary" class="text-[11.5px] text-[#59617e]">
                {lang === 'ru'
                  ? `Показано 1–${Math.min(PAGE_SIZE, sortedAgencies.length)} из ${sortedAgencies.length}`
                  : `Showing 1–${Math.min(PAGE_SIZE, sortedAgencies.length)} of ${sortedAgencies.length}`}
              </span>
              <div id="pagination-controls" class="flex items-center gap-1.5">
                <button
                  type="button"
                  disabled
                  class="px-2.5 py-1.5 rounded-lg border border-[#e5e7f3] text-[11.5px] font-semibold text-[#9aa0b8] cursor-not-allowed"
                >
                  ←
                </button>
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                  <button
                    type="button"
                    onclick={`window.goToPage(${p})`}
                    class={`min-w-[32px] h-[30px] px-2 rounded-lg text-[11.5px] font-bold transition-colors cursor-pointer ${
                      p === 1
                        ? 'page-btn-active bg-[#6336ed] text-white border border-[#6336ed] shadow-sm'
                        : 'bg-white text-[#394464] border border-[#e5e7f3] hover:border-[#8d67ff] hover:text-[#6336ed]'
                    }`}
                  >
                    {p}
                  </button>
                ))}
                <button
                  type="button"
                  onclick="window.goToPage(2)"
                  class="px-2.5 py-1.5 rounded-lg border border-[#e5e7f3] bg-white text-[11.5px] font-semibold text-[#394464] hover:border-[#8d67ff] hover:text-[#6336ed] cursor-pointer"
                >
                  →
                </button>
              </div>
            </div>
          )}

          <!-- Empty state -->
          <div id="emptyState" class="hidden py-10 text-center text-[#59617e] text-xs">
            {lang === 'ru'
              ? 'Компании по заданным критериям не найдены. Попробуйте сбросить фильтры.'
              : 'No companies match these filters. Try clearing some filters.'}
          </div>
        </div>

        <p class="demo-note">
          {lang === 'ru'
            ? 'Примечание: Компании отсортированы нейтрально по алфавиту. Подтверждён статус официального домена; балльная система Trust Score находится на этапе утверждения методологии.'
            : 'Note: Organizations are listed in neutral alphabetical order. Official domains are verified; formal Trust Score weighting is pending methodology approval.'}
        </p>
      </div>

      <!-- Right Column: Sticky Sidebar (Directory Geography + Quick Inquiry CTA) -->
      <div class="sticky-sidebar">
        <aside class="card landscape flex flex-col justify-between">
          <div>
            <div class="land-head">
              <div>
                <strong class="inline-flex items-center gap-1.5">
                  <svg class="icon w-4 h-4 text-[#6336ed]" aria-hidden="true"><use href="#i-globe"/></svg>
                  <span>{lang === 'ru' ? 'География каталога' : 'Directory Geography'}</span>
                </strong>
                <small>{lang === 'ru' ? 'Реальное распределение опубликованных компаний по странам.' : 'Real geographic distribution of listed organizations.'}</small>
              </div>
            </div>

            <div class="tabs mb-3 flex-wrap" aria-label="Filter by region">
              <button class="active" data-tab="all" onclick="window.filterByRegionTab('all', this)">
                {lang === 'ru' ? 'Все' : 'All'} ({stats.companiesCount})
              </button>
              <button data-tab="usa-eu" onclick="window.filterByRegionTab('usa-eu', this)">
                US & EU ({stats.regionBreakdown['usa-eu']})
              </button>
              <button data-tab="cis-mena" onclick="window.filterByRegionTab('cis-mena', this)">
                CIS/MENA ({stats.regionBreakdown['cis-mena']})
              </button>
              <button data-tab="global" onclick="window.filterByRegionTab('global', this)">
                Global ({stats.regionBreakdown.global})
              </button>
            </div>

            <!-- Stylized World Map -->
            <div class="map-area mb-3" id="world-map">
              <svg class="world-svg" viewBox="0 0 330 165" aria-label="World map showing regions with listed AI companies">
                <defs>
                  <pattern id="dots" width="4" height="4" patternUnits="userSpaceOnUse">
                    <circle cx="1" cy="1" r="1" fill="#9da8ee" opacity=".72"/>
                  </pattern>
                  <radialGradient id="hot">
                    <stop stop-color="#9766ff" stop-opacity=".8"/>
                    <stop offset="1" stop-color="#9766ff" stop-opacity="0"/>
                  </radialGradient>
                </defs>
                <g fill="url(#dots)" stroke="#ccd1f9" stroke-width=".5">
                  <path d="M18 41 34 24 70 17 95 31 115 29 128 47 112 54 104 77 92 85 77 75 60 90 50 73 38 70 30 56 15 53Z"/>
                  <path d="M86 87 114 92 132 109 126 127 117 144 106 156 98 145 90 124 77 108Z"/>
                  <path d="M141 29 161 20 178 26 192 22 218 30 241 22 274 32 306 49 317 66 298 77 283 70 260 83 242 73 223 79 204 67 187 79 172 64 150 64 142 49Z"/>
                  <path d="M154 78 189 73 208 92 199 121 181 149 169 140 161 117 148 101Z"/>
                  <path d="M265 105 289 101 318 117 308 140 278 137 260 122Z"/>
                  <path d="M120 12 132 8 146 14 140 26 129 29Z"/>
                </g>
                <g fill="url(#hot)">
                  <circle cx="88" cy="47" r="24"/>
                  <circle cx="160" cy="52" r="19"/>
                  <circle cx="210" cy="45" r="20"/>
                  <circle cx="286" cy="122" r="10"/>
                </g>
                <g class="map-hot">
                  <circle cx="88" cy="47" r="3"/>
                  <circle cx="160" cy="52" r="3"/>
                  <circle cx="210" cy="45" r="3"/>
                  <circle cx="286" cy="122" r="3"/>
                </g>
              </svg>
            </div>

            <!-- Real Country Breakdown List (Clickable to filter) -->
            <div class="space-y-1.5 border-t border-[#eff0f7] pt-3">
              <div class="text-[10px] font-extrabold uppercase tracking-wider text-[#49506c] mb-2">
