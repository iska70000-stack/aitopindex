                </div>
                <h3 class="text-sm font-bold text-[#17172c] group-hover:text-[#6336ed] transition-colors leading-snug">
                  {c.title[lang]}
                </h3>
                <p class="text-[11.5px] text-[#59617e] leading-relaxed mt-1.5 line-clamp-2">
                  {c.short[lang]}
                </p>
              </div>
              <div class="mt-3 pt-2.5 border-t border-[#f0f2fa] flex items-center justify-between text-[11px] font-semibold text-[#6336ed]">
                <span>{lang === 'ru' ? 'Перейти в категорию' : 'Explore category'}</span>
                <span>→</span>
              </div>
            </a>
          );
        })}
      </div>
