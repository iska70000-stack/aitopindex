---
import { FILTERS, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
  targetContainerId?: string;
}

const { lang, targetContainerId = 'agencies-grid' } = Astro.props;

const entityTypes = [
  { key: 'all', label: lang === 'ru' ? 'Все типы' : 'All Types' },
  { key: 'integrator', label: lang === 'ru' ? 'Интеграторы / Студии' : 'B2B Integrators' },
  { key: 'platform', label: lang === 'ru' ? 'ИИ-Платформы' : 'AI Platforms' },
];

const regions = [
  { key: 'all', label: lang === 'ru' ? 'Все регионы' : 'All Regions' },
  { key: 'usa-eu', label: lang === 'ru' ? 'США и Европа' : 'USA & Europe' },
  { key: 'cis-mena', label: lang === 'ru' ? 'СНГ и MENA' : 'CIS / Russia / MENA' },
  { key: 'global', label: lang === 'ru' ? 'Глобальный рынок' : 'Global Enterprise' },
];
---

<div class="w-full my-6 glass glow-border p-4 sm:p-5 rounded-2xl" data-filter-bar data-target={targetContainerId}>
  <!-- Header: Title and Reset Button -->
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-white/5 pb-3">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs uppercase tracking-wider text-slate-300 font-semibold">
        {lang === 'ru' ? 'Фильтры каталога' : 'Directory Filters'}:
      </span>
      <span class="font-mono text-xs text-cyan-glow font-bold" data-filter-count></span>
    </div>
    <button
      type="button"
      class="hidden font-mono text-xs text-slate-400 hover:text-white underline self-start sm:self-auto cursor-pointer transition"
      data-filter-reset
    >
      {lang === 'ru' ? 'Сбросить все фильтры' : 'Reset all filters'}
    </button>
  </div>

  <div class="mt-4 flex flex-col gap-3.5">
    <!-- Filter Row 1: Entity Type -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-[11px] uppercase tracking-wider text-slate-400 w-24 shrink-0">
        {lang === 'ru' ? 'Тип:' : 'Type:'}
      </span>
      <div class="flex flex-wrap gap-1.5">
        {entityTypes.map((t) => (
          <button
            type="button"
            class="pill cursor-pointer text-xs"
            data-filter-type={t.key}
            aria-pressed={t.key === 'all' ? 'true' : 'false'}
          >
            <span>{t.label}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Filter Row 2: Region -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-[11px] uppercase tracking-wider text-slate-400 w-24 shrink-0">
        {lang === 'ru' ? 'Регион:' : 'Region:'}
      </span>
      <div class="flex flex-wrap gap-1.5">
        {regions.map((r) => (
          <button
            type="button"
            class="pill cursor-pointer text-xs"
            data-filter-region={r.key}
            aria-pressed={r.key === 'all' ? 'true' : 'false'}
          >
            <span>{r.label}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Filter Row 3: Tech Stack -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-[11px] uppercase tracking-wider text-slate-400 w-24 shrink-0">
        {lang === 'ru' ? 'Стек:' : 'Stack:'}
      </span>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          class="pill cursor-pointer text-xs"
          data-filter-stack="all"
          aria-pressed="true"
        >
          <span>{lang === 'ru' ? 'Все технологии' : 'All Tech'}</span>
        </button>
        {FILTERS.map((f) => (
          <button
            type="button"
            class="pill cursor-pointer text-xs"
            data-filter-stack={f.key}
            aria-pressed="false"
          >
            <span>{f.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function setupFilters() {
    const bars = document.querySelectorAll<HTMLElement>('[data-filter-bar]');
    bars.forEach((bar) => {
      const targetId = bar.dataset.target || 'agencies-grid';
      const container = document.getElementById(targetId);
      if (!container) return;

      const cards = container.querySelectorAll<HTMLElement>('[data-agency-card]');
      const typePills = bar.querySelectorAll<HTMLButtonElement>('[data-filter-type]');
      const regionPills = bar.querySelectorAll<HTMLButtonElement>('[data-filter-region]');
      const stackPills = bar.querySelectorAll<HTMLButtonElement>('[data-filter-stack]');
      const countEl = bar.querySelector<HTMLElement>('[data-filter-count]');
      const resetBtn = bar.querySelector<HTMLButtonElement>('[data-filter-reset]');

      let currentType = 'all';
      let currentRegion = 'all';
      let currentStack = 'all';

      function applyFilters() {
        let visible = 0;

        typePills.forEach((p) => {
          p.setAttribute('aria-pressed', p.dataset.filterType === currentType ? 'true' : 'false');
        });
        regionPills.forEach((p) => {
          p.setAttribute('aria-pressed', p.dataset.filterRegion === currentRegion ? 'true' : 'false');
        });
        stackPills.forEach((p) => {
          p.setAttribute('aria-pressed', p.dataset.filterStack === currentStack ? 'true' : 'false');
        });

        cards.forEach((card) => {
          const cardType = card.dataset.entityType || '';
          const cardRegion = card.dataset.region || '';
          const cardFilters = (card.dataset.filters || '').split(' ');

          const matchType = currentType === 'all' || cardType === currentType;
          const matchRegion = currentRegion === 'all' || cardRegion === currentRegion;
          const matchStack = currentStack === 'all' || cardFilters.includes(currentStack);

          if (matchType && matchRegion && matchStack) {
            card.style.display = '';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countEl) {
          countEl.textContent = `(${visible}/${cards.length})`;
        }
        if (resetBtn) {
          const isFiltered = currentType !== 'all' || currentRegion !== 'all' || currentStack !== 'all';
          resetBtn.classList.toggle('hidden', !isFiltered);
        }
      }

      typePills.forEach((p) => {
        p.addEventListener('click', () => {
          currentType = p.dataset.filterType || 'all';
          applyFilters();
        });
      });

      regionPills.forEach((p) => {
        p.addEventListener('click', () => {
          currentRegion = p.dataset.filterRegion || 'all';
          applyFilters();
        });
      });

      stackPills.forEach((p) => {
        p.addEventListener('click', () => {
          currentStack = p.dataset.filterStack || 'all';
          applyFilters();
        });
      });

      resetBtn?.addEventListener('click', () => {
        currentType = 'all';
        currentRegion = 'all';
        currentStack = 'all';
        applyFilters();
      });

      // Initial count
      if (countEl) {
        countEl.textContent = `(${cards.length}/${cards.length})`;
      }
    });
  }

  // Run on first load and client navigation
  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>
