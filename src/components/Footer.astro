---
import { BRAND, categories, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <!-- Col 1: Brand & Description -->
      <div>
        <a class="logo" href={`/${lang}/`} aria-label="Top Index home">
          <span class="logo-symbol"></span>
          <span>Top Index<sup style="font-size:7px;align-self:flex-start;margin-top:3px">™</sup></span>
        </a>
        <p class="footer-desc">
          {lang === 'ru'
            ? 'Глобальный независимый рейтинг и каталог ведущих ИИ-компаний, интеграторов и архитекторов решений.'
            : 'The independent global ranking directory and benchmark of verified AI companies, integrators, and specialists.'}
        </p>
      </div>

      <!-- Col 2: Explore -->
      <div>
        <h4>{lang === 'ru' ? 'Навигация' : 'Explore'}</h4>
        <a href={`/${lang}/#rankings`}>{lang === 'ru' ? 'Рейтинг компаний' : 'Rankings'}</a>
        <a href={`/${lang}/#specialists`}>{lang === 'ru' ? 'ИИ-Специалисты' : 'Specialists'}</a>
        <a href={`/${lang}/#categories-section`}>{lang === 'ru' ? 'Сферы внедрения' : 'Categories'}</a>
        <a href={`/${lang}/methodology/`}>{lang === 'ru' ? 'Методология аудита' : 'Methodology'}</a>
      </div>

      <!-- Col 3: Categories -->
      <div>
        <h4>{lang === 'ru' ? 'Категории ИИ' : 'Categories'}</h4>
        {categories.slice(0, 5).map((cat) => (
          <a href={`/${lang}/${cat.slug[lang]}/`}>
            {cat.title[lang]}
          </a>
        ))}
      </div>

      <!-- Col 4: Resources & AI Crawlers -->
      <div>
        <h4>{lang === 'ru' ? 'Ресурсы и AI' : 'Resources & AI'}</h4>
        <a href={`/${lang}/#insights`}>{lang === 'ru' ? 'Аналитика и тренды' : 'Insights & Trends'}</a>
        <a href={`/${lang}/about/`}>{lang === 'ru' ? 'О платформе' : 'About Platform'}</a>
        <a href="/llms.txt" target="_blank">/llms.txt (LLM Summary)</a>
        <a href="/llms-full.txt" target="_blank">/llms-full.txt (Full)</a>
        <a href="/sitemap.xml" target="_blank">/sitemap.xml</a>
      </div>

      <!-- Col 5: Newsletter / Subscription -->
      <div>
        <h4>{lang === 'ru' ? 'Будьте в курсе' : 'Stay in the Loop'}</h4>
        <p class="footer-desc" style="margin-top:0">
          {lang === 'ru'
            ? 'Еженедельный дайджест трендов и новых проверенных подрядчиков.'
            : 'Updates and verified benchmark reports from the global AI ecosystem.'}
        </p>
        <form id="subscribe-form" onsubmit="event.preventDefault(); alert(window.__LANG === 'ru' ? 'Спасибо за подписку!' : 'Thank you for subscribing!');">
          <input
            type="email"
            placeholder={lang === 'ru' ? 'Ваш рабочий email' : 'Email address'}
            required
            aria-label="Email address"
          />
          <button type="submit" class="cta">
            {lang === 'ru' ? 'ОК' : 'Join'}
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="bottom">
      <span>© 2024–2026 Top Index Research. Global AI Ranking Platform. All rights reserved.</span>
      <div class="flex items-center gap-4">
        <a href={`/${lang}/privacy/`} class="hover:underline">{lang === 'ru' ? 'Конфиденциальность' : 'Privacy'}</a>
        <a href={`/${lang}/terms/`} class="hover:underline">{lang === 'ru' ? 'Условия' : 'Terms'}</a>
        <span class="text-[#8186a0]">v3.2</span>
      </div>
    </div>
  </div>
</footer>
