---
import { categories, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
  alternatePaths?: { en: string; ru: string };
}

const { lang, alternatePaths } = Astro.props;
const enPath = alternatePaths?.en || '/en/';
const ruPath = alternatePaths?.ru || '/ru/';
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <!-- Col 1: Brand & Description -->
      <div>
        <a class="logo" href={`/${lang}/`} aria-label="Top Index home">
          <span class="logo-symbol"></span>
          <span>Top Index<sup style="font-size:7px;align-self:flex-start;margin-top:3px">™</sup></span>
        </a>
        <p class="footer-desc">
          {lang === 'ru'
            ? 'Глобальный независимый рейтинг и каталог ведущих ИИ-компаний, интеграторов и архитекторов решений.'
            : 'The independent global ranking directory and benchmark of verified AI companies, integrators, and specialists.'}
        </p>
      </div>

      <!-- Col 2: Explore -->
      <div>
        <h4>{lang === 'ru' ? 'Навигация' : 'Explore'}</h4>
        <a href={`/${lang}/#rankings`}>{lang === 'ru' ? 'Каталог компаний' : 'Directory'}</a>
        <a href={`/${lang}/#specialists`}>{lang === 'ru' ? 'ИИ-Специалисты' : 'Specialists'}</a>
        <a href={`/${lang}/#categories-section`}>{lang === 'ru' ? 'Сферы внедрения' : 'Categories'}</a>
        <a href={`/${lang}/methodology/`}>{lang === 'ru' ? 'Методология аудита' : 'Methodology'}</a>
      </div>

      <!-- Col 3: Categories -->
      <div>
        <h4>{lang === 'ru' ? 'Категории ИИ' : 'Categories'}</h4>
        {categories.slice(0, 5).map((cat) => (
          <a href={`/${lang}/${cat.slug[lang]}/`}>
            {cat.title[lang]}
          </a>
        ))}
      </div>

      <!-- Col 4: Resources & AI Crawlers -->
      <div>
        <h4>{lang === 'ru' ? 'Ресурсы и AI' : 'Resources & AI'}</h4>
        <a href={`/${lang}/#insights`}>{lang === 'ru' ? 'Аналитика и тренды' : 'Insights & Trends'}</a>
        <a href={`/${lang}/about/`}>{lang === 'ru' ? 'О платформе' : 'About Platform'}</a>
        <a href="/llms.txt" target="_blank">/llms.txt (LLM Summary)</a>
        <a href="/llms-full.txt" target="_blank">/llms-full.txt (Full)</a>
        <a href="/sitemap.xml" target="_blank">/sitemap.xml</a>
      </div>

      <!-- Col 5: Editorial & Directory Submissions -->
      <div>
        <h4>{lang === 'ru' ? 'Редакция и заявки' : 'Editorial & Submissions'}</h4>
        <p class="footer-desc" style="margin-top:0">
          {lang === 'ru'
            ? 'Подайте заявку на добавление компании или обновление сведений.'
            : 'Submit an AI organization for domain verification or request a profile update.'}
        </p>
        <div class="flex flex-col gap-2.5 mt-2">
          <a href={`/${lang}/submit/`} class="cta text-xs py-2 px-3 justify-center">
            {lang === 'ru' ? 'Подать заявку →' : 'Submit Organization →'}
          </a>
          <div class="flex items-center gap-1.5">
            <a
              href="mailto:hello@aitopindex.com"
              class="!inline !m-0 text-[12px] font-mono text-[#6336ed] hover:underline truncate"
            >
              hello@aitopindex.com
            </a>
            <button
              type="button"
              onclick={`navigator.clipboard?.writeText('hello@aitopindex.com').then(()=>window.showToast&&window.showToast('${lang === 'ru' ? 'Скопировано' : 'Copied'}')).catch(()=>{})`}
              class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-[#f5f6fa] hover:bg-[#f0edff] border border-[#e2e7f3] hover:border-[#ded6ff] text-[#59617e] hover:text-[#6336ed] transition-colors shrink-0 cursor-pointer"
              title={lang === 'ru' ? 'Копировать email' : 'Copy email'}
              aria-label={lang === 'ru' ? 'Копировать hello@aitopindex.com' : 'Copy hello@aitopindex.com'}
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
          </div>
          <button
            type="button"
            onclick="if(typeof window.openContactUsModal==='function'){window.openContactUsModal();}"
            class="inline-flex items-center justify-center gap-1.5 text-[12px] font-semibold text-[#17172c] hover:text-[#6336ed] bg-[#f8f9fe] hover:bg-[#f0edff] border border-[#dfe1ee] hover:border-[#ded6ff] rounded-lg px-3 py-1.5 transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-[#6336ed] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>{lang === 'ru' ? 'Обратная связь' : 'Contact Us'}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar + Language Switcher -->
    <div class="bottom flex-wrap gap-3">
      <span>© 2024-2026 Top Index Research.</span>
      <div class="flex flex-wrap items-center gap-4">
        <div class="inline-flex items-center gap-1" role="group" aria-label={lang === 'ru' ? 'Выбор языка' : 'Language switcher'}>
          <a
            href={enPath}
            class={`!inline !m-0 px-1.5 py-0.5 rounded text-[11.5px] font-semibold transition-colors ${lang === 'en' ? 'text-[#6336ed] font-bold bg-[#f0edff] border border-[#ded6ff]' : 'text-[#59617e] hover:text-[#17172c]'}`}
          >
            EN
          </a>
          <span class="text-[#cbd1e2] select-none">|</span>
          <a
            href={ruPath}
            class={`!inline !m-0 px-1.5 py-0.5 rounded text-[11.5px] font-semibold transition-colors ${lang === 'ru' ? 'text-[#6336ed] font-bold bg-[#f0edff] border border-[#ded6ff]' : 'text-[#59617e] hover:text-[#17172c]'}`}
          >
            RU
          </a>
        </div>
        <a href={`/${lang}/privacy/`} class="hover:underline !inline !m-0">{lang === 'ru' ? 'Конфиденциальность' : 'Privacy'}</a>
        <a href={`/${lang}/terms/`} class="hover:underline !inline !m-0">{lang === 'ru' ? 'Условия' : 'Terms'}</a>
      </div>
    </div>
  </div>
</footer>
