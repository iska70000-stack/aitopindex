---
import { BRAND, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
  currentPath?: string;
}

const { lang, currentPath = `/${lang}/` } = Astro.props;

// Determine switch link
let targetPath = '/en/';
if (lang === 'en') {
  targetPath = currentPath.startsWith('/en/')
    ? currentPath.replace(/^\/en\//, '/ru/')
    : currentPath === '/en' ? '/ru/' : '/ru/';
} else {
  targetPath = currentPath.startsWith('/ru/')
    ? currentPath.replace(/^\/ru\//, '/en/')
    : currentPath === '/ru' ? '/en/' : '/en/';
}

const navLinks = [
  { href: `/${lang}/#categories`, label: lang === 'ru' ? 'Категории' : 'Categories' },
  { href: `/${lang}/#calculator`, label: lang === 'ru' ? 'Калькулятор ROI' : 'ROI Calculator' },
  { href: `/${lang}/methodology/`, label: lang === 'ru' ? 'Методология' : 'Methodology' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-obsidian/80 backdrop-blur-xl transition-all">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href={`/${lang}/`} class="group flex items-center gap-2.5 transition">
      <div class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-cyan-glow/40 bg-white/[0.05] shadow-[0_0_15px_-3px_rgba(0,240,255,0.4)] transition-all group-hover:scale-105 group-hover:border-cyan-glow group-hover:shadow-[0_0_25px_-2px_rgba(0,240,255,0.7)]">
        <span class="font-mono text-base font-bold text-cyan-glow">AI</span>
      </div>
      <div class="flex flex-col">
        <span class="text-base font-extrabold tracking-tight text-white group-hover:text-cyan-glow transition">
          {BRAND}<span class="text-cyan-glow">.</span>
        </span>
        <span class="font-mono text-[9px] uppercase tracking-widest text-slate-400">
          Global B2B Index
        </span>
      </div>
    </a>

    <!-- Nav Items -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-white transition">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right Controls: Submit CTA + Lang Switcher -->
    <div class="flex items-center gap-3">
      <!-- Language Switcher Pill -->
      <a
        href={targetPath}
        class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.04] px-2.5 py-1.5 font-mono text-xs text-slate-300 hover:border-cyan-glow/50 hover:text-white transition"
        title={lang === 'ru' ? 'Switch to English' : 'Переключить на русский'}
      >
        <span class={lang === 'en' ? 'text-cyan-glow font-bold' : 'text-slate-400'}>EN</span>
        <span class="text-slate-600">/</span>
        <span class={lang === 'ru' ? 'text-cyan-glow font-bold' : 'text-slate-400'}>RU</span>
      </a>

      <!-- Submit Agency CTA Button -->
      <a
        href={`/${lang}/submit/`}
        class="btn-primary text-xs py-2 px-3.5 sm:text-sm sm:py-2 sm:px-4"
      >
        <span>+ {lang === 'ru' ? 'Добавить агентство' : 'Submit Agency'}</span>
      </a>
    </div>
  </div>
</header>
