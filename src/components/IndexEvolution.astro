---
import type { Lang } from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const timeline = [
  {
    year: '2024',
    version: 'v1.0',
    title: {
      en: 'Internal B2B AI Vendor Tracking',
      ru: 'Внутренний мониторинг B2B-вендоров ИИ',
    },
    badge: {
      en: 'Closed Pilot • 25 Teams',
      ru: 'Закрытый пилот • 25 команд',
    },
    desc: {
      en: 'Initiated as an internal procurement registry tracking early GPT-4 API wrappers, Zapier/Make automations, and custom Python chatbot pilots across 25 initial contractors.',
      ru: 'Запуск закрытого корпоративного реестра для отслеживания первых интеграций GPT-4, сценариев на Zapier/Make и заказных чат-ботов на Python среди 25 подрядчиков.',
    },
    accent: 'border-slate-500/40 text-slate-400',
    dotBg: 'bg-slate-400',
  },
  {
    year: '2025',
    version: 'v2.0',
    title: {
      en: 'Enterprise RAG & Voice Agent Benchmarks',
      ru: 'Бенчмарки корпоративных RAG и голосовых роботов',
    },
    badge: {
      en: 'Research Benchmark • 60+ Teams',
      ru: 'Исследовательский пул • 60+ команд',
    },
    desc: {
      en: 'Scaled evaluations to 60+ agencies. Introduced strict latency auditing for real-time speech agents (<500ms) and enterprise vector retrieval precision benchmarks across hybrid databases.',
      ru: 'Расширение базы до 60+ команд. Внедрение независимых замеров задержки голосовых агентов (<500 мс) и бенчмарков точности векторного поиска для юридических и корпоративных баз знаний.',
    },
    accent: 'border-violet-500/40 text-violet-300',
    dotBg: 'bg-violet-400',
  },
  {
    year: '2026',
    version: 'v3.0',
    title: {
      en: 'Open Global GEO Directory & Live Verification Engine',
      ru: 'Открытый глобальный GEO-каталог и движок живой верификации',
    },
    badge: {
      en: 'Production Standard • 86+ Providers',
      ru: 'Отраслевой стандарт • 86+ провайдеров',
    },
    desc: {
      en: 'Public launch of the AITopIndex open standard. 86+ verified providers across 9 verticals, automated 72-hour domain freshness monitoring, direct /llms.txt AI ingestion, and transparent ROI benchmarks.',
      ru: 'Публичный релиз открытого стандарта AITopIndex: 86+ аккредитованных команд в 9 вертикалях, автоматический аудит доменов каждые 72 часа, прямой доступ для нейросетей через /llms.txt.',
    },
    accent: 'border-cyan-glow/40 text-cyan-glow',
    dotBg: 'bg-cyan-glow shadow-[0_0_12px_#00F0FF]',
  },
];

const benchmarks = [
  {
    metric: {
      en: 'Average AI SDR / Sales Bot Setup',
      ru: 'Базовая стоимость внедрения ИИ-SDR',
    },
    y2024: '$15,000–$25,000',
    y2024Note: { en: 'Custom code, fragile wrappers', ru: 'Кастомный Python, хрупкие API' },
    y2025: '$6,000–$12,000',
    y2025Note: { en: 'Pre-built agent frameworks', ru: 'Фреймворки n8n/Make' },
    y2026: '$2,000–$5,000',
    y2026Note: { en: 'Turnkey autonomous workflows', ru: 'Автономные готовые агенты' },
  },
  {
    metric: {
      en: 'Deployment Time to Production',
      ru: 'Срок вывода в боевую эксплуатацию',
    },
    y2024: '8–14 weeks',
    y2024Note: { en: 'Lengthy custom development', ru: 'Длительная заказная разработка' },
    y2025: '4–6 weeks',
    y2025Note: { en: 'Modular workflow templates', ru: 'Модульные сценарии и коннекторы' },
    y2026: '1–2 weeks',
    y2026Note: { en: 'Rapid agent onboarding', ru: 'Быстрый запуск под ключ' },
  },
  {
    metric: {
      en: 'Voice Agent Response Latency',
      ru: 'Задержка ответа голосового ИИ-агента',
    },
    y2024: '1,800–2,500 ms',
    y2024Note: { en: 'Noticeable dialogue pauses', ru: 'Заметные неестественные паузы' },
    y2025: '800–1,200 ms',
    y2025Note: { en: 'Acceptable for call centers', ru: 'Приемлемо для колл-центров' },
    y2026: '350–550 ms',
    y2026Note: { en: 'Instant human-grade dialogue', ru: 'Мгновенная естественная речь' },
  },
  {
    metric: {
      en: 'Average Client Payback Horizon (ROI)',
      ru: 'Средний срок окупаемости (ROI)',
    },
    y2024: '6–9 months',
    y2024Note: { en: 'High setup overhead', ru: 'Высокие первоначальные затраты' },
    y2025: '3–5 months',
    y2025Note: { en: 'Moderate unit economics', ru: 'Оптимизация стоимости токенов' },
    y2026: '1–3 months',
    y2026Note: { en: 'Immediate operational savings', ru: 'Быстрое замещение рутины' },
  },
];
---

<section class="py-10 border-t border-b border-white/10 my-10 space-y-12">
  <!-- Section Title -->
  <div class="text-center max-w-2xl mx-auto space-y-2">
    <div class="inline-flex items-center gap-2 rounded-full border border-cyan-glow/30 bg-cyan-glow/5 px-3 py-1 font-mono text-[11px] text-cyan-glow">
      <span>{lang === 'ru' ? 'История индекса • 2024–2026' : 'Index History • 2024–2026'}</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
      {lang === 'ru' ? 'Эволюция AITopIndex и рынка внедрения ИИ' : 'Index Evolution Timeline & Market Trajectory'}
    </h2>
    <p class="text-xs sm:text-sm text-slate-300">
      {lang === 'ru'
        ? 'От закрытого реестра закупок до открытого глобального стандарта независимой B2B-верификации.'
        : 'From an internal enterprise procurement benchmark to the global open verification standard.'}
    </p>
  </div>

  <!-- Timeline Cards (3 Years) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
    {timeline.map((item, i) => (
      <div class="glass p-6 rounded-2xl border border-white/10 relative flex flex-col justify-between">
        <div>
          <!-- Top Row: Year, Version, Dot -->
          <div class="flex items-center justify-between pb-4 border-b border-white/5">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xl font-extrabold text-white">{item.year}</span>
              <span class={`font-mono text-xs font-bold px-2 py-0.5 rounded-md border ${item.accent} bg-white/[0.02]`}>
                {item.version}
              </span>
            </div>
            <div class={`h-3 w-3 rounded-full ${item.dotBg}`}></div>
          </div>

          <!-- Title -->
          <h3 class="text-base font-bold text-white mt-4 leading-snug">
            {item.title[lang]}
          </h3>

          <div class="mt-2 text-[11px] font-mono text-slate-400">
            {item.badge[lang]}
          </div>

          <!-- Description -->
          <p class="mt-3 text-xs leading-relaxed text-slate-300">
            {item.desc[lang]}
          </p>
        </div>

        <div class="mt-6 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-400">
          <span>{lang === 'ru' ? 'Фаза развития' : 'Phase'} #{i + 1}</span>
          <span class="text-emerald-400">{i === 2 ? (lang === 'ru' ? 'Текущий стандарт' : 'Active Standard') : (lang === 'ru' ? 'Архив' : 'Archived')}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Historical Cost & ROI Payback Comparison Table (2024 vs 2025 vs 2026) -->
  <div class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
      <div>
        <h3 class="text-lg font-bold text-white">
          {lang === 'ru' ? 'Динамика стоимости и окупаемости ИИ-агентов (2024 vs 2025 vs 2026)' : 'Historical Cost & ROI Payback Comparison (2024 vs 2025 vs 2026)'}
        </h3>
        <p class="text-xs text-slate-400">
          {lang === 'ru'
            ? 'Аналитические данные AITopIndex Research на основе аудита реальных клиентских внедрений.'
            : 'Aggregated industry telemetry compiled by AITopIndex Research across audited enterprise contracts.'}
        </p>
      </div>
      <span class="font-mono text-[11px] text-cyan-glow">
        {lang === 'ru' ? 'Ежегодный аудит рынка' : 'Annual Market Audit'}
      </span>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-white/10 glass">
      <table class="w-full text-left text-xs">
        <thead class="border-b border-white/10 bg-white/[0.04] font-mono text-[11px] text-slate-300">
          <tr>
            <th class="py-3.5 px-4 font-semibold">{lang === 'ru' ? 'Метрика внедрения' : 'Implementation Metric'}</th>
            <th class="py-3.5 px-4 font-semibold text-slate-400">2024 (v1.0)</th>
            <th class="py-3.5 px-4 font-semibold text-violet-300">2025 (v2.0)</th>
            <th class="py-3.5 px-4 font-semibold text-cyan-glow">2026 (v3.0 Current)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {benchmarks.map((row) => (
            <tr class="hover:bg-white/[0.02] transition">
              <td class="py-3 px-4 font-medium text-white max-w-xs">
                {row.metric[lang]}
              </td>
              <td class="py-3 px-4 font-mono text-slate-300">
                <span class="block font-semibold">{row.y2024}</span>
                <span class="text-[10px] text-slate-500">{row.y2024Note[lang]}</span>
              </td>
              <td class="py-3 px-4 font-mono text-violet-200">
                <span class="block font-semibold">{row.y2025}</span>
                <span class="text-[10px] text-slate-400">{row.y2025Note[lang]}</span>
              </td>
              <td class="py-3 px-4 font-mono text-emerald-400">
                <span class="block font-bold">{row.y2026}</span>
                <span class="text-[10px] text-cyan-300">{row.y2026Note[lang]}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
