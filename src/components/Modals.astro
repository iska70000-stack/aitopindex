---
import { agencies, agencyPath, categories, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Pass clean minimal agency data for modals
const agenciesModalData = agencies.map((a) => ({
  id: a.id,
  name: a.name,
  website: a.website,
  status: a.status,
  hq: a.hq[lang],
  budget: a.minProjectBudget[lang],
  roi: a.avgRoiTime[lang],
  description: a.description[lang],
  agents: a.deployedAgents[lang],
  stack: a.techStack,
  profileUrl: agencyPath(lang, a.id),
}));

const categoriesModalData = categories.map((c) => ({
  id: c.id,
  title: c.title[lang],
  slug: c.slug[lang],
}));
---

<!-- Modal Backdrop & Animated Bottom Sheet -->
<div
  id="modalBackdrop"
  class="hidden fixed inset-0 z-50 bg-[#17172c]/60 backdrop-blur-[4px] items-end sm:items-center justify-center p-0 sm:p-4"
  onclick="closeModal(event)"
>
  <div
    id="modalSheet"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    class="w-full max-w-[480px] bg-white border border-[#e5e7f3] rounded-t-2xl sm:rounded-2xl p-5 pb-8 sm:pb-6 max-h-[88vh] overflow-y-auto shadow-2xl animate-sheet text-[#17172c]"
  >
    <!-- Content injected dynamically -->
  </div>
</div>

<!-- Floating Toast Notification -->
<div
  id="toastNotification"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 translate-y-3 opacity-0 pointer-events-none transition-all duration-200 z-50 bg-[#17172c] border border-[#8d67ff]/40 text-white text-[12px] font-semibold px-4 py-2 rounded-full shadow-[0_8px_24px_rgba(41,50,99,0.3)] whitespace-nowrap flex items-center gap-2"
>
  <span class="w-1.5 h-1.5 rounded-full bg-[#8d67ff] animate-pulse"></span>
  <span id="toastText">Notification</span>
</div>

<script is:inline define:vars={{ agenciesModalData, categoriesModalData, lang }}>
  window.__AGENCIES = agenciesModalData;
  window.__CATEGORIES = categoriesModalData;
  window.__LANG = lang;

  const I18N = {
    en: {
      contactTitle: 'Verified Contact Channels',
      contactSub: 'Official domain & verification channel',
      copyBtn: 'Copy',
      copiedToast: 'Copied to clipboard',
      casesTitle: 'Verified AI Implementation Cases',
      impactLabel: 'Business Payback & Budget',
      agentsLabel: 'Deployed Autonomous Agents',
      stackLabel: 'Tech Stack',
      fullProfileBtn: 'View Complete Agency Profile &rarr;',
      savedAdded: 'Saved to bookmarks',
      savedRemoved: 'Removed from bookmarks',
    },
    ru: {
      contactTitle: 'Официальные контакты компании',
      contactSub: 'Прямой домен и канал подтверждения аккредитации',
      copyBtn: 'Копировать',
      copiedToast: 'Скопировано в буфер обмена',
      casesTitle: 'Кейсы внедрения ИИ и метрики',
      impactLabel: 'Срок окупаемости и бюджет',
      agentsLabel: 'Внедряемые автономные ИИ-агенты',
      stackLabel: 'Технологический стек',
      fullProfileBtn: 'Подробный аудит компании &rarr;',
      savedAdded: 'Сохранено в избранное',
      savedRemoved: 'Удалено из избранного',
    }
  };

  const t = I18N[window.__LANG] || I18N.en;

  // Toast
  let toastTimer = null;
  window.showToast = function(msg) {
    const toast = document.getElementById('toastNotification');
    const text = document.getElementById('toastText');
    if (!toast || !text) return;
    text.textContent = msg;
    toast.classList.remove('opacity-0', 'translate-y-3');
    toast.classList.add('opacity-100', 'translate-y-0');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-3');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2400);
  };

  window.copyText = function(text) {
    navigator.clipboard.writeText(text).then(() => {
      showToast(`${t.copiedToast}: ${text}`);
    }).catch(() => {
      showToast(`${t.copiedToast}`);
    });
  };

  // Modal open/close
  let modalTrigger;
  window.openModal = function(html) {
    const backdrop = document.getElementById('modalBackdrop');
    const sheet = document.getElementById('modalSheet');
    if (!backdrop || !sheet) return;
    if (backdrop.classList.contains('hidden')) modalTrigger = document.activeElement;
    sheet.innerHTML = html;
    const heading = sheet.querySelector('h3');
    if (heading) {
      heading.id = 'modal-heading';
      sheet.setAttribute('aria-labelledby', heading.id);
    }
    backdrop.classList.remove('hidden');
    backdrop.classList.add('flex');
    document.body.style.overflow = 'hidden';
    sheet.focus();
  };

  window.closeModal = function(e) {
    if (!e || e.target.id === 'modalBackdrop') {
      const backdrop = document.getElementById('modalBackdrop');
      if (backdrop) {
        backdrop.classList.add('hidden');
        backdrop.classList.remove('flex');
      }
      document.body.style.overflow = '';
      modalTrigger?.focus();
    }
  };

  document.getElementById('modalSheet')?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      window.closeModal();
      return;
    }
    if (event.key !== 'Tab') return;
    const sheet = event.currentTarget;
    const controls = [...sheet.querySelectorAll('a[href], button, input, select, textarea')]
      .filter((field) => field.tabIndex >= 0 && !field.disabled && field.getClientRects().length);
    const first = controls[0];
    const last = controls.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && (document.activeElement === first || document.activeElement === sheet)) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  // Open Contact Modal
  window.openContactModal = function(agencyId) {
    const agency = window.__AGENCIES.find((a) => a.id === agencyId);
    if (!agency) return;

    const domain = agency.website.replace(/^https?:\/\//, '').replace(/\/$/, '');
    const cleanWeb = agency.website.startsWith('http') ? agency.website : `https://${agency.website}`;

    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#e5e7f3] pb-3">
        <div>
          <div class="flex items-center gap-1.5">
            <h3 class="text-[16px] font-bold text-[#17172c]">${agency.name}</h3>
            <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#e8f2ff] text-[#147dff] shrink-0" title="${window.__LANG === 'ru' ? 'Домен подтверждён' : 'Verified domain'}">
              <svg class="w-2.5 h-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.77a1 1 0 1 1 1.42-1.41l3.04 3.06 6.54-6.59a1 1 0 0 1 1.414-.004Z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
          <p class="text-[12px] text-[#59617e] mt-0.5">${t.contactSub}</p>
        </div>
        <button type="button" onclick="closeModal()" class="w-8 h-8 rounded-full bg-[#f5f6fa] border border-[#e5e7f3] text-[#59617e] hover:text-[#17172c] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <div class="space-y-2.5">
        <div class="bg-[#f8f9fe] border border-[#e2e7f3] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-semibold text-[#59617e]">Official Domain</div>
            <a href="${cleanWeb}" target="_blank" rel="noopener noreferrer" class="text-[13.5px] font-bold text-[#6336ed] hover:underline truncate block">
              ${domain}
            </a>
          </div>
          <button
            type="button"
            onclick="copyText('${domain}')"
            class="shrink-0 px-3 py-1.5 rounded-lg bg-white border border-[#ded6ff] text-[11.5px] font-bold text-[#6336ed] hover:bg-[#f0edff] transition-colors cursor-pointer"
          >
            ${t.copyBtn}
          </button>
        </div>

        <div class="bg-[#f8f9fe] border border-[#e2e7f3] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-semibold text-[#59617e]">Headquarters</div>
            <div class="text-[13px] font-medium text-[#17172c] truncate">${agency.hq}</div>
          </div>
          <span class="text-[11px] font-mono font-bold text-[#009e54] bg-[#e6f7ef] px-2 py-0.5 rounded border border-[#a7e8c6]">Verified</span>
        </div>

        <div class="bg-[#f8f9fe] border border-[#e2e7f3] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-semibold text-[#59617e]">Directory Inquiry</div>
            <a href="mailto:hello@aitopindex.com?subject=Inquiry%20regarding%20${encodeURIComponent(agency.name)}" class="text-[13px] font-medium text-[#17172c] hover:text-[#6336ed]">
              hello@aitopindex.com
            </a>
          </div>
          <a
            href="mailto:hello@aitopindex.com?subject=Inquiry%20regarding%20${encodeURIComponent(agency.name)}"
            class="shrink-0 px-3 py-1.5 rounded-lg bg-white border border-[#ded6ff] text-[11.5px] font-bold text-[#6336ed] hover:bg-[#f0edff] transition-colors"
          >
            Email
          </a>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-[#e5e7f3] flex items-center justify-between">
        <a href="${agency.profileUrl}" class="text-[12px] text-[#6336ed] hover:underline font-bold">
          ${t.fullProfileBtn}
        </a>
        <a
          href="${cleanWeb}"
          target="_blank"
          rel="noopener noreferrer"
          class="cta text-xs py-2 px-4"
        >
          <span>Open Site &rarr;</span>
        </a>
      </div>
    `);
  };

  // Open Find an AI Partner Modal (Client B2B Leads -> POST /api/leads)
  window.openFindPartnerModal = function() {
    const isRu = window.__LANG === 'ru';
    const cats = window.__CATEGORIES || [];
    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#e5e7f3] pb-3">
        <div>
          <h3 class="text-[16px] font-bold text-[#17172c]">${isRu ? 'Подобрать ИИ-подрядчика' : 'Find an AI Partner'}</h3>
          <p class="text-[12px] text-[#59617e] mt-0.5">${isRu ? 'Опишите задачу — мы вручную подберём проверенных исполнителей' : 'Describe your project — our team manually matches verified partners'}</p>
        </div>
        <button type="button" onclick="closeModal()" aria-label="Close" class="w-8 h-8 rounded-full bg-[#f5f6fa] border border-[#e5e7f3] text-[#59617e] hover:text-[#17172c] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <form id="modal-lead-form" onsubmit="window.handleLeadForm(event)" class="space-y-3">
        <input type="text" name="website_hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Ваша компания' : 'Company Name'} *</label>
            <input type="text" name="company_name" required placeholder="Acme Corp" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]" />
          </div>
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Контактное лицо' : 'Contact Name'} *</label>
            <input type="text" name="contact_name" required placeholder="Alex Smith" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Рабочий Email' : 'Work Email'} *</label>
            <input type="email" name="work_email" required placeholder="alex@company.com" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]" />
          </div>
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Страна' : 'Country'} *</label>
            <input type="text" name="country" required placeholder="United States" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Отрасль' : 'Industry'} *</label>
            <input type="text" name="industry" required placeholder="FinTech / Healthcare / Retail" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]" />
          </div>
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Требуемое решение ИИ' : 'Required AI Solution'} *</label>
            <select name="required_solution" required class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]">
              ${cats.map((c) => `<option value="${c.title}">${c.title}</option>`).join('')}
            </select>
          </div>
        </div>

        <div>
          <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Описание задачи' : 'Project Description'} *</label>
          <textarea name="project_description" required rows="2" placeholder="${isRu ? 'Опишите процесс, который нужно автоматизировать...' : 'Describe the workflow or AI solution you need...'}" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Ориентировочный бюджет' : 'Estimated Budget'} <span class="font-normal text-[#59617e]">(${isRu ? 'опц.' : 'optional'})</span></label>
            <input type="text" name="estimated_budget" placeholder="$10,000 - $25,000" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]" />
          </div>
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${isRu ? 'Желаемый старт' : 'Desired Start Date'} <span class="font-normal text-[#59617e]">(${isRu ? 'опц.' : 'optional'})</span></label>
            <input type="text" name="desired_start_date" placeholder="Q1 2027 / ASAP" class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]" />
          </div>
        </div>

        <label class="flex items-start gap-2 text-[11px] text-[#59617e] cursor-pointer">
          <input type="checkbox" name="consent_gdpr" required class="mt-0.5" />
          <span>${isRu ? 'Я согласен на обработку контактных данных для подбора ИИ-партнёров (контакты не передаются агентствам автоматически).' : 'I consent to data processing for partner matching (contacts are never shared automatically with agencies).'}</span>
        </label>

        <div id="lead-form-error" class="hidden rounded-lg bg-[#fef2f2] border border-[#fecaca] p-2.5 text-[11.5px] text-[#b91c1c]"></div>

        <button type="submit" id="modal-lead-btn" class="w-full cta py-2.5 text-sm font-bold justify-center">
          ${isRu ? 'Отправить запрос на подбор →' : 'Request AI Solution →'}
        </button>
      </form>
      <div id="modal-lead-ready" class="hidden space-y-3 text-center py-2"></div>
    `);
  };

  window.handleLeadForm = async function(e) {
    e.preventDefault();
    const form = e.target;
    const isRu = window.__LANG === 'ru';
    const errBox = document.getElementById('lead-form-error');
    const readyBox = document.getElementById('modal-lead-ready');
    const btn = document.getElementById('modal-lead-btn');

    const fd = new FormData(form);
    if (fd.get('website_hp')) return;

    const payload = {
      company_name: String(fd.get('company_name') || '').trim(),
      contact_name: String(fd.get('contact_name') || '').trim(),
      work_email: String(fd.get('work_email') || '').trim(),
      country: String(fd.get('country') || '').trim(),
      industry: String(fd.get('industry') || '').trim(),
      required_solution: String(fd.get('required_solution') || '').trim(),
      project_description: String(fd.get('project_description') || '').trim(),
      estimated_budget: String(fd.get('estimated_budget') || '').trim(),
      desired_start_date: String(fd.get('desired_start_date') || '').trim(),
      consent_gdpr: fd.get('consent_gdpr') === 'on',
      lang: window.__LANG || 'en',
      website_hp: '',
    };

    if (errBox) errBox.classList.add('hidden');
    if (btn) {
      btn.disabled = true;
      btn.textContent = isRu ? 'Отправка...' : 'Submitting...';
    }

    try {
      const resp = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        if (errBox) {
          errBox.textContent = data.error || (isRu ? 'Ошибка отправки. Проверьте поля.' : 'Submission failed. Please check fields.');
          errBox.classList.remove('hidden');
        }
        return;
      }

      form.classList.add('hidden');
      if (readyBox) {
        readyBox.innerHTML = `
          <div class="w-10 h-10 rounded-full bg-[#e6f7ef] text-[#009e54] flex items-center justify-center mx-auto text-lg font-bold">✓</div>
          <h4 class="text-sm font-bold text-[#17172c]">${data.message}</h4>
          <p class="text-xs text-[#59617e]">Lead ID: <strong>${data.lead_id}</strong></p>
          <button type="button" onclick="closeModal()" class="cta text-xs py-2 px-5 mt-2">${isRu ? 'Закрыть' : 'Close'}</button>
        `;
        readyBox.classList.remove('hidden');
      }
    } catch {
      if (errBox) {
        errBox.textContent = isRu
          ? 'Ошибка сети. Введенные данные сохранены — попробуйте снова.'
          : 'Network error reaching API. Your inputs are preserved — please retry.';
        errBox.classList.remove('hidden');
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = isRu ? 'Отправить запрос на подбор →' : 'Request AI Solution →';
      }
    }
  };

  // Open Contact Us Modal (Обратная связь -> POST /api/contact)
  window.openContactUsModal = function(profileName) {
    const isRu = window.__LANG === 'ru';
    const subjects = isRu
      ? [
          'Предложение о сотрудничестве',
          'Сообщить об ошибке на сайте',
          'Вопрос по размещению',
          'Другое',
        ]
      : [
          'Partnership inquiry',
          'Report a bug / issue',
          'Listing question',
          'Other',
        ];

    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#e5e7f3] pb-3">
        <div>
          <h3 class="text-[16px] font-bold text-[#17172c]">${isRu ? 'Обратная связь' : 'Contact Us'}</h3>
          <p class="text-[12px] text-[#59617e] mt-0.5">${isRu ? 'Напишите нам на hello@aitopindex.com' : 'Send a message to hello@aitopindex.com'}</p>
        </div>
        <button type="button" onclick="closeModal()" aria-label="Close" class="w-8 h-8 rounded-full bg-[#f5f6fa] border border-[#e5e7f3] text-[#59617e] hover:text-[#17172c] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <form id="modal-contact-us-form" onsubmit="window.handleContactUsForm(event)" class="space-y-3">
        <input type="text" name="website_hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0" />

        <div>
          <label class="block text-[12px] font-semibold text-[#17172c] mb-1">${isRu ? 'Ваш Email' : 'Your Email'} *</label>
          <input
            type="email"
            name="email"
            required
            placeholder="name@company.com"
            class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3.5 py-2.5 text-sm text-[#17172c] placeholder:text-[#59617e]/60 focus:outline-none focus:border-[#6336ed]"
          />
        </div>

        <div>
          <label class="block text-[12px] font-semibold text-[#17172c] mb-1">${isRu ? 'Тема обращения' : 'Subject'} *</label>
          <select
            name="subject"
            required
            class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2.5 text-sm text-[#17172c] focus:outline-none focus:border-[#6336ed]"
          >
            ${subjects.map((s) => `<option value="${s}">${s}</option>`).join('')}
          </select>
        </div>

        <div>
          <label class="block text-[12px] font-semibold text-[#17172c] mb-1">${isRu ? 'Сообщение' : 'Message'} *</label>
          <textarea
            name="message"
            required
            rows="4"
            minlength="5"
            maxlength="3000"
            placeholder="${isRu ? 'Опишите ваш вопрос или предложение...' : 'Write your question or inquiry...'}"
            class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3.5 py-2.5 text-sm text-[#17172c] placeholder:text-[#59617e]/60 focus:outline-none focus:border-[#6336ed]"
          ></textarea>
        </div>

        <div id="contact-us-error" class="hidden rounded-lg bg-[#fef2f2] border border-[#fecaca] p-2.5 text-[12px] text-[#b91c1c]"></div>

        <div class="pt-1">
          <button
            type="submit"
            id="modal-contact-us-btn"
            class="w-full cta py-2.5 text-sm font-bold justify-center"
          >
            ${isRu ? 'Отправить сообщение →' : 'Send Message →'}
          </button>
        </div>
      </form>
      <div id="modal-contact-us-ready" class="hidden space-y-3 text-center py-3"></div>
    `);
    if (profileName) {
      const form = document.getElementById('modal-contact-us-form');
      form.elements.namedItem('subject').value = subjects[2];
      form.elements.namedItem('message').value = isRu ? `Компания: ${profileName}\n\n` : `Company: ${profileName}\n\n`;
    }
  };

  window.handleContactUsForm = async function(e) {
    e.preventDefault();
    const form = e.target;
    const isRu = window.__LANG === 'ru';
    const errBox = document.getElementById('contact-us-error');
    const readyBox = document.getElementById('modal-contact-us-ready');
    const btn = document.getElementById('modal-contact-us-btn');

    const fd = new FormData(form);
    if (fd.get('website_hp')) return;

    const payload = {
      email: String(fd.get('email') || '').trim(),
      subject: String(fd.get('subject') || '').trim(),
      message: String(fd.get('message') || '').trim(),
      lang: window.__LANG || 'en',
      website_hp: '',
    };

    if (errBox) errBox.classList.add('hidden');
    if (btn) {
      btn.disabled = true;
      btn.textContent = isRu ? 'Отправка...' : 'Sending...';
    }

    try {
      const resp = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        if (errBox) {
          errBox.textContent = data.error || (isRu ? 'Не удалось отправить сообщение. Проверьте поля.' : 'Could not send message. Please check fields.');
          errBox.classList.remove('hidden');
        }
        return;
      }

      form.classList.add('hidden');
      if (readyBox) {
        readyBox.innerHTML = `
          <div class="w-10 h-10 rounded-full bg-[#e6f7ef] text-[#009e54] flex items-center justify-center mx-auto text-lg font-bold">✓</div>
          <h4 class="text-sm font-bold text-[#17172c]">${isRu ? 'Сообщение отправлено. Мы ответим в ближайшее время' : 'Message sent. We will get back to you shortly'}</h4>
          <p class="text-xs text-[#59617e]">ID: <strong>${data.message_id || ''}</strong></p>
          <button type="button" onclick="closeModal()" class="cta text-xs py-2 px-5 mt-2">${isRu ? 'Закрыть' : 'Close'}</button>
        `;
        readyBox.classList.remove('hidden');
      }
    } catch {
      if (errBox) {
        errBox.textContent = isRu
          ? 'Ошибка сети. Введённый текст сохранён — попробуйте ещё раз.'
          : 'Network error reaching API. Your message is preserved — please retry.';
        errBox.classList.remove('hidden');
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = isRu ? 'Отправить сообщение →' : 'Send Message →';
      }
    }
  };
</script>
