---
import { agencies, categories, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Pass clean minimal agency data for modals
const agenciesModalData = agencies.map((a) => ({
  id: a.id,
  name: a.name,
  website: a.website,
  status: a.status,
  score: a.score,
  hq: a.hq[lang],
  budget: a.minProjectBudget[lang],
  roi: a.avgRoiTime[lang],
  description: a.description[lang],
  agents: a.deployedAgents[lang],
  stack: a.techStack,
  profileUrl: `/${lang}/agency/${a.id}/`,
}));

const categoriesModalData = categories.map((c) => ({
  id: c.id,
  title: c.title[lang],
  slug: c.slug[lang],
}));
---

<!-- Modal Backdrop & Animated Bottom Sheet -->
<div
  id="modalBackdrop"
  class="hidden fixed inset-0 z-50 bg-[#17172c]/60 backdrop-blur-[4px] items-end sm:items-center justify-center p-0 sm:p-4"
  onclick="closeModal(event)"
>
  <div
    id="modalSheet"
    class="w-full max-w-[480px] bg-white border border-[#e5e7f3] rounded-t-2xl sm:rounded-2xl p-5 pb-8 sm:pb-6 max-h-[88vh] overflow-y-auto shadow-2xl animate-sheet text-[#17172c]"
  >
    <!-- Content injected dynamically -->
  </div>
</div>

<!-- Floating Toast Notification -->
<div
  id="toastNotification"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 translate-y-3 opacity-0 pointer-events-none transition-all duration-200 z-50 bg-[#17172c] border border-[#8d67ff]/40 text-white text-[12px] font-semibold px-4 py-2 rounded-full shadow-[0_8px_24px_rgba(41,50,99,0.3)] whitespace-nowrap flex items-center gap-2"
>
  <span class="w-1.5 h-1.5 rounded-full bg-[#8d67ff] animate-pulse"></span>
  <span id="toastText">Notification</span>
</div>

<script is:inline define:vars={{ agenciesModalData, categoriesModalData, lang }}>
  window.__AGENCIES = agenciesModalData;
  window.__CATEGORIES = categoriesModalData;
  window.__LANG = lang;

  const I18N = {
    en: {
      contactTitle: 'Verified Contact Channels',
      contactSub: 'Official domain & verification channel',
      copyBtn: 'Copy',
      copiedToast: 'Copied to clipboard',
      casesTitle: 'Verified AI Implementation Cases',
      impactLabel: 'Business Payback & Budget',
      agentsLabel: 'Deployed Autonomous Agents',
      stackLabel: 'Tech Stack',
      fullProfileBtn: 'View Complete Agency Profile &rarr;',
      submitTitle: 'Submit AI Organization to Index',
      submitName: 'Company / Agency Name',
      submitNamePh: 'e.g. Apex Neural Labs',
      submitCat: 'Primary AI Domain',
      submitSite: 'Website Domain',
      submitDesc: 'What do you implement? (1–2 sentences)',
      submitDescPh: 'e.g. Building enterprise voice SDRs and RAG pipelines for financial services.',
      submitTags: 'Tech Stack (comma-separated)',
      submitTagsPh: 'OpenAI, LangChain, Python, n8n',
      submitEmail: 'Official Work Email',
      submitEmailPh: 'partners@company.com',
      submitBtn: 'Submit to AI Top Index',
      submitSuccess: 'AI organization submitted for verification audit!',
      savedAdded: 'Saved to bookmarks',
      savedRemoved: 'Removed from bookmarks',
    },
    ru: {
      contactTitle: 'Официальные контакты компании',
      contactSub: 'Прямой домен и канал подтверждения аккредитации',
      copyBtn: 'Копировать',
      copiedToast: 'Скопировано в буфер обмена',
      casesTitle: 'Кейсы внедрения ИИ и метрики',
      impactLabel: 'Срок окупаемости и бюджет',
      agentsLabel: 'Внедряемые автономные ИИ-агенты',
      stackLabel: 'Технологический стек',
      fullProfileBtn: 'Подробный аудит компании &rarr;',
      submitTitle: 'Добавить компанию в рейтинг ИИ',
      submitName: 'Название компании / интегратора',
      submitNamePh: 'Например: Apex Neural Labs',
      submitCat: 'Основное направление ИИ',
      submitSite: 'Домен сайта',
      submitDesc: 'Что именно внедряете? (1–2 предложения)',
      submitDescPh: 'Например: Внедрение голосовых ИИ-агентов и RAG-баз знаний для корпораций.',
      submitTags: 'Стек технологий (через запятую)',
      submitTagsPh: 'OpenAI, LangChain, Python, n8n',
      submitEmail: 'Корпоративный Email',
      submitEmailPh: 'partners@company.com',
      submitBtn: 'Подать заявку в рейтинг',
      submitSuccess: 'Заявка отправлена на аудит аккредитации!',
      savedAdded: 'Сохранено в избранное',
      savedRemoved: 'Удалено из избранного',
    }
  };

  const t = I18N[window.__LANG] || I18N.en;

  // Toast
  let toastTimer = null;
  window.showToast = function(msg) {
    const toast = document.getElementById('toastNotification');
    const text = document.getElementById('toastText');
    if (!toast || !text) return;
    text.textContent = msg;
    toast.classList.remove('opacity-0', 'translate-y-3');
    toast.classList.add('opacity-100', 'translate-y-0');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-3');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2400);
  };

  window.copyText = function(text) {
    navigator.clipboard.writeText(text).then(() => {
      showToast(`${t.copiedToast}: ${text}`);
    }).catch(() => {
      showToast(`${t.copiedToast}`);
    });
  };

  // Modal open/close
  window.openModal = function(html) {
    const backdrop = document.getElementById('modalBackdrop');
    const sheet = document.getElementById('modalSheet');
    if (!backdrop || !sheet) return;
    sheet.innerHTML = html;
    backdrop.classList.remove('hidden');
    backdrop.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeModal = function(e) {
    if (!e || e.target.id === 'modalBackdrop') {
      const backdrop = document.getElementById('modalBackdrop');
      if (backdrop) {
        backdrop.classList.add('hidden');
        backdrop.classList.remove('flex');
      }
      document.body.style.overflow = '';
    }
  };

  // Open Contact Modal
  window.openContactModal = function(agencyId) {
    const agency = window.__AGENCIES.find((a) => a.id === agencyId);
    if (!agency) return;

    const domain = agency.website.replace(/^https?:\/\//, '').replace(/\/$/, '');
    const cleanWeb = agency.website.startsWith('http') ? agency.website : `https://${agency.website}`;

    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#e5e7f3] pb-3">
        <div>
          <div class="flex items-center gap-1.5">
            <h3 class="text-[16px] font-bold text-[#17172c]">${agency.name}</h3>
            <span class="text-[#147dff] text-sm">●</span>
          </div>
          <p class="text-[12px] text-[#59617e] mt-0.5">${t.contactSub}</p>
        </div>
        <button type="button" onclick="closeModal()" class="w-8 h-8 rounded-full bg-[#f5f6fa] border border-[#e5e7f3] text-[#59617e] hover:text-[#17172c] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <div class="space-y-2.5">
        <div class="bg-[#f8f9fe] border border-[#e2e7f3] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-semibold text-[#59617e]">Official Domain</div>
            <a href="${cleanWeb}" target="_blank" rel="noopener noreferrer" class="text-[13.5px] font-bold text-[#6336ed] hover:underline truncate block">
              ${domain}
            </a>
          </div>
          <button
            type="button"
            onclick="copyText('${domain}')"
            class="shrink-0 px-3 py-1.5 rounded-lg bg-white border border-[#ded6ff] text-[11.5px] font-bold text-[#6336ed] hover:bg-[#f0edff] transition-colors cursor-pointer"
          >
            ${t.copyBtn}
          </button>
        </div>

        <div class="bg-[#f8f9fe] border border-[#e2e7f3] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-semibold text-[#59617e]">Headquarters</div>
            <div class="text-[13px] font-medium text-[#17172c] truncate">${agency.hq}</div>
          </div>
          <span class="text-[11px] font-mono font-bold text-[#009e54] bg-[#e6f7ef] px-2 py-0.5 rounded border border-[#a7e8c6]">Verified</span>
        </div>

        <div class="bg-[#f8f9fe] border border-[#e2e7f3] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-semibold text-[#59617e]">Directory Inquiry</div>
            <a href="mailto:submit@aitopindex.com?subject=Inquiry%20regarding%20${encodeURIComponent(agency.name)}" class="text-[13px] font-medium text-[#17172c] hover:text-[#6336ed]">
              submit@aitopindex.com
            </a>
          </div>
          <a
            href="mailto:submit@aitopindex.com?subject=Inquiry%20regarding%20${encodeURIComponent(agency.name)}"
            class="shrink-0 px-3 py-1.5 rounded-lg bg-white border border-[#ded6ff] text-[11.5px] font-bold text-[#6336ed] hover:bg-[#f0edff] transition-colors"
          >
            Email
          </a>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-[#e5e7f3] flex items-center justify-between">
        <a href="${agency.profileUrl}" class="text-[12px] text-[#6336ed] hover:underline font-bold">
          ${t.fullProfileBtn}
        </a>
        <a
          href="${cleanWeb}"
          target="_blank"
          rel="noopener noreferrer"
          class="cta text-xs py-2 px-4"
        >
          <span>Open Site &rarr;</span>
        </a>
      </div>
    `);
  };

  // Open Submit AI Modal
  window.openSubmitAiModal = function() {
    const cats = window.__CATEGORIES;
    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#e5e7f3] pb-3">
        <div>
          <h3 class="text-[16px] font-bold text-[#17172c]">${t.submitTitle}</h3>
          <p class="text-[12px] text-[#59617e] mt-0.5">${window.__LANG === 'ru' ? 'Бесплатная верификация и включение в глобальный индекс' : 'Independent verification and directory listing'}</p>
        </div>
        <button type="button" onclick="closeModal()" class="w-8 h-8 rounded-full bg-[#f5f6fa] border border-[#e5e7f3] text-[#59617e] hover:text-[#17172c] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <form onsubmit="event.preventDefault(); showToast('${t.submitSuccess}'); closeModal();" class="space-y-3">
        <div>
          <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${t.submitName} *</label>
          <input
            type="text"
            required
            placeholder="${t.submitNamePh}"
            class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3.5 py-2 text-sm text-[#17172c] placeholder:text-[#59617e]/60 focus:outline-none focus:border-[#6336ed]"
          />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${t.submitCat} *</label>
            <select class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] focus:outline-none focus:border-[#6336ed]">
              ${cats.map((c) => `<option value="${c.id}">${c.title}</option>`).join('')}
            </select>
          </div>
          <div>
            <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${t.submitSite} *</label>
            <input
              type="text"
              required
              placeholder="company.com"
              class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3 py-2 text-xs text-[#17172c] placeholder:text-[#59617e]/60 focus:outline-none focus:border-[#6336ed]"
            />
          </div>
        </div>

        <div>
          <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${t.submitDesc} *</label>
          <textarea
            required
            rows="2"
            placeholder="${t.submitDescPh}"
            class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3.5 py-2 text-xs text-[#17172c] placeholder:text-[#59617e]/60 focus:outline-none focus:border-[#6336ed]"
          ></textarea>
        </div>

        <div>
          <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${t.submitTags} *</label>
          <input
            type="text"
            required
            placeholder="${t.submitTagsPh}"
            class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3.5 py-2 text-xs text-[#17172c] placeholder:text-[#59617e]/60 focus:outline-none focus:border-[#6336ed]"
          />
        </div>

        <div>
          <label class="block text-[11.5px] font-semibold text-[#17172c] mb-1">${t.submitEmail} *</label>
          <input
            type="email"
            required
            placeholder="${t.submitEmailPh}"
            class="w-full rounded-xl bg-white border border-[#dfe1ee] px-3.5 py-2 text-xs text-[#17172c] placeholder:text-[#59617e]/60 focus:outline-none focus:border-[#6336ed]"
          />
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="w-full cta py-2.5 text-sm font-bold justify-center"
          >
            ${t.submitBtn} &rarr;
          </button>
        </div>
      </form>
    `);
  };
</script>
