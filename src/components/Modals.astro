---
import { agencies, categories, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Pass clean minimal agency data for modals
const agenciesModalData = agencies.map((a) => ({
  id: a.id,
  name: a.name,
  website: a.website,
  status: a.status,
  score: a.score,
  hq: a.hq[lang],
  budget: a.minProjectBudget[lang],
  roi: a.avgRoiTime[lang],
  description: a.description[lang],
  agents: a.deployedAgents[lang],
  stack: a.techStack,
  profileUrl: `/${lang}/agency/${a.id}/`,
}));

const categoriesModalData = categories.map((c) => ({
  id: c.id,
  title: c.title[lang],
  slug: c.slug[lang],
}));
---

<!-- Modal Backdrop & Animated Bottom Sheet -->
<div
  id="modalBackdrop"
  class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-[4px] items-end sm:items-center justify-center p-0 sm:p-4"
>
  <div
    id="modalSheet"
    class="w-full max-w-[480px] bg-[#11161D] border-t sm:border border-[#1E2631] rounded-t-2xl sm:rounded-2xl p-5 pb-8 sm:pb-6 max-h-[88vh] overflow-y-auto shadow-2xl animate-sheet"
  >
    <!-- Content injected dynamically -->
  </div>
</div>

<!-- Floating Toast Notification -->
<div
  id="toastNotification"
  class="fixed bottom-[74px] sm:bottom-6 left-1/2 -translate-x-1/2 translate-y-3 opacity-0 pointer-events-none transition-all duration-200 z-50 bg-[#171E27] border border-[#2DD4BF]/50 text-[#F3F6FA] text-[12px] font-medium px-4 py-2 rounded-full shadow-[0_8px_24px_rgba(0,0,0,0.7)] whitespace-nowrap flex items-center gap-2"
>
  <span class="w-1.5 h-1.5 rounded-full bg-[#2DD4BF] animate-pulse"></span>
  <span id="toastText">Notification</span>
</div>

<script is:inline define:vars={{ agenciesModalData, categoriesModalData, lang }}>
  window.__AGENCIES = agenciesModalData;
  window.__CATEGORIES = categoriesModalData;
  window.__LANG = lang;

  const I18N = {
    en: {
      contactTitle: 'Verified Contact Channels',
      contactSub: 'Official domain & direct verification channel',
      copyBtn: 'Copy',
      copiedToast: 'Copied to clipboard',
      casesTitle: 'Verified AI Implementation Cases',
      impactLabel: 'Business Payback & Budget',
      agentsLabel: 'Deployed Autonomous Agents',
      stackLabel: 'Tech Stack',
      fullProfileBtn: 'View Complete Agency Profile &rarr;',
      submitTitle: 'Submit AI Agency to Index',
      submitName: 'Company / Agency Name',
      submitNamePh: 'e.g. Apex Neural Labs',
      submitCat: 'Primary AI Domain',
      submitSite: 'Website Domain',
      submitDesc: 'What do you implement? (1–2 sentences)',
      submitDescPh: 'e.g. Building enterprise voice SDRs and RAG pipelines for financial services.',
      submitTags: 'Tech Stack (comma-separated)',
      submitTagsPh: 'OpenAI, LangChain, Python, n8n',
      submitEmail: 'Official Work Email',
      submitEmailPh: 'partners@company.com',
      submitBtn: 'Submit to AI Top Index',
      submitSuccess: 'AI company submitted for verification audit!',
      savedAdded: 'Saved to bookmarks',
      savedRemoved: 'Removed from bookmarks',
      emptySavedTitle: 'No saved AI companies yet',
      emptySavedDesc: 'Tap the heart icon on any company card to save agencies for your project.',
      allTags: 'All Technologies',
    },
    ru: {
      contactTitle: 'Официальные контакты компании',
      contactSub: 'Прямой домен и канал подтверждения аккредитации',
      copyBtn: 'Копировать',
      copiedToast: 'Скопировано в буфер обмена',
      casesTitle: 'Кейсы внедрения ИИ и метрики',
      impactLabel: 'Срок окупаемости и бюджет',
      agentsLabel: 'Внедряемые автономные ИИ-агенты',
      stackLabel: 'Технологический стек',
      fullProfileBtn: 'Подробный аудит компании &rarr;',
      submitTitle: 'Добавить компанию в рейтинг ИИ',
      submitName: 'Название компании / интегратора',
      submitNamePh: 'Например: Apex Neural Labs',
      submitCat: 'Основное направление ИИ',
      submitSite: 'Домен сайта',
      submitDesc: 'Что именно внедряете? (1–2 предложения)',
      submitDescPh: 'Например: Внедрение голосовых ИИ-агентов и RAG-баз знаний для корпораций.',
      submitTags: 'Стек технологий (через запятую)',
      submitTagsPh: 'OpenAI, LangChain, Python, n8n',
      submitEmail: 'Корпоративный Email',
      submitEmailPh: 'partners@company.com',
      submitBtn: 'Подать заявку в рейтинг',
      submitSuccess: 'Заявка отправлена на аудит аккредитации!',
      savedAdded: 'Сохранено в избранное',
      savedRemoved: 'Удалено из избранного',
      emptySavedTitle: 'В избранном пока пусто',
      emptySavedDesc: 'Нажмите на сердечко в карточке компании, чтобы сохранить подрядчика.',
      allTags: 'Все технологии',
    }
  };

  const t = I18N[window.__LANG] || I18N.en;

  // LocalStorage Saved state
  function getSavedIds() {
    try {
      return JSON.parse(localStorage.getItem('aitopindex_saved') || '[]');
    } catch (e) {
      return [];
    }
  }

  function setSavedIds(ids) {
    try {
      localStorage.setItem('aitopindex_saved', JSON.stringify(ids));
    } catch (e) {}
    updateSavedBadges();
  }

  function updateSavedBadges() {
    const ids = getSavedIds();
    const badges = document.querySelectorAll('#savedCountBadge');
    badges.forEach((b) => {
      b.textContent = ids.length;
      b.classList.toggle('hidden', ids.length === 0);
      b.classList.toggle('flex', ids.length > 0);
    });

    // Update heart icons on cards
    document.querySelectorAll('[data-save-btn]').forEach((btn) => {
      const id = btn.getAttribute('data-save-btn');
      const isSaved = ids.includes(id);
      const svg = btn.querySelector('svg');
      if (svg) {
        svg.setAttribute('fill', isSaved ? 'currentColor' : 'none');
      }
      btn.classList.toggle('text-[#2DD4BF]', isSaved);
      btn.classList.toggle('text-[#8B96A5]/60', !isSaved);
    });
  }

  window.toggleSaveCompany = function(id) {
    const ids = getSavedIds();
    const idx = ids.indexOf(id);
    if (idx === -1) {
      ids.push(id);
      showToast(t.savedAdded);
    } else {
      ids.splice(idx, 1);
      showToast(t.savedRemoved);
    }
    setSavedIds(ids);
    if (window.__CURRENT_TAB === 'saved') {
      window.applyDirectoryFilters();
    }
  };

  // Toast
  let toastTimer = null;
  window.showToast = function(msg) {
    const toast = document.getElementById('toastNotification');
    const text = document.getElementById('toastText');
    if (!toast || !text) return;
    text.textContent = msg;
    toast.classList.remove('opacity-0', 'translate-y-3');
    toast.classList.add('opacity-100', 'translate-y-0');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-3');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2400);
  };

  window.copyText = function(text) {
    navigator.clipboard.writeText(text).then(() => {
      showToast(`${t.copiedToast}: ${text}`);
    }).catch(() => {
      showToast(`${t.copiedToast}`);
    });
  };

  // Modal open/close
  window.openModal = function(html) {
    const backdrop = document.getElementById('modalBackdrop');
    const sheet = document.getElementById('modalSheet');
    if (!backdrop || !sheet) return;
    sheet.innerHTML = html;
    backdrop.classList.remove('hidden');
    backdrop.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeModal = function(e) {
    if (!e || e.target.id === 'modalBackdrop') {
      const backdrop = document.getElementById('modalBackdrop');
      if (backdrop) {
        backdrop.classList.add('hidden');
        backdrop.classList.remove('flex');
      }
      document.body.style.overflow = '';
    }
  };

  // Open Contact Modal (Strictly verified channels, zero Baku phone numbers!)
  window.openContactModal = function(agencyId) {
    const agency = window.__AGENCIES.find((a) => a.id === agencyId);
    if (!agency) return;

    const domain = agency.website.replace(/^https?:\/\//, '').replace(/\/$/, '');
    const cleanWeb = agency.website.startsWith('http') ? agency.website : `https://${agency.website}`;

    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#1E2631] pb-3">
        <div>
          <div class="flex items-center gap-1.5">
            <h3 class="text-[16px] font-bold text-[#F3F6FA]">${agency.name}</h3>
            <svg class="w-4 h-4 text-[#38BDF8] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l2.39 1.93 3.04-.35.93 2.92 2.67 1.48-.89 2.93 1.32 2.76-2.32 2-.29 3.05-3.01.55-1.84 2.45-2.85-1.13-2.85 1.13-1.84-2.45-3.01-.55-.29-3.05-2.32-2 1.32-2.76-.89-2.93 2.67-1.48.93-2.92 3.04.35L12 2zm-1.2 13.4l5.2-5.2-1.4-1.4-3.8 3.8-1.8-1.8-1.4 1.4 3.2 3.2z"/>
            </svg>
          </div>
          <p class="text-[12px] text-[#8B96A5] mt-0.5">${t.contactSub}</p>
        </div>
        <button type="button" onclick="closeModal()" class="w-8 h-8 rounded-full bg-[#171E27] border border-[#1E2631] text-[#8B96A5] hover:text-[#F3F6FA] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <div class="space-y-2.5">
        <div class="bg-[#090C10] border border-[#1E2631] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-medium text-[#8B96A5]">Official Domain</div>
            <a href="${cleanWeb}" target="_blank" rel="noopener noreferrer" class="text-[13.5px] font-semibold text-[#2DD4BF] hover:underline truncate block">
              ${domain}
            </a>
          </div>
          <button
            type="button"
            onclick="copyText('${domain}')"
            class="shrink-0 px-3 py-1.5 rounded-lg bg-[#171E27] hover:bg-[#2DD4BF]/15 border border-[#1E2631] hover:border-[#2DD4BF]/40 text-[11.5px] font-medium text-[#2DD4BF] transition-colors cursor-pointer"
          >
            ${t.copyBtn}
          </button>
        </div>

        <div class="bg-[#090C10] border border-[#1E2631] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-medium text-[#8B96A5]">Headquarters</div>
            <div class="text-[13px] font-medium text-[#F3F6FA] truncate">${agency.hq}</div>
          </div>
          <span class="text-[11px] font-mono text-[#10B981] bg-[#10B981]/10 px-2 py-0.5 rounded border border-[#10B981]/30">Verified</span>
        </div>

        <div class="bg-[#090C10] border border-[#1E2631] rounded-xl p-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[11px] font-medium text-[#8B96A5]">Directory Inquiry</div>
            <a href="mailto:submit@aitopindex.com?subject=Inquiry%20regarding%20${encodeURIComponent(agency.name)}" class="text-[13px] font-medium text-[#F3F6FA] hover:text-[#2DD4BF]">
              submit@aitopindex.com
            </a>
          </div>
          <a
            href="mailto:submit@aitopindex.com?subject=Inquiry%20regarding%20${encodeURIComponent(agency.name)}"
            class="shrink-0 px-3 py-1.5 rounded-lg bg-[#171E27] hover:bg-[#2DD4BF]/15 border border-[#1E2631] hover:border-[#2DD4BF]/40 text-[11.5px] font-medium text-[#2DD4BF] transition-colors"
          >
            Email
          </a>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-[#1E2631] flex items-center justify-between">
        <a href="${agency.profileUrl}" class="text-[12px] text-[#2DD4BF] hover:underline font-medium">
          ${t.fullProfileBtn}
        </a>
        <a
          href="${cleanWeb}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-[#2DD4BF] to-[#6366F1] text-[#090C10] font-bold text-[12px] shadow-[0_4px_16px_rgba(45,212,191,0.3)]"
        >
          <span>Open Site &rarr;</span>
        </a>
      </div>
    `);
  };

  // Open Cases Modal
  window.openCasesModal = function(agencyId) {
    const agency = window.__AGENCIES.find((a) => a.id === agencyId);
    if (!agency) return;

    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#1E2631] pb-3">
        <div>
          <h3 class="text-[16px] font-bold text-[#F3F6FA]">${agency.name}</h3>
          <p class="text-[12px] text-[#8B96A5] mt-0.5">${t.casesTitle}</p>
        </div>
        <button type="button" onclick="closeModal()" class="w-8 h-8 rounded-full bg-[#171E27] border border-[#1E2631] text-[#8B96A5] hover:text-[#F3F6FA] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <div class="space-y-3">
        <!-- Impact & Budget -->
        <div class="bg-[#090C10] border border-[#1E2631] rounded-xl p-3.5">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#2DD4BF]">${t.impactLabel}</div>
          <div class="grid grid-cols-2 gap-3 mt-2 font-mono text-xs">
            <div>
              <span class="text-[#8B96A5] block text-[10px]">Min Project Budget:</span>
              <span class="font-bold text-[#F3F6FA] text-sm">${agency.budget}</span>
            </div>
            <div>
              <span class="text-[#8B96A5] block text-[10px]">Avg Payback (ROI):</span>
              <span class="font-bold text-[#10B981] text-sm">${agency.roi}</span>
            </div>
          </div>
        </div>

        <!-- Deployed Agents -->
        <div class="bg-[#090C10] border border-[#1E2631] rounded-xl p-3.5">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#8B96A5] mb-2">${t.agentsLabel}</div>
          <div class="flex flex-wrap gap-1.5">
            ${agency.agents.map((ag) => `
              <span class="rounded-lg border border-[#2DD4BF]/30 bg-[#2DD4BF]/10 px-2.5 py-1 text-xs text-[#2DD4BF] font-medium">
                ${ag}
              </span>
            `).join('')}
          </div>
        </div>

        <!-- Tech Stack -->
        <div class="bg-[#090C10] border border-[#1E2631] rounded-xl p-3.5">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#8B96A5] mb-2">${t.stackLabel}</div>
          <div class="flex flex-wrap gap-1.5">
            ${agency.stack.map((st) => `
              <span class="font-mono text-[11px] text-[#F3F6FA]/90 bg-[#141B24] border border-[#1E2631] rounded-md px-2 py-0.5">
                #${st.replace(/\s+/g, '')}
              </span>
            `).join('')}
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-[#1E2631] flex items-center justify-between">
        <a href="${agency.profileUrl}" class="text-[12px] text-[#2DD4BF] hover:underline font-medium">
          ${t.fullProfileBtn}
        </a>
        <a
          href="${agency.website.startsWith('http') ? agency.website : 'https://' + agency.website}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#171E27] hover:bg-[#2DD4BF]/15 border border-[#1E2631] hover:border-[#2DD4BF]/40 text-[#2DD4BF] font-bold text-[12px]"
        >
          <span>Visit Website &rarr;</span>
        </a>
      </div>
    `);
  };

  // Open Submit AI Modal (Completely independent portal submit form)
  window.openSubmitAiModal = function() {
    const cats = window.__CATEGORIES;

    openModal(`
      <div class="flex items-center justify-between mb-4 border-b border-[#1E2631] pb-3">
        <div>
          <h3 class="text-[16px] font-bold text-[#F3F6FA]">${t.submitTitle}</h3>
          <p class="text-[11px] text-[#8B96A5]">Independent B2B verification • 0% synthetic data</p>
        </div>
        <button type="button" onclick="closeModal()" class="w-8 h-8 rounded-full bg-[#171E27] border border-[#1E2631] text-[#8B96A5] hover:text-[#F3F6FA] flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <form onsubmit="submitAiForm(event)" class="space-y-3">
        <div>
          <label class="block text-[11.5px] font-medium text-[#8B96A5] mb-1">${t.submitName}</label>
          <input type="text" id="aiFormName" required placeholder="${t.submitNamePh}" class="w-full bg-[#090C10] border border-[#1E2631] focus:border-[#2DD4BF] rounded-xl px-3 py-2 text-[13px] text-[#F3F6FA] focus:outline-none" />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-[11.5px] font-medium text-[#8B96A5] mb-1">${t.submitCat}</label>
            <select id="aiFormCat" class="w-full bg-[#090C10] border border-[#1E2631] focus:border-[#2DD4BF] rounded-xl px-2.5 py-2 text-[12.5px] text-[#F3F6FA] focus:outline-none">
              ${cats.map((c) => `<option value="${c.id}">${c.title}</option>`).join('')}
            </select>
          </div>
          <div>
            <label class="block text-[11.5px] font-medium text-[#8B96A5] mb-1">${t.submitSite}</label>
            <input type="text" id="aiFormSite" required placeholder="agency-domain.com" class="w-full bg-[#090C10] border border-[#1E2631] focus:border-[#2DD4BF] rounded-xl px-3 py-2 text-[13px] text-[#F3F6FA] focus:outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-[11.5px] font-medium text-[#8B96A5] mb-1">${t.submitDesc}</label>
          <textarea id="aiFormDesc" rows="2" required placeholder="${t.submitDescPh}" class="w-full bg-[#090C10] border border-[#1E2631] focus:border-[#2DD4BF] rounded-xl px-3 py-2 text-[12.5px] text-[#F3F6FA] focus:outline-none"></textarea>
        </div>

        <div>
          <label class="block text-[11.5px] font-medium text-[#8B96A5] mb-1">${t.submitTags}</label>
          <input type="text" id="aiFormTags" required placeholder="${t.submitTagsPh}" class="w-full bg-[#090C10] border border-[#1E2631] focus:border-[#2DD4BF] rounded-xl px-3 py-2 font-mono text-[12px] text-[#F3F6FA] focus:outline-none" />
        </div>

        <div>
          <label class="block text-[11.5px] font-medium text-[#8B96A5] mb-1">${t.submitEmail}</label>
          <input type="email" id="aiFormEmail" required placeholder="${t.submitEmailPh}" class="w-full bg-[#090C10] border border-[#1E2631] focus:border-[#2DD4BF] rounded-xl px-3 py-2 text-[13px] text-[#F3F6FA] focus:outline-none" />
        </div>

        <button type="submit" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-[#2DD4BF] to-[#6366F1] text-[#090C10] font-bold text-[13px] shadow-[0_4px_20px_rgba(45,212,191,0.3)] mt-2 cursor-pointer">
          ${t.submitBtn}
        </button>
      </form>
    `);
  };

  window.submitAiForm = function(e) {
    e.preventDefault();
    closeModal();
    showToast(t.submitSuccess);
  };

  // Init on DOM load
  document.addEventListener('DOMContentLoaded', () => {
    updateSavedBadges();
  });
  document.addEventListener('astro:page-load', () => {
    updateSavedBadges();
  });
</script>
