---
import { categories, agenciesFor, agencyPath, langPath, type CategoryId, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
  initialCategoryId?: CategoryId;
}

const { lang, initialCategoryId = 'sales' } = Astro.props;
const methodologyUrl = langPath(lang, '/methodology/');

const stacks = [
  { id: '', label: lang === 'ru' ? 'Любой инструмент' : 'Any tool' },
  { id: 'amocrm', label: 'AmoCRM / Albato', match: /amocrm|albato/i },
  { id: 'bitrix', label: 'Bitrix24', match: /bitrix|битрикс/i },
  { id: 'hubspot', label: 'HubSpot', match: /hubspot/i },
  { id: 'salesforce', label: 'Salesforce', match: /salesforce/i },
  { id: 'n8n', label: 'n8n / Make', match: /\bn8n\b|^make(?:\.com)?$/i },
  { id: 'custom', label: lang === 'ru' ? 'Свой API / база данных' : 'Custom API / Database', match: /^api$|custom\s+apis?|postgresql|\b(mysql|sqlite|mongodb|database)\b/i },
];

const agencyData = Object.fromEntries(
  categories.map((c) => [c.id, {
    costUsd: c.cost.usd,
    costRub: c.cost.rub,
    hoursPerSeat: c.hoursPerSeat,
    agencies: agenciesFor(c.id, lang).map((a) => ({
      name: a.name,
      href: agencyPath(lang, a.id),
      budget: a.minProjectBudget[lang],
      stacks: stacks.filter(({ match }) => match && a.techStack.some((tag) => match.test(tag))).map(({ id }) => id),
    })),
  }])
);
---

<section id="calculator" class="w-full my-12 scroll-mt-24">
  <div class="wrap">
    <div
      class="card p-6 sm:p-8 bg-white border border-[#e9ebf4] rounded-2xl shadow-[0_5px_18px_rgba(41,50,99,0.045)]"
      data-roi-calculator
      data-category={initialCategoryId}
      data-lang={lang}
    >
      <!-- Header -->
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ded6ff] bg-[#f0edff] px-3 py-1 font-mono text-xs font-semibold text-[#6336ed]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#6336ed] animate-pulse"></span>
          <span>{lang === 'ru' ? 'Интерактивный расчёт' : 'Interactive Estimator'}</span>
        </div>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-[#17172c] sm:text-3xl">
          {lang === 'ru' ? 'Калькулятор стоимости и окупаемости внедрения ИИ' : 'AI Implementation Cost & ROI Calculator'}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-[#59617e]">
          {lang === 'ru'
            ? 'Выберите задачу и размер команды, чтобы оценить затраты и экономию времени. По выбранному инструменту мы покажем до трёх подходящих компаний.'
            : 'Choose a category and team size to estimate cost and time savings. Select a tool to see up to three matching companies.'}
        </p>
      </div>

      <!-- Controls + Results Grid -->
      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Left: Form Controls (7 cols) -->
        <div class="space-y-5 lg:col-span-7">
          <!-- 1. Industry / Category -->
          <div>
            <label for="calculator-category" class="block font-semibold text-xs text-[#17172c] uppercase tracking-wider mb-2">
              1. {lang === 'ru' ? 'Сфера внедрения ИИ:' : 'Target AI Field / Category:'}
            </label>
            <select id="calculator-category" class="w-full bg-white border border-[#dfe1ee] text-[#17172c] text-sm rounded-xl px-3.5 py-2.5 focus:outline-none focus:border-[#6336ed] cursor-pointer" data-calc-category>
              {categories.map((c) => (
                <option value={c.id} selected={c.id === initialCategoryId}>
                  {c.title[lang]}
                </option>
              ))}
            </select>
          </div>

          <!-- 2. Team Size -->
          <div>
            <label class="block font-semibold text-xs text-[#17172c] uppercase tracking-wider mb-2">
              2. {lang === 'ru' ? 'Размер команды (пользователи процессов):' : 'Team Size (Affected Seats):'}
            </label>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 font-mono text-xs">
              {[
                { id: 'small', label: '1–10', multiplier: 0.7, seats: 6 },
                { id: 'medium', label: '11–50', multiplier: 1.0, seats: 25 },
                { id: 'growth', label: '51–200', multiplier: 1.8, seats: 100 },
                { id: 'enterprise', label: '200+', multiplier: 3.2, seats: 350 },
              ].map((size, idx) => (
                <button
                  type="button"
                  class={`w-full justify-center py-2.5 rounded-xl border text-center font-semibold transition cursor-pointer ${
                    idx === 1
                      ? 'bg-[#f0edff] border-[#6336ed] text-[#6336ed]'
                      : 'bg-[#f8f9fc] border-[#dfe1ee] text-[#49506c] hover:border-[#8d67ff]'
                  }`}
                  data-team-size={size.id}
                  data-multiplier={size.multiplier}
                  data-seats={size.seats}
                  aria-pressed={idx === 1 ? 'true' : 'false'}
                >
                  {size.label} {lang === 'ru' ? 'чел.' : 'seats'}
                </button>
              ))}
            </div>
          </div>

          <!-- 3. Target CRM / Integration Stack -->
          <div>
            <label class="block font-semibold text-xs text-[#17172c] uppercase tracking-wider mb-2">
              3. {lang === 'ru' ? 'Интеграционный стек / CRM:' : 'Primary CRM / Integration Stack:'}
            </label>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 font-mono text-xs">
              {stacks.map((stack, idx) => (
                <button
                  type="button"
                  class={`w-full justify-center py-2 rounded-xl border text-center font-semibold text-[11px] transition cursor-pointer ${
                    idx === 0
                      ? 'bg-[#f0edff] border-[#6336ed] text-[#6336ed]'
                      : 'bg-[#f8f9fc] border-[#dfe1ee] text-[#49506c] hover:border-[#8d67ff]'
                  }`}
                  data-crm-stack={stack.id}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  {stack.label}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Results Card (5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-between rounded-2xl border border-[#ded6ff] bg-gradient-to-br from-[#fbfcff] to-[#f0edff] p-6 shadow-sm">
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-[#6336ed] font-bold">
              {lang === 'ru' ? 'Предварительная оценка (не гарантия)' : 'Preliminary Estimate (Non-Binding)'}
            </span>

            <!-- Cost Range -->
            <div class="mt-4">
              <span class="text-xs text-[#59617e] block">{lang === 'ru' ? 'Ориентировочная стоимость внедрения:' : 'Estimated Implementation Cost:'}</span>
              <div class="font-mono text-2xl font-extrabold text-[#6336ed] sm:text-3xl mt-1" data-result-cost>
                {lang === 'ru' ? '250 000 — 1 500 000 ₽' : '$4,000 — $25,000'}
              </div>
            </div>

            <!-- Hours Saved -->
            <div class="mt-5 border-y border-[#e2ddfc] py-4 font-mono">
              <div>
                <span class="text-[10px] uppercase text-[#59617e] block font-sans">{lang === 'ru' ? 'Оценка экономии часов:' : 'Estimated Hours Saved:'}</span>
                <span class="text-xl font-bold text-[#009e54]" data-result-hours>550 ч/мес</span>
              </div>
            </div>

            <p class="mt-2.5 text-[10px] text-[#59617e] leading-snug">
              {lang === 'ru'
                ? '* Предварительный расчет на основе выбранных параметров (размер команды × отраслевой коэффициент категории). Не является публичной офертой или гарантией финансового результата.'
                : '* Preliminary estimate calculated from selected team size and category assumptions. Figures are illustrative benchmarks, not a guarantee of financial return.'}
            </p>

            <!-- Matching organizations -->
            <div class="mt-4">
              <span class="font-mono text-[10px] uppercase tracking-wider text-[#59617e] block mb-2.5 font-bold">
                {lang === 'ru' ? 'Подходящие компании из каталога:' : 'Matching Agencies in Directory:'}
              </span>
              <div class="space-y-2" data-result-agencies aria-live="polite"></div>
              <template data-agency-result>
                <div class="flex items-center justify-between rounded-lg bg-white border border-[#e2ddfc] p-2.5 text-xs">
                  <div class="min-w-0 pr-2">
                    <a class="font-bold text-[#17172c] hover:text-[#6336ed] truncate block" data-agency-name></a>
                    <span class="text-[10px] text-[#59617e] block" data-agency-budget></span>
                  </div>
                  <a class="text-[11px] font-bold text-[#6336ed] hover:underline shrink-0" data-agency-link>
                    {lang === 'ru' ? 'Профиль' : 'Profile'} &rarr;
                  </a>
                </div>
              </template>
            </div>
          </div>

          <div class="mt-6 pt-3 flex flex-col sm:flex-row gap-3">
            <button
              type="button"
              onclick="window.openFindPartnerModal?.()"
              class="flex-1 cta text-xs text-center justify-center py-2.5"
            >
              <span>{lang === 'ru' ? 'Подать заявку на внедрение' : 'Submit Integration Request'}</span>
              <span>→</span>
            </button>
            <a
              href={methodologyUrl}
              class="flex-1 cta secondary text-xs text-center justify-center py-2.5"
            >
              <span>{lang === 'ru' ? 'Методология расчёта' : 'Audit Methodology'} &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Raw Config Data for client JS -->
  <script type="application/json" id="calculator-data" set:html={JSON.stringify(agencyData)} />
</section>

<script>
  function setupCalculator() {
    const calcEl = document.querySelector<HTMLElement>('[data-roi-calculator]');
    const dataEl = document.getElementById('calculator-data');
    if (!calcEl || !dataEl || calcEl.dataset.ready) return;

    type Match = { name: string; href: string; budget: string; stacks: string[] };
    type CalculatorCategory = {
      costRub: [number, number];
      costUsd: [number, number];
      hoursPerSeat: number;
      agencies: Match[];
    };
    let config: Record<string, CalculatorCategory>;
    try {
      config = JSON.parse(dataEl.textContent || '{}');
    } catch {
      return;
    }
    calcEl.dataset.ready = 'true';

    const lang = calcEl.dataset.lang || 'en';
    const catSelect = calcEl.querySelector<HTMLSelectElement>('[data-calc-category]');
    const teamBtns = calcEl.querySelectorAll<HTMLButtonElement>('[data-team-size]');
    const crmBtns = calcEl.querySelectorAll<HTMLButtonElement>('[data-crm-stack]');

    const costEl = calcEl.querySelector<HTMLElement>('[data-result-cost]');
    const hoursEl = calcEl.querySelector<HTMLElement>('[data-result-hours]');
    const agenciesContainer = calcEl.querySelector<HTMLElement>('[data-result-agencies]');
    const agencyTemplate = calcEl.querySelector<HTMLTemplateElement>('[data-agency-result]');

    let currentCat = catSelect?.value || 'sales';
    let currentMultiplier = 1.0;
    let currentSeats = 25;
    let currentStack = '';

    function render() {
      const catData = config[currentCat];
      if (!catData) return;

      // Calculate cost
      if (lang === 'ru') {
        const minRub = Math.round((catData.costRub[0] * currentMultiplier) / 10000) * 10000;
        const maxRub = Math.round((catData.costRub[1] * currentMultiplier) / 50000) * 50000;
        if (costEl) costEl.textContent = `${minRub.toLocaleString('ru-RU')} — ${maxRub.toLocaleString('ru-RU')} ₽`;
      } else {
        const minUsd = Math.round((catData.costUsd[0] * currentMultiplier) / 500) * 500;
        const maxUsd = Math.round((catData.costUsd[1] * currentMultiplier) / 1000) * 1000;
        if (costEl) costEl.textContent = `$${minUsd.toLocaleString('en-US')} — $${maxUsd.toLocaleString('en-US')}`;
      }

      // Calculate hours saved
      const hoursSaved = Math.round(currentSeats * catData.hoursPerSeat * 0.85);
      if (hoursEl) hoursEl.textContent = `${hoursSaved} ${lang === 'ru' ? 'ч/мес' : 'hrs/mo'}`;

      if (!agenciesContainer || !agencyTemplate) return;
      const matches = catData.agencies.filter((agency) => !currentStack || agency.stacks.includes(currentStack)).slice(0, 3);
      if (!matches.length) {
        const message = document.createElement('p');
        message.className = 'text-xs text-[#59617e]';
        message.textContent = lang === 'ru'
          ? 'В этой категории пока нет компаний с выбранным инструментом. Выберите другой инструмент или «Любой инструмент».'
          : 'No companies in this category list this tool yet. Choose another tool or select “Any tool”.';
        agenciesContainer.replaceChildren(message);
        return;
      }

      const rows = matches.map((agency) => {
        const row = agencyTemplate.content.cloneNode(true) as DocumentFragment;
        const name = row.querySelector<HTMLAnchorElement>('[data-agency-name]')!;
        const profile = row.querySelector<HTMLAnchorElement>('[data-agency-link]')!;
        const budget = row.querySelector<HTMLElement>('[data-agency-budget]')!;
        name.textContent = agency.name;
        name.href = profile.href = agency.href;
        profile.setAttribute('aria-label', lang === 'ru' ? `Профиль ${agency.name}` : `${agency.name} profile`);
        budget.textContent = `${lang === 'ru' ? 'Бюджет:' : 'Budget:'} ${agency.budget}`;
        return row;
      });
      agenciesContainer.replaceChildren(...rows);
    }

    catSelect?.addEventListener('change', () => {
      currentCat = catSelect.value;
      render();
    });

    teamBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        teamBtns.forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.className = 'w-full justify-center py-2.5 rounded-xl border text-center font-semibold transition cursor-pointer bg-[#f8f9fc] border-[#dfe1ee] text-[#49506c] hover:border-[#8d67ff]';
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.className = 'w-full justify-center py-2.5 rounded-xl border text-center font-semibold transition cursor-pointer bg-[#f0edff] border-[#6336ed] text-[#6336ed]';
        currentMultiplier = parseFloat(btn.dataset.multiplier || '1.0');
        currentSeats = parseInt(btn.dataset.seats || '25', 10);
        render();
      });
    });

    crmBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        crmBtns.forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.className = 'w-full justify-center py-2 rounded-xl border text-center font-semibold text-[11px] transition cursor-pointer bg-[#f8f9fc] border-[#dfe1ee] text-[#49506c] hover:border-[#8d67ff]';
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.className = 'w-full justify-center py-2 rounded-xl border text-center font-semibold text-[11px] transition cursor-pointer bg-[#f0edff] border-[#6336ed] text-[#6336ed]';
        currentStack = btn.dataset.crmStack || '';
        render();
      });
    });

    render();
  }

  setupCalculator();
  document.addEventListener('astro:page-load', setupCalculator);
</script>
