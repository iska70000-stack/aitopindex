---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND, SITE, type Lang } from '../lib/data';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalPath?: string;
  alternatePaths?: { en: string; ru: string };
  jsonLd?: object | object[];
}

const {
  title,
  description,
  lang,
  canonicalPath = `/${lang}/`,
  alternatePaths = { en: '/en/', ru: '/ru/' },
  jsonLd,
} = Astro.props;

const canonicalUrl = `${SITE}${canonicalPath.startsWith('/') ? canonicalPath : '/' + canonicalPath}`;
const enAlternateUrl = `${SITE}${alternatePaths.en.startsWith('/') ? alternatePaths.en : '/' + alternatePaths.en}`;
const ruAlternateUrl = `${SITE}${alternatePaths.ru.startsWith('/') ? alternatePaths.ru : '/' + alternatePaths.ru}`;
const defaultAlternateUrl = `${SITE}/en/`;

// Base Schema.org graph
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: BRAND,
      description: 'Global B2B Directory & Ranking Index of Verified AI Agent Development Agencies & Studios',
      inLanguage: ['en', 'ru'],
    },
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: BRAND,
      url: SITE,
      logo: `${SITE}/favicon.svg`,
      sameAs: [
        'https://github.com/aitopindex',
      ],
    },
    ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
  ],
};
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="j7G38rAuKObNQSYLNsrgxJemhFGBfQzM5_gPDgTjtm4" />
    <meta name="google-site-verification" content="google4f7a9854ab9c1862" />

    <!-- Canonical & Alternates (GEO & Multilingual) -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enAlternateUrl} />
    <link rel="alternate" hreflang="ru" href={ruAlternateUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultAlternateUrl} />

    <!-- LLMs & Machine Readable Discovery -->
    <link rel="alternate" type="text/plain" title="LLM Context Summary" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLM Full Context" href="/llms-full.txt" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#05070B" />

    <!-- JSON-LD Microdata -->
    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
  </head>
  <body class="relative min-h-screen">
    <!-- Spatial 3D Pure-CSS Background (0KB JS) -->
    <div class="space-bg" aria-hidden="true">
      <div class="aurora aurora-cyan"></div>
      <div class="aurora aurora-violet"></div>
      <div class="aurora aurora-emerald"></div>
      <div class="grid-floor"></div>
    </div>

    <!-- Header Navigation -->
    <Header lang={lang} currentPath={canonicalPath} />

    <!-- Main Content Slot -->
    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <slot />
    </main>

    <!-- Footer -->
    <Footer lang={lang} />

    <!-- Lightweight Hardware-Accelerated 3D Card Tilt Script (Vanilla JS, 0 external deps) -->
    <script>
      function initTiltCards() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const cards = document.querySelectorAll<HTMLElement>('[data-tilt]');

        cards.forEach((card) => {
          let rect: DOMRect;
          let isHovered = false;

          function onMouseEnter() {
            rect = card.getBoundingClientRect();
            isHovered = true;
          }

          function onMouseMove(e: MouseEvent) {
            if (!isHovered) return;
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            // Subtle 3D tilt angles (max ~7 deg)
            const rx = ((y - centerY) / centerY) * -7;
            const ry = ((x - centerX) / centerX) * 7;

            card.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
            card.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
            card.style.setProperty('--mx', `${x.toFixed(1)}px`);
            card.style.setProperty('--my', `${y.toFixed(1)}px`);
          }

          function onMouseLeave() {
            isHovered = false;
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--ry', '0deg');
          }

          card.addEventListener('mouseenter', onMouseEnter, { passive: true });
          card.addEventListener('mousemove', onMouseMove, { passive: true });
          card.addEventListener('mouseleave', onMouseLeave, { passive: true });
        });
      }

      initTiltCards();
      document.addEventListener('astro:page-load', initTiltCards);
    </script>
  </body>
</html>
