---
import Layout from '../../layouts/Layout.astro';
import AgencyCard from '../../components/AgencyCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import RoiCalculator from '../../components/RoiCalculator.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import {
  categories,
  agenciesFor,
  YEAR,
  formatMonthYear,
  latestVerified,
  plural,
  SITE,
  type Lang,
  LANGS,
  type Category,
  type FaqItem,
} from '../../lib/data';

export function getStaticPaths() {
  const paths: { params: { lang: Lang; category: string }; props: { cat: Category } }[] = [];

  for (const lang of LANGS) {
    for (const cat of categories) {
      paths.push({
        params: { lang, category: cat.slug[lang] },
        props: { cat },
      });
    }
  }

  return paths;
}

const { lang } = Astro.params as { lang: Lang; category: string };
const { cat } = Astro.props as { cat: Category };

const categoryAgencies = agenciesFor(cat.id, lang);
const verifiedStamp = formatMonthYear(latestVerified(), lang);

// Category FAQs
const faqList: FaqItem[] = cat.faq(YEAR)[lang];

// Alternate URLs for hreflang
const alternatePaths = {
  en: `/en/${cat.slug.en}/`,
  ru: `/ru/${cat.slug.ru}/`,
};

const agencyCountLabel = plural(
  lang,
  categoryAgencies.length,
  ['Verified Agency', 'Verified Agencies'],
  ['проверенная компания', 'проверенные компании', 'проверенных компаний']
);

// Meta details
const title = lang === 'ru'
  ? `${cat.title.ru} — Рейтинг агентств и интеграторов ${YEAR} | AITopIndex`
  : `${cat.title.en} — Top Verified Agencies & Studios ${YEAR} | AITopIndex`;

const description = lang === 'ru'
  ? `Рейтинг проверенных агентств по направлению «${cat.title.ru}». Сравнение стеков, цен, кейсов и сроков окупаемости. Независимая проверка AITopIndex.`
  : `The definitive index of verified partners for ${cat.title.en}. Compare real pricing tiers, tech stacks, and case studies. Zero-hallucination verification.`;

// JSON-LD Schemas: CollectionPage + ItemList + FAQPage
const collectionPageJsonLd = {
  '@type': 'CollectionPage',
  name: title,
  description: cat.intro[lang],
  url: `${SITE}/${lang}/${cat.slug[lang]}/`,
  about: {
    '@type': 'Thing',
    name: cat.title[lang],
    description: cat.focus[lang],
  },
};

const itemListJsonLd = {
  '@type': 'ItemList',
  name: `Top ${cat.title[lang]} Agencies`,
  numberOfItems: categoryAgencies.length,
  itemListElement: categoryAgencies.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': a.type === 'platform' ? 'SoftwareApplication' : 'ProfessionalService',
      name: a.name,
      url: a.website,
      sameAs: [a.website],
      priceRange: a.minProjectBudget[lang],
      areaServed: a.markets.includes('global') ? 'Worldwide' : 'CIS / Eastern Europe',
      knowsAbout: [...a.techStack, ...a.deployedAgents[lang]],
      description: a.description[lang],
    },
  })),
};

const faqPageJsonLd = {
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={`/${lang}/${cat.slug[lang]}/`}
  alternatePaths={alternatePaths}
  jsonLd={[collectionPageJsonLd, itemListJsonLd, faqPageJsonLd]}
>
  <!-- Category Header & Breadcrumbs -->
  <section class="pt-8 pb-10">
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-6">
      <a href={`/${lang}/`} class="hover:text-cyan-glow transition">{lang === 'ru' ? 'Главная' : 'Home'}</a>
      <span>/</span>
      <a href={`/${lang}/#categories`} class="hover:text-cyan-glow transition">{lang === 'ru' ? 'Категории' : 'Categories'}</a>
      <span>/</span>
      <span class="text-white font-medium">{cat.title[lang]}</span>
    </nav>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 border-b border-white/10 pb-10">
      <div class="max-w-3xl">
        <!-- Verification & Count Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-cyan-glow/30 bg-cyan-glow/5 px-3.5 py-1 font-mono text-xs text-cyan-glow mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-glow animate-pulse"></span>
          <span>{categoryAgencies.length} {agencyCountLabel}</span>
          <span class="text-slate-500">•</span>
          <span class="text-slate-300">{lang === 'ru' ? 'Актуально на' : 'Updated'} {verifiedStamp}</span>
        </div>

        <div class="flex items-start gap-4">
          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3 shadow-inner hidden sm:block">
            <CategoryIcon category={cat.id} class="h-12 w-12" />
          </div>
          <div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white break-words">
              {cat.title[lang]}
            </h1>
            <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-300">
              {cat.intro[lang]}
            </p>
          </div>
        </div>

        <!-- Focus Pills -->
        <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-slate-400 uppercase tracking-wider">{lang === 'ru' ? 'Фокус:' : 'Core Focus:'}</span>
          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1 text-slate-300">
            {cat.focus[lang]}
          </span>
        </div>
      </div>

      <!-- Quick Category Quick-Stats Card -->
      <div class="w-full lg:w-80 rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur-xl font-mono text-xs">
        <h4 class="uppercase tracking-wider text-slate-400 mb-3 font-semibold">
          {lang === 'ru' ? 'Отраслевые бенчмарки' : 'Sector Benchmarks'}
        </h4>
        <div class="space-y-3">
          <div class="flex justify-between border-b border-white/5 pb-2">
            <span class="text-slate-400">{lang === 'ru' ? 'Внедрение от:' : 'Entry Tier:'}</span>
            <span class="font-bold text-white">
              {lang === 'ru' ? `${cat.cost.rub[0].toLocaleString('ru-RU')} ₽` : `$${cat.cost.usd[0].toLocaleString('en-US')}`}
            </span>
          </div>
          <div class="flex justify-between border-b border-white/5 pb-2">
            <span class="text-slate-400">{lang === 'ru' ? 'Окупаемость:' : 'Avg ROI:'}</span>
            <span class="font-bold text-emerald-400">1–3 {lang === 'ru' ? 'месяца' : 'months'}</span>
          </div>
          <div class="flex justify-between border-b border-white/5 pb-2">
            <span class="text-slate-400">{lang === 'ru' ? 'Экономия часов:' : 'Hours / Seat:'}</span>
            <span class="font-bold text-cyan-glow">~{cat.hoursPerSeat} {lang === 'ru' ? 'ч/мес на место' : 'hrs/mo/seat'}</span>
          </div>
          <div class="flex justify-between pt-1">
            <span class="text-slate-400">{lang === 'ru' ? 'Статус аудита:' : 'Audit Status:'}</span>
            <span class="text-emerald-400 font-semibold">{lang === 'ru' ? 'Верифицировано' : 'Anti-Hallucination'}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category-Specific Filter Bar -->
  <section class="py-2">
    <FilterBar lang={lang} targetContainerId="category-agencies-grid" />
  </section>

  <!-- Ranked Agencies Grid for this Category -->
  <section class="pb-16">
    <div id="category-agencies-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categoryAgencies.map((agency, index) => (
        <AgencyCard agency={agency} lang={lang} rank={index + 1} />
      ))}
    </div>
  </section>

  <!-- Category-specific Cost & ROI Calculator -->
  <RoiCalculator lang={lang} initialCategoryId={cat.id} />

  <!-- Rich FAQ Section with Accordions (Answering 2026 pricing & architectural queries) -->
  <section class="py-16 border-t border-white/10 scroll-mt-20" id="faq">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <span class="font-mono text-xs uppercase tracking-wider text-cyan-glow">
          {lang === 'ru' ? 'Экспертные ответы' : 'Expert Knowledge & Benchmarks'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mt-1">
          {lang === 'ru' ? 'Часто задаваемые вопросы (FAQ)' : 'Frequently Asked Questions'}
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-400">
          {lang === 'ru'
            ? `Актуальные ценовые диапазоны, архитектурные особенности и правовые аспекты внедрения в ${YEAR} году.`
            : `Production pricing ranges, integration architectures, and compliance benchmarks for ${YEAR}.`}
        </p>
      </div>

      <div class="space-y-4 prose-faq">
        {faqList.map((item, idx) => (
          <details
            class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur-xl transition hover:border-cyan-glow/40 open:border-cyan-glow/50 open:bg-white/[0.05]"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between cursor-pointer list-none text-base font-semibold text-white group-hover:text-cyan-glow transition">
              <span class="pr-4">{item.q}</span>
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-white/10 text-xs font-mono text-slate-400 group-open:rotate-180 transition-transform">
                &darr;
              </span>
            </summary>
            <div class="mt-4 border-t border-white/5 pt-4 text-sm leading-relaxed text-slate-300">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
