---
import Layout from '../../layouts/Layout.astro';
import DirectoryApp from '../../components/DirectoryApp.astro';
import RoiCalculator from '../../components/RoiCalculator.astro';
import {
  agencies,
  agenciesByLang,
  categories,
  type Lang,
  LANGS,
  SITE,
} from '../../lib/data';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const totalAgencies = agencies.length;
const listAgencies = agenciesByLang(lang);

// SEO Metas
const meta = {
  en: {
    title: 'Top Index — Global AI Ranking Platform 2026',
    description: `Discover ${totalAgencies}+ verified AI companies, agent development agencies, and specialists worldwide. Real benchmarks, tech stacks, and trust scores.`,
  },
  ru: {
    title: 'Top Index — Глобальный рейтинг ИИ-компаний и специалистов 2026',
    description: `Рейтинг ${totalAgencies}+ проверенных ИИ-компаний, интеграторов агентов и архитекторов решений. Сравнение стеков, показателей окупаемости и Trust Score.`,
  },
}[lang];

// JSON-LD ItemList for Categories
const categoryItemListJsonLd = {
  '@type': 'ItemList',
  name: lang === 'ru' ? 'Категории внедрения ИИ-агентов' : 'AI Implementation Categories',
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title[lang],
    url: `${SITE}/${lang}/${c.slug[lang]}/`,
    description: c.short[lang],
  })),
};
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  canonicalPath={`/${lang}/`}
  alternatePaths={{ en: '/en/', ru: '/ru/' }}
  jsonLd={categoryItemListJsonLd}
>
  <DirectoryApp
    agencies={listAgencies}
    categories={categories}
    lang={lang}
    initialCategory="all"
  />

  <RoiCalculator lang={lang} />
</Layout>
