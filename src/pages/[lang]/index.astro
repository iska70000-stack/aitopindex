---
import Layout from '../../layouts/Layout.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import AgencyCard from '../../components/AgencyCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import RoiCalculator from '../../components/RoiCalculator.astro';
import {
  agencies,
  categories,
  formatMonthYear,
  latestVerified,
  pluralRu,
  roundedCount,
  type Lang,
  LANGS,
  SITE,
} from '../../lib/data';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const verifiedStamp = formatMonthYear(latestVerified(), lang);
const totalAgencies = agencies.length;
const roundedTotal = roundedCount(totalAgencies);

// Grammatically correct pluralization for Hero counter:
// In Russian: e.g. "85+ проверенных компаний" / "80+ проверенных компаний"
const agencyCounterNoun =
  lang === 'ru'
    ? pluralRu(roundedTotal, ['проверенная компания', 'проверенные компании', 'проверенных компаний'])
    : 'Verified Agencies';

// SEO Metas
const meta = {
  en: {
    title: 'AITopIndex — Global B2B Directory & Ranking of Verified AI Agents & Studios',
    description: `Independent index of ${totalAgencies}+ verified AI agent development agencies, n8n/Make automation integrators, and AI video production studios. Compare tech stacks, real budgets and ROI.`,
  },
  ru: {
    title: 'AITopIndex — Рейтинг компаний и специалистов по внедрению ИИ-агентов',
    description: `Независимый рейтинг и каталог ${totalAgencies}+ проверенных агентств по внедрению ИИ-агентов, интеграторов CRM/n8n и студий ИИ-видеопродакшна. Сравнение стеков, бюджетов и сроков окупаемости.`,
  },
}[lang];

// JSON-LD ItemList for Categories
const categoryItemListJsonLd = {
  '@type': 'ItemList',
  name: lang === 'ru' ? 'Категории внедрения ИИ-агентов' : 'AI Agent Implementation Categories',
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title[lang],
    url: `${SITE}/${lang}/${c.slug[lang]}/`,
    description: c.short[lang],
  })),
};
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  canonicalPath={`/${lang}/`}
  alternatePaths={{ en: '/en/', ru: '/ru/' }}
  jsonLd={categoryItemListJsonLd}
>
  <!-- Hero Section -->
  <section class="pt-12 sm:pt-20 pb-12 text-center max-w-4xl mx-auto">
    <!-- Single Clean Verification Date Badge (No duplicate in navbar) -->
    <div class="inline-flex items-center gap-2.5 rounded-full border border-cyan-glow/40 bg-white/[0.04] px-4 py-1.5 backdrop-blur-md shadow-[0_0_20px_-5px_rgba(0,240,255,0.3)] mb-6">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-glow opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-glow"></span>
      </span>
      <span class="font-mono text-xs text-slate-300">
        <strong class="text-white font-semibold">{roundedTotal}+</strong> {agencyCounterNoun}
        <span class="text-slate-500 mx-1">•</span>
        <span class="text-cyan-glow">{lang === 'ru' ? 'Реестр актуален:' : 'Verified:'} {verifiedStamp}</span>
      </span>
    </div>

    <!-- Main Title -->
    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl text-balance">
      {lang === 'ru' ? (
        <>
          Рейтинг компаний и интеграторов по <span class="text-gradient">внедрению ИИ-агентов</span>
        </>
      ) : (
        <>
          Global Index of <span class="text-gradient">Verified AI Agent</span> Developers & Studios
        </>
      )}
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-base sm:text-lg leading-relaxed text-slate-300 max-w-3xl mx-auto">
      {lang === 'ru' ? (
        <>
          Единый независимый B2B-каталог разработчиков автономных ИИ-сотрудников, голосовых роботов,
          автоматизации n8n/Make и генеративного видео. Реальные компании, проверенные стеки и честные бюджеты.
        </>
      ) : (
        <>
          The definitive enterprise directory of production-proven AI SDRs, voice call bots, n8n/Make
          orchestration specialists, and generative film studios. Real companies, audited tech stacks, and zero hallucinations.
        </>
      )}
    </p>

    <!-- Quick CTAs -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href="#categories" class="btn-primary">
        <span>{lang === 'ru' ? 'Выбрать категорию (3×3)' : 'Browse Categories (3×3)'}</span>
        <span>&darr;</span>
      </a>
      <a href="#calculator" class="btn-ghost">
        <span>{lang === 'ru' ? 'Рассчитать стоимость и ROI' : 'Calculate Implementation Cost'}</span>
      </a>
    </div>

    <!-- Market Trust Stats -->
    <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 border-t border-b border-white/5 py-6 font-mono text-center">
      <div>
        <span class="block text-2xl font-bold text-white sm:text-3xl">9</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider">{lang === 'ru' ? 'Сфер внедрения' : 'AI Verticals'}</span>
      </div>
      <div>
        <span class="block text-2xl font-bold text-cyan-glow sm:text-3xl">{totalAgencies}+</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider">{lang === 'ru' ? 'Проверено вручную' : 'Audited Teams'}</span>
      </div>
      <div>
        <span class="block text-2xl font-bold text-emerald-400 sm:text-3xl">1–3 {lang === 'ru' ? 'мес.' : 'mo'}</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider">{lang === 'ru' ? 'Срок окупаемости' : 'Avg Payback'}</span>
      </div>
      <div>
        <span class="block text-2xl font-bold text-violet-300 sm:text-3xl">100%</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider">{lang === 'ru' ? 'Без галлюцинаций' : 'Verified Web'}</span>
      </div>
    </div>
  </section>

  <!-- 9 High-Demand Categories (3x3 Desktop Grid & 1 Col Mobile) -->
  <section id="categories" class="pt-8 pb-16 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-8 gap-4">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-cyan-glow">
          {lang === 'ru' ? 'Архитектура каталога' : 'Directory Architecture'}
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl mt-1">
          {lang === 'ru' ? '9 ключевых направлений внедрения ИИ' : '9 High-Demand AI Implementation Sectors'}
        </h2>
      </div>
      <p class="text-xs text-slate-400 font-mono">
        {lang === 'ru' ? 'Сетка 3×3 на десктопе • Адаптивный мобильный вид' : '3×3 Desktop Grid • Full Mobile Support'}
      </p>
    </div>

    <!-- 3x3 Desktop Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((category) => (
        <CategoryCard category={category} lang={lang} />
      ))}
    </div>
  </section>

  <!-- AI Implementation Cost & ROI Calculator Section -->
  <RoiCalculator lang={lang} />

  <!-- Directory of Verified Agencies with Real-time Filter -->
  <section id="agencies" class="pt-8 pb-20 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-2">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-emerald-400">
          {lang === 'ru' ? 'Глобальный реестр' : 'Master B2B Directory'}
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl mt-1">
          {lang === 'ru' ? 'Все проверенные компании и студии' : 'All Verified Agencies & Studios'}
        </h2>
      </div>
      <p class="text-xs text-slate-400 font-mono">
        {lang === 'ru'
          ? 'Сортировка по индексу надежности и технологическому стеку'
          : 'Ranked by verified stack depth & enterprise case studies'}
      </p>
    </div>

    <!-- Filter Bar -->
    <FilterBar lang={lang} targetContainerId="agencies-grid" />

    <!-- Agencies Grid -->
    <div id="agencies-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      {agencies.map((agency, index) => (
        <AgencyCard agency={agency} lang={lang} rank={index + 1} />
      ))}
    </div>
  </section>
</Layout>
