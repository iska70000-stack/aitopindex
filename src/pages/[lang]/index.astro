---
import Layout from '../../layouts/Layout.astro';
import DirectoryApp from '../../components/DirectoryApp.astro';
import RoiCalculator from '../../components/RoiCalculator.astro';
import {
  agencies,
  agenciesByLang,
  categories,
  type Lang,
  LANGS,
  SITE,
} from '../../lib/data';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const totalAgencies = agencies.length;
const listAgencies = agenciesByLang(lang);

// SEO Metas
const meta = {
  en: {
    title: 'AI Top Index — Directory of AI Companies & Integrators 2026',
    description: `Discover ${totalAgencies}+ verified AI agent development agencies, enterprise automation integrators, and AI video production studios. Compare real budgets, tech stacks, and ROI.`,
  },
  ru: {
    title: 'AI Top Index — Рейтинг компаний и специалистов по внедрению ИИ 2026',
    description: `Каталог ${totalAgencies}+ проверенных агентств по внедрению ИИ-агентов, интеграторов CRM/n8n и студий генеративного видео. Сравнение стеков, бюджетов и сроков окупаемости.`,
  },
}[lang];

// JSON-LD ItemList for Categories
const categoryItemListJsonLd = {
  '@type': 'ItemList',
  name: lang === 'ru' ? 'Категории внедрения ИИ-агентов' : 'AI Agent Implementation Categories',
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title[lang],
    url: `${SITE}/${lang}/${c.slug[lang]}/`,
    description: c.short[lang],
  })),
};
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  canonicalPath={`/${lang}/`}
  alternatePaths={{ en: '/en/', ru: '/ru/' }}
  jsonLd={categoryItemListJsonLd}
>
  <div class="py-2">
    <!-- Interactive Dark Tech Directory App -->
    <DirectoryApp
      agencies={listAgencies}
      categories={categories}
      lang={lang}
      initialCategory="all"
    />

    <!-- Implementation Cost & ROI Payback Calculator Section -->
    <section class="mt-8 pt-8 border-t border-[#1E2631]">
      <RoiCalculator lang={lang} />
    </section>
  </div>
</Layout>
