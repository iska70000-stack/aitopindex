---
import Layout from '../layouts/Layout.astro';
import DirectoryApp from '../components/DirectoryApp.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import {
  agencies,
  agenciesByLang,
  categories,
  SITE,
} from '../lib/data';

const lang = 'en';
const totalAgencies = agencies.length;
const listAgencies = agenciesByLang(lang);

const meta = {
  title: 'Top Index — Global AI Ranking Platform 2026',
  description: `Discover ${totalAgencies}+ verified AI companies, agent development agencies, and specialists worldwide. Real benchmarks, tech stacks, and trust scores.`,
};

// JSON-LD ItemList for Categories
const categoryItemListJsonLd = {
  '@type': 'ItemList',
  name: 'AI Implementation Categories',
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title[lang],
    url: `${SITE}/${c.slug[lang]}/`,
    description: c.short[lang],
  })),
};
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  canonicalPath="/"
  alternatePaths={{ en: '/', ru: '/ru/' }}
  jsonLd={categoryItemListJsonLd}
>
  <DirectoryApp
    agencies={listAgencies}
    categories={categories}
    lang={lang}
    initialCategory="all"
  />

  <RoiCalculator lang={lang} />
</Layout>
