---
import Layout from '../layouts/Layout.astro';
import DirectoryApp from '../components/DirectoryApp.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import {
  agencies,
  agenciesByLang,
  categories,
  SITE,
} from '../lib/data';

const lang = 'en';
const totalAgencies = agencies.length;
const listAgencies = agenciesByLang(lang);

const meta = {
  title: 'Top Index — Global AI Ranking Platform 2026',
  description: `Discover ${totalAgencies}+ verified AI companies, agent development agencies, and specialists worldwide. Real benchmarks, tech stacks, and trust scores.`,
};

// JSON-LD ItemList for Categories
const categoryItemListJsonLd = {
  '@type': 'ItemList',
  name: 'AI Implementation Categories',
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title[lang],
    url: `${SITE}/${lang}/${c.slug[lang]}/`,
    description: c.short[lang],
  })),
};
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  canonicalPath="/en/"
  alternatePaths={{ en: '/en/', ru: '/ru/' }}
  jsonLd={categoryItemListJsonLd}
>
  <!-- Client-Side RU detection for root / visitors -->
  <script is:inline>
    try {
      const isBot = /bot|googlebot|crawler|spider|robot|crawling/i.test(navigator.userAgent);
      if (!isBot) {
        const userLang = (navigator.language || '').toLowerCase();
        if (userLang.startsWith('ru') || userLang.startsWith('be') || userLang.startsWith('kk')) {
          if (!sessionStorage.getItem('preferred_lang')) {
            sessionStorage.setItem('preferred_lang', 'ru');
            window.location.replace('/ru/');
          }
        }
      }
    } catch (e) {}
  </script>

  <DirectoryApp
    agencies={listAgencies}
    categories={categories}
    lang={lang}
    initialCategory="all"
  />

  <RoiCalculator lang={lang} />
</Layout>
