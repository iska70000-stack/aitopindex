---
// Root page: Detect browser language or fallback to /en/
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/en/" />
    <title>Redirecting to AITopIndex...</title>
    <meta name="google-site-verification" content="j7G38rAuKObNQSYLNsrgxJemhFGBfQzM5_gPDgTjtm4" />
    <meta name="google-site-verification" content="google4f7a9854ab9c1862" />
    <link rel="canonical" href="https://www.aitopindex.com/en/" />
    <script is:inline>
      try {
        const lang = (navigator.language || '').toLowerCase();
        if (lang.startsWith('ru') || lang.startsWith('be') || lang.startsWith('kk')) {
          window.location.replace('/ru/');
        } else {
          window.location.replace('/en/');
        }
      } catch (e) {
        window.location.replace('/en/');
      }
    </script>
  </head>
  <body class="bg-[#05070B] text-slate-400 font-mono text-xs flex min-h-screen items-center justify-center">
    <p>Redirecting to <a href="/en/" class="text-cyan-400 underline">AITopIndex (English)</a> / <a href="/ru/" class="text-cyan-400 underline">AITopIndex (Русский)</a>...</p>
  </body>
</html>
