---
import Layout from '../layouts/Layout.astro';
import AgencyCard from '../components/AgencyCard.astro';
import FilterBar from '../components/FilterBar.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import {
  agenciesFor,
  YEAR,
  formatMonthYear,
  latestVerified,
  plural,
  SITE,
  langPath,
  type Lang,
  type Category,
  type FaqItem,
} from '../lib/data';

interface Props {
  lang: Lang;
  cat: Category;
}

const { lang, cat } = Astro.props;

const categoryAgencies = agenciesFor(cat.id, lang);
const verifiedStamp = formatMonthYear(latestVerified(), lang);

// Category FAQs
const faqList: FaqItem[] = cat.faq(YEAR)[lang];

// Alternate URLs for hreflang (EN at root '/', RU under '/ru/')
const alternatePaths = {
  en: `/${cat.slug.en}/`,
  ru: `/ru/${cat.slug.ru}/`,
};

const canonicalPath = langPath(lang, `/${cat.slug[lang]}/`);

const agencyCountLabel = plural(
  lang,
  categoryAgencies.length,
  ['Verified Organization', 'Verified Organizations'],
  ['проверенная организация', 'проверенные организации', 'проверенных организаций']
);

// Meta details
const title = lang === 'ru'
  ? `${cat.title.ru} — Каталог компаний ${YEAR} | Top Index`
  : `${cat.title.en} — Company Directory ${YEAR} | Top Index`;

const description = lang === 'ru'
  ? `Компании и платформы по направлению «${cat.title.ru}». Сравните инструменты, специализацию и ориентиры по бюджету.`
  : `Browse companies and platforms for ${cat.title.en}. Compare their specialties, tools, and indicative budgets.`;

// JSON-LD Schemas: CollectionPage + ItemList + FAQPage
const collectionPageJsonLd = {
  '@type': 'CollectionPage',
  name: title,
  description: cat.intro[lang],
  url: `${SITE}${canonicalPath}`,
  about: {
    '@type': 'Thing',
    name: cat.title[lang],
    description: cat.focus[lang],
  },
};

const itemListJsonLd = {
  '@type': 'ItemList',
  name: cat.title[lang],
  numberOfItems: categoryAgencies.length,
  itemListElement: categoryAgencies.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': a.type === 'platform' ? 'SoftwareApplication' : 'ProfessionalService',
      name: a.name,
      url: a.website,
      sameAs: [a.website],
      priceRange: a.minProjectBudget[lang],
      areaServed: a.markets.includes('global') ? 'Worldwide' : 'CIS / Eastern Europe',
      knowsAbout: [...a.techStack, ...a.deployedAgents[lang]],
      description: a.description[lang],
    },
  })),
};

const faqPageJsonLd = {
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
  jsonLd={[collectionPageJsonLd, itemListJsonLd, faqPageJsonLd]}
>
  <div class="wrap pt-6 pb-12">
    <!-- Category Header & Breadcrumbs -->
    <section class="pb-8">
      <nav class="flex items-center gap-2 font-mono text-xs text-[#59617e] mb-5">
        <a href={langPath(lang, '/')} class="hover:text-[#6336ed] transition">{lang === 'ru' ? 'Главная' : 'Home'}</a>
        <span>/</span>
        <a href={langPath(lang, '/#categories-section')} class="hover:text-[#6336ed] transition">{lang === 'ru' ? 'Категории' : 'Categories'}</a>
        <span>/</span>
        <span class="text-[#17172c] font-bold">{cat.title[lang]}</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 border-b border-[#e9ebf4] pb-8">
        <div class="max-w-3xl">
          <!-- Verification & Count Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-[#ded6ff] bg-[#f0edff] px-3.5 py-1 text-xs font-semibold text-[#6336ed] mb-4">
            <span class="h-1.5 w-1.5 rounded-full bg-[#009e54] animate-pulse"></span>
            <span>{categoryAgencies.length} {agencyCountLabel}</span>
            <span class="text-[#cbd1e2]">•</span>
            <span class="text-[#59617e]">{lang === 'ru' ? 'Актуально на' : 'Updated'} {verifiedStamp}</span>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-14 h-14 rounded-2xl bg-[#f0edff] text-[#6336ed] p-3 flex items-center justify-center shrink-0 hidden sm:flex">
              <CategoryIcon category={cat.id} class="h-8 w-8" />
            </div>
            <div>
              <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[#17172c] break-words">
                {cat.title[lang]}
              </h1>
              <p class="mt-3 text-sm sm:text-base leading-relaxed text-[#59617e]">
                {cat.intro[lang]}
              </p>
            </div>
          </div>

          <!-- Focus Pills -->
          <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
            <span class="text-[#59617e] uppercase font-bold tracking-wider">{lang === 'ru' ? 'Фокус внедрения:' : 'Core Focus:'}</span>
            <span class="rounded-lg border border-[#e5e7f3] bg-[#f8f9fe] px-3 py-1 text-[#17172c] font-medium">
              {cat.focus[lang]}
            </span>
          </div>
        </div>

        <!-- Quick Category Benchmarks Card -->
        <div class="w-full lg:w-80 card p-5 font-mono text-xs shadow-sm bg-white border border-[#e9ebf4]">
          <h4 class="uppercase tracking-wider text-[#17172c] mb-3 font-bold font-sans">
            {lang === 'ru' ? 'Отраслевые бенчмарки' : 'Sector Benchmarks'}
          </h4>
          <div class="space-y-3">
            <div class="flex justify-between border-b border-[#f0f2fa] pb-2">
              <span class="text-[#59617e] font-sans">{lang === 'ru' ? 'Внедрение от:' : 'Entry Tier:'}</span>
              <span class="font-bold text-[#17172c]">
                {lang === 'ru' ? `${cat.cost.rub[0].toLocaleString('ru-RU')} ₽` : `$${cat.cost.usd[0].toLocaleString('en-US')}`}
              </span>
            </div>
            <div class="flex justify-between border-b border-[#f0f2fa] pb-2">
              <span class="text-[#59617e] font-sans">{lang === 'ru' ? 'Окупаемость:' : 'Avg ROI:'}</span>
              <span class="font-bold text-[#009e54]">1–3 {lang === 'ru' ? 'месяца' : 'months'}</span>
            </div>
            <div class="flex justify-between border-b border-[#f0f2fa] pb-2">
              <span class="text-[#59617e] font-sans">{lang === 'ru' ? 'Экономия часов:' : 'Hours / Seat:'}</span>
              <span class="font-bold text-[#6336ed]">~{cat.hoursPerSeat} {lang === 'ru' ? 'ч/мес на место' : 'hrs/mo/seat'}</span>
            </div>
            <div class="flex justify-between pt-1">
              <span class="text-[#59617e] font-sans">{lang === 'ru' ? 'Статус аудита:' : 'Audit Status:'}</span>
              <span class="text-[#009e54] font-bold font-sans">{lang === 'ru' ? 'Верифицировано' : 'Audited 2026'}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Companies in this category -->
    <section class="py-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-[#17172c]">
          {lang === 'ru' ? 'Компании и платформы' : 'Companies and Platforms'}
        </h2>
        <span class="text-xs text-[#59617e]">
          {categoryAgencies.length} {agencyCountLabel}
        </span>
      </div>

      <div id="category-agencies-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {categoryAgencies.map((agency) => (
          <AgencyCard agency={agency} lang={lang} />
        ))}
      </div>
    </section>

    <!-- Category-specific Cost & ROI Calculator -->
    <RoiCalculator lang={lang} initialCategoryId={cat.id} />

    <!-- Rich FAQ Section with Accordions -->
    <section class="py-12 border-t border-[#e9ebf4] scroll-mt-20" id="faq">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs uppercase font-bold tracking-wider text-[#6336ed]">
            {lang === 'ru' ? 'Экспертные ответы' : 'Expert Knowledge & Benchmarks'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#17172c] mt-1">
            {lang === 'ru' ? 'Часто задаваемые вопросы (FAQ)' : 'Frequently Asked Questions'}
          </h2>
          <p class="mt-2 text-xs sm:text-sm text-[#59617e]">
            {lang === 'ru'
              ? `Актуальные ценовые диапазоны, архитектурные особенности и правовые аспекты внедрения в ${YEAR} году.`
              : `Production pricing ranges, integration architectures, and compliance benchmarks for ${YEAR}.`}
          </p>
        </div>

        <div class="space-y-3 prose-faq">
          {faqList.map((item, idx) => (
            <details
              class="card p-4 sm:p-5 bg-white border border-[#e9ebf4] transition hover:border-[#8d67ff] open:border-[#6336ed] open:shadow-sm"
              open={idx === 0}
            >
              <summary class="flex items-center justify-between cursor-pointer list-none text-sm sm:text-base font-bold text-[#17172c] hover:text-[#6336ed] transition">
                <span class="pr-4">{item.q}</span>
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#f0edff] text-xs font-bold text-[#6336ed]">
                  &darr;
                </span>
              </summary>
              <div class="mt-3 border-t border-[#f0f2fa] pt-3 text-xs sm:text-sm leading-relaxed text-[#59617e]">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
