---
import Layout from '../layouts/Layout.astro';
import { categories, type Lang, BRAND, langPath } from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const title = lang === 'ru'
  ? `Добавить ИИ-компанию в каталог | ${BRAND}`
  : `Submit Your AI Agency for Verification | ${BRAND}`;

const description = lang === 'ru'
  ? 'Бесплатная заявка на добавление компании в каталог AITopIndex. Укажите сайт, инструменты и ссылку на пример работы.'
  : 'Free application form for AI agent development agencies, automation integrators, and generative video studios to be verified and listed on AITopIndex.';

const alternatePaths = {
  en: '/submit/',
  ru: '/ru/submit/',
};
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={langPath(lang, '/submit/')}
  alternatePaths={alternatePaths}
>
  <div class="py-12 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-glow/40 bg-white/[0.04] px-4 py-1.5 font-mono text-xs text-cyan-glow mb-4">
        <span>{lang === 'ru' ? 'Открытый приём заявок' : 'Open Verification Call'}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {lang === 'ru' ? 'Добавьте компанию в каталог AITopIndex' : 'Apply for Verified Listing on AITopIndex'}
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-300">
        {lang === 'ru'
          ? 'Размещение бесплатное. Мы проверяем сайт компании, инструменты и примеры работ. Рассмотрение занимает до 48 часов.'
          : 'Listings are free. We review your website, tools, and examples of work within 48 hours.'}
      </p>
    </div>

    <!-- Application Form Card -->
    <div class="glass glow-border relative overflow-hidden rounded-3xl p-6 sm:p-10">
      <form id="submit-agency-form" method="post" class="space-y-6" data-lang={lang}>
        <input type="text" name="website_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <!-- 1. Agency Name -->
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2" for="agency-name">
            {lang === 'ru' ? '1. Название компании / студии *' : '1. Official Agency / Studio Name *'}
          </label>
          <input
            id="agency-name"
            name="name"
            type="text"
            required
            minlength="2"
            maxlength="150"
            autocomplete="organization"
            placeholder={lang === 'ru' ? 'например: AI Flow Studio' : 'e.g. NextGen Automation Labs'}
            class="field"
          />
        </div>

        <!-- 2. Website URL -->
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2" for="agency-website">
            {lang === 'ru' ? '2. Официальный веб-сайт (с HTTPS) *' : '2. Official Website (HTTPS required) *'}
          </label>
          <input
            id="agency-website"
            name="website"
            type="url"
            required
            pattern="https://.+"
            autocomplete="url"
            placeholder="https://youragency.com"
            class="field"
          />
          <p class="mt-1.5 text-[11px] text-slate-400 font-mono">
            {lang === 'ru' ? 'Ссылка должна начинаться с https://' : 'Use a link starting with https://'}
          </p>
        </div>

        <!-- 3. Primary Category -->
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2" for="agency-category">
            {lang === 'ru' ? '3. Основная категория внедрения *' : '3. Primary AI Category *'}
          </label>
          <select id="agency-category" name="category" required class="field cursor-pointer font-sans">
            <option value="" selected disabled>{lang === 'ru' ? 'Выберите категорию' : 'Select a category'}</option>
            {categories.map((c) => (
              <option value={c.id}>{c.title[lang]}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2" for="agency-description">
            {lang === 'ru' ? '4. Что делает ваша компания? *' : '4. What does your company do? *'}
          </label>
          <textarea id="agency-description" name="description" required minlength="15" maxlength="1500" rows="3" class="field"></textarea>
        </div>

        <!-- Tools -->
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2" for="agency-stack">
            {lang === 'ru' ? '5. Какие инструменты вы используете? *' : '5. What tools do you use? *'}
          </label>
          <input
            id="agency-stack"
            name="stack"
            type="text"
            required
            maxlength="300"
            placeholder={lang === 'ru' ? 'например: n8n, OpenAI API, Vapi, AmoCRM, LangGraph' : 'e.g. LangChain, CrewAI, Make, HubSpot, Anthropic'}
            class="field"
          />
        </div>

        <!-- 5. Case Study or Portfolio Link -->
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2" for="agency-case">
            {lang === 'ru' ? '6. Ссылка на пример работы или портфолио *' : '6. Link to an Example of Your Work or Portfolio *'}
          </label>
          <input
            id="agency-case"
            name="caseStudy"
            type="url"
            required
            pattern="https?://.+"
            maxlength="500"
            placeholder="https://youragency.com/case-studies"
            class="field"
          />
        </div>

        <!-- Work email -->
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2" for="agency-contact">
            {lang === 'ru' ? '7. Рабочий email *' : '7. Work Email *'}
          </label>
          <input
            id="agency-contact"
            name="workEmail"
            type="email"
            required
            autocomplete="email"
            placeholder="name@company.com"
            class="field"
          />
        </div>

        <p id="application-error" role="alert" class="hidden text-sm font-semibold text-red-700"></p>

        <!-- Submit Button -->
        <button type="submit" disabled class="w-full btn-primary py-3.5 text-base cursor-pointer disabled:opacity-60">
          <span>{lang === 'ru' ? 'Отправить заявку на модерацию' : 'Submit Application for Editorial Review'}</span>
        </button>
      </form>
      <noscript>
        <p class="mt-4 text-sm">{lang === 'ru' ? 'Включите JavaScript, чтобы отправить заявку.' : 'Enable JavaScript to submit your application.'}</p>
      </noscript>

      <!-- Success State (Hidden by default) -->
      <div id="form-success" class="hidden text-center py-10 space-y-4" tabindex="-1" data-nosnippet>
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-emerald-500 bg-emerald-500/10 text-emerald-400">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white">
          {lang === 'ru' ? 'Заявка успешно принята!' : 'Application Successfully Received!'}
        </h3>
        <p class="text-sm text-slate-300 max-w-md mx-auto">
          {lang === 'ru'
            ? 'Заявка передана на рассмотрение. Если её одобрят, компания появится в каталоге.'
            : 'Your application is under review. If approved, your company will appear in the directory.'}
        </p>
        <p class="text-sm">{lang === 'ru' ? 'Номер заявки' : 'Application ID'} <strong id="application-id"></strong></p>
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href={langPath(lang, '/')} class="btn-ghost text-xs py-2.5 px-5">
            &larr; {lang === 'ru' ? 'Вернуться в каталог' : 'Back to Directory'}
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    function setupForm() {
      const form = document.querySelector<HTMLFormElement>('#submit-agency-form');
      const success = document.getElementById('form-success');
      const applicationId = document.getElementById('application-id');
      const error = document.getElementById('application-error');
      const button = form?.querySelector<HTMLButtonElement>('button[type=submit]');
      if (!form || !success || !applicationId || !error || !button || form.dataset.ready) return;
      form.dataset.ready = 'true';
      button.disabled = false;
      const isRu = form.dataset.lang === 'ru';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (button.disabled) return;
        const data = new FormData(form);
        const fallback = isRu ? 'Не удалось отправить заявку. Попробуйте ещё раз.' : 'The application could not be sent. Please try again.';
        error.classList.add('hidden');
        button.disabled = true;
        form.setAttribute('aria-busy', 'true');

        try {
          const response = await fetch('/api/submissions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              organization_name: data.get('name'),
              website_url: data.get('website'),
              category_id: data.get('category'),
              description: data.get('description'),
              tech_stack: data.get('stack'),
              case_study_url: data.get('caseStudy'),
              work_email: data.get('workEmail'),
              website_hp: data.get('website_hp'),
              lang: isRu ? 'ru' : 'en',
              source: 'web_listing_form',
            }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok || typeof result.submission_id !== 'string') {
            throw new Error(response.status < 500 && typeof result.error === 'string' ? result.error : fallback);
          }
          applicationId.textContent = result.submission_id;
          form.classList.add('hidden');
          success.classList.remove('hidden');
          success.focus();
        } catch (err) {
          error.textContent = err instanceof Error && err.name !== 'TypeError' ? err.message : fallback;
          error.classList.remove('hidden');
        } finally {
          form.removeAttribute('aria-busy');
          button.disabled = false;
        }
      });
    }

    setupForm();
    document.addEventListener('astro:page-load', setupForm);
  </script>
</Layout>
