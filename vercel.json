{
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/:path(.*)",
      "destination": "/:path",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.aitopindex.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://api.aitopindex.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://api.aitopindex.com/admin/:path*"
    }
  ]
}
